From: panvk-kbase-android worker <panvk-worker@localhost>
Subject: [PATCH android 008] panvk: robust dma-buf fd discovery for AHB import

Purpose: Do not assume native_handle_t->data[0] is the dma-buf (MediaTek
 gralloc handles carry fence fds alongside). Probe each fd: skip
 non-seekable fds, accept the first fd whose GetMemoryFdPropertiesKHR
 succeeds for DMA_BUF; fall back to data[0]. Vendor-neutral; required
 for Gate G (AHB import) on gralloc implementations that do not place
 the dma-buf first.
Source/Reference: https://github.com/wonderkast02/panvk-g720-kbase-csf
 branch android-candidate-beta-1.9.4
 (src/panfrost/vulkan/panvk_android.c get_valid_dma_buf_fd), adapted to
 pinned tree (upstream refactored the vk_foreach struct macro; that
 drift is not taken. The anb_init local-copy refactor is also not
 taken: pinned callers already pass local copies).
Tested GPU: none yet (compile-level; runtime Gate G on Poco pending).
Tested Kbase UAPI: n/a.
Mesa base range: 26.3.0-devel (pinned 5a07217f).
Dependencies: none (Android WSI code path).
Validation test: Gate G allocate/query/import/bind/GPU-write/CPU-verify.

diff --git a/src/panfrost/vulkan/panvk_android.c b/src/panfrost/vulkan/panvk_android.c
--- a/src/panfrost/vulkan/panvk_android.c
+++ b/src/panfrost/vulkan/panvk_android.c
@@ -248,6 +248,31 @@
    return VK_SUCCESS;
 }

+static int
+get_valid_dma_buf_fd(VkDevice device, const native_handle_t *handle)
+{
+   for (int i = 0; i < handle->numFds; i++) {
+      int fd = handle->data[i];
+      if (fd < 0)
+         continue;
+
+      /* Ensure the fd is seekable (data handle instead of a fence fd). */
+      if (lseek(fd, 0, SEEK_END) < 0)
+         continue;
+
+      VkMemoryFdPropertiesKHR fd_props = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+      };
+      VK_FROM_HANDLE(vk_device, dev, device);
+      if (dev->dispatch_table.GetMemoryFdPropertiesKHR(
+             device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd,
+             &fd_props) == VK_SUCCESS) {
+         return fd;
+      }
+   }
+   return handle->data[0];
+}
+
 static VkResult
 panvk_android_import_ahb_memory(VkDevice device,
                                 const VkMemoryAllocateInfo *pAllocateInfo,
@@ -258,7 +280,7 @@
    VK_FROM_HANDLE(vk_device, dev, device);
    const native_handle_t *handle = AHardwareBuffer_getNativeHandle(ahb);
    assert(handle && handle->numFds > 0);
-   int dma_buf_fd = handle->data[0];
+   int dma_buf_fd = get_valid_dma_buf_fd(device, handle);
    VkResult result;

    VkImage img_handle = VK_NULL_HANDLE;
