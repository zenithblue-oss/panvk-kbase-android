From 640306565b2fc529a4a0e914e283f148db65e99c Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 14:01:40 +0000
Subject: [PATCH] jm-v7 076: unlowered fragment shader while the depth bounds
 test is off

The depth bounds emulation (jm-v7 015) lowers every FS whose pipeline
may enable the test (dynamic enable, GPL or shader objects), and the
lowering always writes SampleMask. So while the test is off, which is
almost always under DXVK (the enable is dynamic): can_fpk is false, the
ZS update is forced late with depth writes or an occlusion query, and
fs_required() is true even for an empty FS, so depth prepasses run the
FS for every fragment (perf review H2).

Such a FS now gets a second compile without the lowering
(panvk_shader::alt, owned and serialized nested with the shader; the
compile is skipped for internal shaders and does not fail the pipeline).
panvk_v7_select_alt_shaders() picks, at the start of every v6/v7 draw,
the lowered FS when ds.depth.bounds_test.enable is set and a depth
attachment is bound (the db_on condition of the RSD), else the unlowered
one, and marks FS dirty on a change like a bind.

Cost: the FS of such pipelines is compiled twice. Needs a device A/B
(fragment-bound DXVK content, depth prepass) on the A06.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c |  39 ++++++++
 src/panfrost/vulkan/panvk_shader.h         |  10 ++
 src/panfrost/vulkan/panvk_vX_shader.c      | 110 ++++++++++++++++++++-
 3 files changed, 154 insertions(+), 5 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index c73bb18f..5f296b05 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -2896,9 +2896,44 @@ v7_count_draw_queries(struct panvk_cmd_buffer *cmdbuf,
 #undef PSTAT
 }
 
+#if PAN_ARCH < 9
+/*
+ * jm-v7 076: pick the bound shaders' alternate compiles (panvk_shader::alt)
+ * for this draw. The bound shader stays in the state as whichever compile was
+ * last used; alt_parent leads back to the main one. A change marks the stage
+ * dirty, as a bind would.
+ */
+static void
+panvk_v7_select_alt_shaders(struct panvk_cmd_buffer *cmdbuf)
+{
+   const struct panvk_shader *fs = cmdbuf->state.gfx.fs.shader;
+   if (fs) {
+      const struct panvk_shader *main_fs = fs->alt_parent ? fs->alt_parent : fs;
+      if (main_fs->alt) {
+         /* The unlowered FS while the depth bounds test is off; same
+          * condition as db_on in panvk_draw_prepare_fs_rsd().
+          */
+         const bool db_on =
+            cmdbuf->vk.dynamic_graphics_state.ds.depth.bounds_test.enable &&
+            has_depth_att(cmdbuf);
+         const struct panvk_shader *want = db_on ? main_fs : main_fs->alt;
+         if (want != fs) {
+            cmdbuf->state.gfx.fs.shader = want;
+            gfx_state_set_dirty(cmdbuf, FS);
+            gfx_state_set_dirty(cmdbuf, FS_PUSH_UNIFORMS);
+         }
+      }
+   }
+}
+#endif
+
 static void
 panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw)
 {
+#if PAN_ARCH < 9
+   if (!draw->tess_phase)
+      panvk_v7_select_alt_shaders(cmdbuf);
+#endif
    const struct panvk_shader_variant *vs = panvk_shader_hw_variant(cmdbuf->state.gfx.vs.shader);
    VkResult result;
 
@@ -3013,6 +3048,10 @@ static void
 panvk_cmd_draw_indirect(struct panvk_cmd_buffer *cmdbuf,
                         struct panvk_draw_data *draw)
 {
+#if PAN_ARCH < 9
+   if (!draw->tess_phase)
+      panvk_v7_select_alt_shaders(cmdbuf);
+#endif
    const struct panvk_shader_variant *vs = panvk_shader_hw_variant(cmdbuf->state.gfx.vs.shader);
    VkResult result;
 
diff --git a/src/panfrost/vulkan/panvk_shader.h b/src/panfrost/vulkan/panvk_shader.h
index c9775eba..802cd021 100644
--- a/src/panfrost/vulkan/panvk_shader.h
+++ b/src/panfrost/vulkan/panvk_shader.h
@@ -600,6 +600,16 @@ struct panvk_shader {
     * (line, point) and class (triangles, triangles with adjacency).
     */
    struct panvk_shader *polygon_gs[2][2];
+   /* jm-v7 076: another compile of the same shader, which the draw picks
+    * instead while its state allows (panvk_v7_select_alt_shaders()). A
+    * fragment shader with the depth bounds lowering has the unlowered one,
+    * used while the test is off (it keeps FPK and early ZS). A vertex shader
+    * with xfb has a screen-space one without xfb, used while xfb is
+    * inactive and no geometry shader is bound (jm-v7 077). Owned by the
+    * shader; alt_parent points back from the alternate.
+    */
+   struct panvk_shader *alt;
+   const struct panvk_shader *alt_parent;
 #endif
 
    struct panvk_shader_variant variants[];
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index a13fc60a..12da80b2 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -3554,6 +3554,8 @@ panvk_shader_destroy(struct vk_device *vk_dev, struct vk_shader *vk_shader,
             panvk_shader_destroy(vk_dev, &shader->polygon_gs[m][c]->vk, NULL);
       }
    }
+   if (shader->alt)
+      panvk_shader_destroy(vk_dev, &shader->alt->vk, pAllocator);
 #endif
 
    vk_shader_free(vk_dev, pAllocator, &shader->vk);
@@ -4217,7 +4219,7 @@ panvk_compile_shader(struct panvk_device *dev,
                      const struct vk_graphics_pipeline_state *state,
                      const struct pan_varying_layout *vs_varying_layout,
                      const uint32_t *noperspective_varyings,
-                     uint8_t scissor_loc,
+                     uint8_t scissor_loc, bool alt,
                      const VkAllocationCallbacks *pAllocator,
                      struct vk_shader **shader_out)
 {
@@ -4988,7 +4990,7 @@ panvk_compile_shader(struct panvk_device *dev,
                &variant->fs.tile_image_z_read,
                &variant->fs.tile_image_s_read);
 
-      if (panvk_depth_bounds_lowered(&dev->vk.enabled_features, state)) {
+      if (!alt && panvk_depth_bounds_lowered(&dev->vk.enabled_features, state)) {
          variant->fs.depth_bounds_app_mask = panvk_lower_depth_bounds(nir);
          variant->fs.depth_bounds = true;
       }
@@ -5135,6 +5137,41 @@ panvk_per_arch(create_shader_from_binary)(struct panvk_device *dev,
    return result;
 }
 
+#if PAN_ARCH < 9
+/* jm-v7 076: whether a shader gets an alternate compile (panvk_shader::alt).
+ * A fragment shader with the depth bounds lowering whose test may be off at
+ * draw time (dynamic enable, or no pipeline state): the lowering writes
+ * SampleMask, which costs FPK and early ZS, and makes even an empty FS
+ * required, for every draw while the test is off.
+ */
+static bool
+panvk_v7_wants_alt(const struct vk_features *features,
+                   const struct vk_shader_compile_info *info,
+                   const struct vk_graphics_pipeline_state *state)
+{
+   /* Not for driver-internal shaders (the device depth bounds FS, meta). */
+   if (info->nir->info.internal)
+      return false;
+
+   if (info->stage == MESA_SHADER_FRAGMENT)
+      return panvk_depth_bounds_lowered(features, state) &&
+             (!state || !state->ds ||
+              BITSET_TEST(state->dynamic,
+                          MESA_VK_DYNAMIC_DS_DEPTH_BOUNDS_TEST_ENABLE));
+
+   return false;
+}
+
+/* The alternate's NIR: the fragment shader skips the depth bounds lowering
+ * (panvk_compile_shader(alt = true)), nothing to change here.
+ */
+static void
+panvk_v7_prepare_alt_nir(struct vk_shader_compile_info *info)
+{
+   (void)info;
+}
+#endif
+
 static VkResult
 compile_shaders(struct vk_device *vk_dev, uint32_t shader_count,
                 struct vk_shader_compile_info *infos,
@@ -5203,12 +5240,47 @@ compile_shaders(struct vk_device *vk_dev, uint32_t shader_count,
 #endif
       }
 
+#if PAN_ARCH < 9
+      /* jm-v7 076: the alternate compile picked per draw (see
+       * panvk_shader::alt). Cloned before the main compile consumes the NIR.
+       */
+      nir_shader *alt_nir = panvk_v7_wants_alt(enabled_features, &infos[i],
+                                               state)
+                               ? nir_shader_clone(NULL, infos[i].nir)
+                               : NULL;
+#endif
+
       result = panvk_compile_shader(dev, &infos[i], state, vs_varying_layout,
                                     noperspective_varyings_ptr, scissor_loc,
-                                    pAllocator, &shaders_out[i]);
+                                    false, pAllocator, &shaders_out[i]);
 
-      if (result != VK_SUCCESS)
+      if (result != VK_SUCCESS) {
+#if PAN_ARCH < 9
+         ralloc_free(alt_nir);
+#endif
          goto err_cleanup;
+      }
+
+#if PAN_ARCH < 9
+      if (alt_nir) {
+         struct vk_shader_compile_info alt_info = infos[i];
+         alt_info.nir = alt_nir;
+         panvk_v7_prepare_alt_nir(&alt_info);
+         struct vk_shader *alt_vk = NULL;
+         /* Not fatal: without it the main compile is used for every draw. */
+         if (panvk_compile_shader(dev, &alt_info, state, vs_varying_layout,
+                                  noperspective_varyings_ptr, scissor_loc,
+                                  true, pAllocator, &alt_vk) == VK_SUCCESS) {
+            struct panvk_shader *main_shader =
+               container_of(shaders_out[i], struct panvk_shader, vk);
+            struct panvk_shader *alt_shader =
+               container_of(alt_vk, struct panvk_shader, vk);
+            main_shader->alt = alt_shader;
+            alt_shader->alt_parent = main_shader;
+         }
+         ralloc_free(alt_nir);
+      }
+#endif
 
       /* Clean up NIR for the current shader */
       ralloc_free(infos[i].nir);
@@ -5464,6 +5536,27 @@ panvk_deserialize_shader(struct vk_device *vk_dev, struct blob_reader *blob,
       }
    }
 
+#if PAN_ARCH < 9
+   /* jm-v7 076: the alternate compile, nested. */
+   if (blob_read_uint8(blob)) {
+      struct vk_shader *alt_vk = NULL;
+      result = blob->overrun ? VK_ERROR_INCOMPATIBLE_SHADER_BINARY_EXT
+                             : panvk_deserialize_shader(vk_dev, blob,
+                                                        binary_version,
+                                                        pAllocator, &alt_vk);
+      if (result != VK_SUCCESS) {
+         panvk_shader_destroy(vk_dev, &shader->vk, pAllocator);
+         return result;
+      }
+      shader->alt = container_of(alt_vk, struct panvk_shader, vk);
+      shader->alt->alt_parent = shader;
+   }
+   if (blob->overrun) {
+      panvk_shader_destroy(vk_dev, &shader->vk, pAllocator);
+      return vk_error(device, VK_ERROR_INCOMPATIBLE_SHADER_BINARY_EXT);
+   }
+#endif
+
    *shader_out = &shader->vk;
 
    return VK_SUCCESS;
@@ -5583,6 +5676,13 @@ panvk_shader_serialize(struct vk_device *vk_dev,
       panvk_shader_serialize_variant(vk_dev, variant, blob);
    }
 
+#if PAN_ARCH < 9
+   /* jm-v7 076: the alternate compile, nested. */
+   blob_write_uint8(blob, shader->alt != NULL);
+   if (shader->alt && !panvk_shader_serialize(vk_dev, &shader->alt->vk, blob))
+      return false;
+#endif
+
    return !blob->out_of_memory;
 }
 
@@ -6261,7 +6361,7 @@ VkResult panvk_per_arch(create_shader)(
    panvk_preprocess_nir(dev->vk.physical, nir, &rs);
 
    struct vk_shader *vk_shader;
-   VkResult result = panvk_compile_shader(dev, &info, NULL, NULL, NULL, 0, NULL,
+   VkResult result = panvk_compile_shader(dev, &info, NULL, NULL, NULL, 0, false, NULL,
                                           &vk_shader);
    if (result != VK_SUCCESS)
       return result;
-- 
