From 5b2b344992bf83c15ca8f0234f8c4062a379346e Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 29 Oct 2026 09:11:38 +0530
Subject: [PATCH 149/151] panvk: logic ops that ignore the destination keep
 forward pixel kill

0138 made every logic op count as a destination read, so a draw with
logicOpEnable lost forward pixel kill (and v13 HSR culling) even for
CLEAR, COPY, COPY_INVERTED and SET, whose result does not depend on what
lies underneath. Only the other twelve ops (and partial write masks,
already caught by pan_blend_reads_dest()) disable it now.

PANVK_LOGICOP_FPK=0 restores the 0138 behaviour.
---
 src/panfrost/vulkan/panvk_instance.c   |  1 +
 src/panfrost/vulkan/panvk_perf_knobs.h |  3 +++
 src/panfrost/vulkan/panvk_vX_blend.c   | 28 ++++++++++++++++++++++++--
 3 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_instance.c b/src/panfrost/vulkan/panvk_instance.c
index 85ae83aa690..13cc6d02cc9 100644
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -96,6 +96,7 @@ static const struct {
    {"PANVK_ANDROID_PRESENT_FENCE", PANVK_PERF_ANDROID_PRESENT_FENCE},
    {"PANVK_ANDROID_PRESENT_THREAD", PANVK_PERF_ANDROID_PRESENT_THREAD},
    {"PANVK_PRELOAD_BARRIER_TRACK", PANVK_PERF_PRELOAD_BARRIER_TRACK},
+   {"PANVK_LOGICOP_FPK", PANVK_PERF_LOGICOP_FPK},
 };
 
 void
diff --git a/src/panfrost/vulkan/panvk_perf_knobs.h b/src/panfrost/vulkan/panvk_perf_knobs.h
index c606647912f..49b3048c6a5 100644
--- a/src/panfrost/vulkan/panvk_perf_knobs.h
+++ b/src/panfrost/vulkan/panvk_perf_knobs.h
@@ -62,6 +62,9 @@ enum panvk_perf_knob {
     * LOAD pass waits for earlier fragment jobs only if one of them may
     * have written what the pass loads. */
    PANVK_PERF_PRELOAD_BARRIER_TRACK = 1 << 12,
+   /* Build 116. PANVK_LOGICOP_FPK: logic ops that ignore the destination
+    * (CLEAR, COPY, COPY_INVERTED, SET) keep forward pixel kill. */
+   PANVK_PERF_LOGICOP_FPK = 1 << 13,
 };
 
 extern uint32_t panvk_perf_knobs;
diff --git a/src/panfrost/vulkan/panvk_vX_blend.c b/src/panfrost/vulkan/panvk_vX_blend.c
index 136efaf8e98..99bb05321b2 100644
--- a/src/panfrost/vulkan/panvk_vX_blend.c
+++ b/src/panfrost/vulkan/panvk_vX_blend.c
@@ -17,6 +17,7 @@
 
 #include "panvk_blend.h"
 #include "panvk_cmd_buffer.h"
+#include "panvk_perf_knobs.h"
 #include "panvk_device.h"
 #include "panvk_meta.h"
 #include "panvk_shader.h"
@@ -225,6 +226,27 @@ emit_blend_desc(const struct pan_blend_state *state, uint8_t rt_idx,
    }
 }
 
+/* Whether a logic op combines with the destination. CLEAR, COPY,
+ * COPY_INVERTED and SET give the same result whatever lies underneath, so
+ * forward pixel kill may drop earlier fragments (PANVK_LOGICOP_FPK=0: every
+ * logic op counts as a destination read, as 0138). */
+static bool
+logicop_reads_dest(enum pipe_logicop func)
+{
+   if (!PANVK_PERF(LOGICOP_FPK))
+      return true;
+
+   switch (func) {
+   case PIPE_LOGICOP_CLEAR:
+   case PIPE_LOGICOP_COPY:
+   case PIPE_LOGICOP_COPY_INVERTED:
+   case PIPE_LOGICOP_SET:
+      return false;
+   default:
+      return true;
+   }
+}
+
 static bool
 blend_needs_shader(const struct pan_blend_state *state, unsigned rt_idx,
                    unsigned *ff_blend_constant)
@@ -378,9 +400,11 @@ panvk_per_arch(blend_emit_descs)(struct panvk_cmd_buffer *cmdbuf,
       pan_blend_optimize_equation(&rt->equation, rt->format, bs.constants);
 
       /* A logic op reads the destination (gallium's load_dest): forward
-       * pixel kill must not drop the fragments it combines with. */
+       * pixel kill must not drop the fragments it combines with. A partial
+       * write mask is caught by pan_blend_reads_dest(). */
       blend_info->any_dest_read |=
-         bs.logicop_enable || pan_blend_reads_dest(rt->equation);
+         (bs.logicop_enable && logicop_reads_dest(bs.logicop_func)) ||
+         pan_blend_reads_dest(rt->equation);
 
       if (blend_needs_shader(&bs, i, &ff_blend_constant)) {
          nir_alu_type src0_type = fs_info->bifrost.blend[loc].type;
-- 
