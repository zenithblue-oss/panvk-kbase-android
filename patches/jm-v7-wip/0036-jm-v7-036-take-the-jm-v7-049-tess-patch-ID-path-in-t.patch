From 15c9ccf220897ba807e3818d31877d57ebc6e3d6 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 16:46:49 +0000
Subject: [PATCH 36/36] jm-v7 036: take the jm-v7 049 tess patch ID path in the
 GS emulation

jm-v7 049 derives gl_PrimitiveIDIn of a tess-fed geometry shader from
the tessellator index of the primitive's first vertex, but only when
BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_PRIMITIVE_ID).
The v6/v7 GS compile never gathers info before panvk_nir_lower_gs()
("nothing gathered info on this NIR yet"), so the bit is always clear,
the path was never emitted and gl_PrimitiveIDIn stayed the triangle
ordinal of the TES draw (A06 gs_tess_primitive_id: direct
first=16 17 18 19, chunk first=640 641 520 521, all 7 modes bad).

Look for a load_primitive_id intrinsic instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_nir_lower_gs.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_nir_lower_gs.c b/src/panfrost/vulkan/panvk_nir_lower_gs.c
index d30a794..0a85ca9 100644
--- a/src/panfrost/vulkan/panvk_nir_lower_gs.c
+++ b/src/panfrost/vulkan/panvk_nir_lower_gs.c
@@ -1053,6 +1053,20 @@ lower_gs_instr(nir_builder *b, nir_intrinsic_instr *intr, void *data)
    }
 }
 
+static bool
+gs_reads_primitive_id(nir_function_impl *impl)
+{
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_intrinsic &&
+             nir_instr_as_intrinsic(instr)->intrinsic ==
+                nir_intrinsic_load_primitive_id)
+            return true;
+      }
+   }
+   return false;
+}
+
 bool
 panvk_nir_lower_gs(nir_shader *nir, const struct panvk_gs_lower_options *opts)
 {
@@ -1251,9 +1265,10 @@ panvk_nir_lower_gs(nir_shader *nir, const struct panvk_gs_lower_options *opts)
     * patch ID, as the tess eval shader computes it: the TES draw is a
     * non-indexed list whose vertex i is tessellator index i, the raw id
     * (patch * POLY_TES_PATCH_ID_STRIDE + point) is index_buffer[i]
-    * (jm-v7 049).
+    * (jm-v7 049). Nothing gathered info on this NIR (system_values_read
+    * is empty), so look for the intrinsic itself (jm-v7 036).
     */
-   if (BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_PRIMITIVE_ID)) {
+   if (gs_reads_primitive_id(impl)) {
       nir_def *ordinal = st.prim_id;
       nir_push_if(&b, nir_iand(&b, nir_ine_imm(&b, st.tess_params, 0),
                                nir_ult(&b, prim_global, actual_prims)));
-- 
