From f68abd4b773cae4249b2ea265cd855f570dc82eb Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Thu, 22 Oct 2026 14:42:49 +0000
Subject: [PATCH] jm-v7 106: v6/v7 tessellation memory reused per batch,
 bounded per batch

FTL Galaxy S9 (G72) RC5-universal-105: tess_perf was still LMK-killed at
its first GS frame with 0078 in (772 growable BOs, but only ~66 MiB
committed up front). The JM tessellation memory grows and never shrinks:

- The indirect varying allocator offset (libpan_draw_helper_varying_buf_info)
  is set to 0 at record time and advanced by the GPU, but a re-submitted
  batch never reset it: every submit of the same command buffer moved
  further into the 288 MB GROW_ON_GPF buffer, until all of it was
  committed (and the tessellator dropped patches for lack of room).
  Batches now list their allocators and panvk_reset_issued_batch() puts
  the offsets back to 0.
- Per heap half (PANVK_OVERLAP lets a batch's vertex jobs overlap only the
  other half's fragment job): a second indirect varying buffer and two
  256 MiB growable tess GS scratch regions. Each batch takes its own
  varying allocator in its half's buffer, and nested tess eval draws
  bump-allocate their geometry emulation buffers from the half's scratch,
  from 0 in every batch (gs_pool fallback when a draw does not fit).
- PANVK_V7_TESS_BATCH_MB (default 32, 0 = off): panvk_tess_draw() starts a
  new batch when the batch's worst-case tess eval varyings would pass it
  or its GS scratch use already has. It also splits before a draw that
  would cross the ~5k-job split, which could otherwise fall between the
  phases of one tessellated draw. One batch's memory is then reused by
  the next batch of its half instead of a frame growing draw by draw.
- A draw the CPU knows sizes the tess arena (max_indices and max_patches)
  for its own patches, so its index buffer is not placed ~90 MiB into the
  arena (GROW_ON_GPF commits every page below a fault).
- Logs the first 3 budget splits ("tess batch budget").

Cost: tess_perf gs=1 (16-patch draws, ~15 MiB worst-case varyings each)
splits about every 2 draws. Not device-tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h    |  10 ++
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c |   9 ++
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c   | 116 +++++++++++++++++--
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c  |   4 +
 src/panfrost/vulkan/panvk_cmd_draw.h         |   3 +
 src/panfrost/vulkan/panvk_device.h           |   7 ++
 src/panfrost/vulkan/panvk_gs.h               |   5 +
 src/panfrost/vulkan/panvk_v7_knobs.h         |  27 +++++
 src/panfrost/vulkan/panvk_vX_device.c        |  37 ++++++
 9 files changed, 208 insertions(+), 10 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index 5677b85a..15549de0 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -75,6 +75,16 @@ struct panvk_batch {
    bool poly_heap_reset;
    /* v67b: tiler heap half used by this batch */
    unsigned heap_half;
+   /* jm-v7 106: worst-case indirect varying bytes of the tess draws in this
+    * batch, and the next free byte of tess_gs_scratch[heap_half].
+    */
+   uint64_t tess_vary_w;
+   uint64_t tess_gs_off;
+   /* jm-v7 106: the offset words (uint32_t *, CPU side) of the indirect
+    * varying allocators created in this batch, reset to 0 when the batch
+    * is issued again.
+    */
+   struct util_dynarray vary_infos;
 };
 
 enum panvk_cmd_event_op_type {
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index 77a4c5a6..ff35002e 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -474,6 +474,13 @@ panvk_per_arch(cmd_open_batch)(struct panvk_cmd_buffer *cmdbuf)
    cmdbuf->cur_batch->malloc_vertex_jobs = UTIL_DYNARRAY_INIT;
 #endif
    cmdbuf->cur_batch->event_ops = UTIL_DYNARRAY_INIT;
+   cmdbuf->cur_batch->vary_infos = UTIL_DYNARRAY_INIT;
+   /* jm-v7 106: with per-half indirect varying buffers, every batch takes
+    * its own allocator, in the buffer of its heap half. */
+#if PAN_ARCH < 9
+   if (to_panvk_device(cmdbuf->vk.base.device)->indirect_varying_buffer2)
+      cmdbuf->state.gfx.vs.indirect_varying_bufs_infos = 0;
+#endif
    assert(cmdbuf->cur_batch);
    return cmdbuf->cur_batch;
 }
@@ -531,6 +538,7 @@ panvk_reset_cmdbuf(struct vk_command_buffer *vk_cmdbuf,
       util_dynarray_fini(&batch->malloc_vertex_jobs);
 #endif
       util_dynarray_fini(&batch->event_ops);
+      util_dynarray_fini(&batch->vary_infos);
 
       vk_free(&cmdbuf->vk.pool->alloc, batch);
    }
@@ -558,6 +566,7 @@ panvk_destroy_cmdbuf(struct vk_command_buffer *vk_cmdbuf)
       util_dynarray_fini(&batch->malloc_vertex_jobs);
 #endif
       util_dynarray_fini(&batch->event_ops);
+      util_dynarray_fini(&batch->vary_infos);
 
       vk_free(&cmdbuf->vk.pool->alloc, batch);
    }
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 99a8be5c..84ead75b 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -583,6 +583,20 @@ panvk_draw_get_indirect_varying_info(struct panvk_cmd_buffer *cmdbuf)
    if (cmdbuf->state.gfx.vs.indirect_varying_bufs_infos)
       return VK_SUCCESS;
 
+   /* jm-v7 106: odd heap half batches take the second buffer, so a batch
+    * reuses the memory of the previous batch of its half, never that of
+    * the batch whose fragment job may still run (PANVK_OVERLAP). The half
+    * is picked with the tiler context.
+    */
+   const struct panvk_priv_bo *vary_bo = dev->indirect_varying_buffer;
+   if (dev->indirect_varying_buffer2 && cmdbuf->cur_batch) {
+      VkResult result = panvk_per_arch(cmd_prepare_tiler_context)(cmdbuf, 0);
+      if (result != VK_SUCCESS)
+         return result;
+      if (cmdbuf->cur_batch->heap_half & 1)
+         vary_bo = dev->indirect_varying_buffer2;
+   }
+
    struct pan_ptr bufs_info_storage = panvk_cmd_alloc_dev_mem(
       cmdbuf, desc, sizeof(struct libpan_draw_helper_varying_buf_info), 8);
 
@@ -593,7 +607,14 @@ panvk_draw_get_indirect_varying_info(struct panvk_cmd_buffer *cmdbuf)
 
    struct libpan_draw_helper_varying_buf_info *vary_bufs_info =
       bufs_info_storage.cpu;
-   vary_bufs_info->address = dev->indirect_varying_buffer->addr.dev;
+   vary_bufs_info->address = vary_bo->addr.dev;
+   /* jm-v7 106: the GPU advances offset; a re-submitted batch must start
+    * from 0 again (panvk_reset_issued_batch()), or every submit of the
+    * same command buffer moves further into the buffer.
+    */
+   if (cmdbuf->cur_batch)
+      util_dynarray_append_typed(&cmdbuf->cur_batch->vary_infos, uint32_t *,
+                                 (uint32_t *)&vary_bufs_info->offset);
    vary_bufs_info->size = PANVK_JM_MAX_PER_VTX_ATTRIBUTES_INDIRECT_SIZE *
                           PANVK_JM_MAX_VERTICES_INDIRECT;
    vary_bufs_info->offset = 0;
@@ -618,6 +639,23 @@ gs_alloc(struct panvk_cmd_buffer *cmdbuf, bool growable, uint64_t size,
       const char *e = getenv("PANVK_V7_GS_DESC");
       gs_desc = e && e[0] == '1';
    }
+   /* jm-v7 106: a nested tess eval draw bump-allocates from the batch's
+    * half of the tess GS scratch, which the next batch of that half reuses.
+    */
+#if PAN_ARCH < 9
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+   if (cmdbuf->state.gfx.tess.gs_scratch && batch) {
+      struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+      const struct panvk_priv_bo *bo =
+         dev->tess_gs_scratch[batch->heap_half & 1];
+      const uint64_t off =
+         ALIGN_POT(batch->tess_gs_off, MAX2(alignment, 64));
+      if (bo && off + size <= PANVK_TESS_GS_SCRATCH_SIZE) {
+         batch->tess_gs_off = off + size;
+         return (struct pan_ptr){.gpu = bo->addr.dev + off};
+      }
+   }
+#endif
    if (growable || !gs_desc)
       return panvk_cmd_alloc_dev_mem(cmdbuf, gs, size, alignment);
    return panvk_cmd_alloc_dev_mem(cmdbuf, desc, size, alignment);
@@ -3687,14 +3725,19 @@ panvk_tess_draw(struct panvk_cmd_buffer *cmdbuf,
        * (gs_max_prims), so this bound is never exceeded on the GPU.
        * PANVK_V7_TESS_GS_TIGHT=0 = old.
        */
-      if (cpu_known && panvk_v7_tess_gs_tight()) {
-         const uint64_t patches =
-            MIN2((uint64_t)(cpu_vertices / ps) * cpu_instances,
-                 PANVK_TESS_MAX_PATCHES);
-         const uint64_t bound =
-            MAX2(patches, 1) * PANVK_TESS_MAX_PRIMS_PER_PATCH * vpp;
-         max_indices = MIN2((uint64_t)max_indices, bound);
-      }
+   }
+   /* jm-v7 106: the same bound for every draw the CPU knows, so the tess
+    * arena layout (and the arena pages the GPU commits by touching its
+    * index buffer) is sized for the draw, not for PANVK_TESS_MAX_INDICES.
+    */
+   const uint64_t cpu_patches =
+      cpu_known ? MIN2((uint64_t)(cpu_vertices / ps) * cpu_instances,
+                       PANVK_TESS_MAX_PATCHES)
+                : 0;
+   if (cpu_known && panvk_v7_tess_gs_tight()) {
+      const uint64_t bound =
+         MAX2(cpu_patches, 1) * PANVK_TESS_MAX_PRIMS_PER_PATCH * vpp;
+      max_indices = MIN2((uint64_t)max_indices, bound);
    }
 
    /* The tess arena: tess control output, counts and coordinate offsets per
@@ -3710,8 +3753,11 @@ panvk_tess_draw(struct panvk_cmd_buffer *cmdbuf,
       heap_fixed_B + (uint64_t)max_indices * sizeof(uint32_t) + 5 * 64;
    const uint64_t per_patch_B =
       tcs_stride_B + 2 * sizeof(uint32_t) + 32 /* heap padding */;
-   const uint32_t max_patches = MIN2(
+   uint32_t max_patches = MIN2(
       PANVK_TESS_MAX_PATCHES, (PANVK_TESS_HEAP_SIZE - fixed_B) / per_patch_B);
+   /* jm-v7 106: no arena room for patches the draw does not have. */
+   if (cpu_known && panvk_v7_tess_gs_tight() && max_patches)
+      max_patches = MIN2((uint64_t)max_patches, MAX2(cpu_patches, 1));
    if (!max_patches) {
       mesa_logw_once("panvk: tess control output too large, draw skipped");
       return;
@@ -3754,6 +3800,54 @@ panvk_tess_draw(struct panvk_cmd_buffer *cmdbuf,
       panvk_per_arch(cmd_open_batch)(cmdbuf);
    }
 
+   /* jm-v7 106: bound the tessellation memory one batch can touch, so
+    * that a frame of many tessellated draws reuses it batch after batch
+    * instead of growing it draw after draw. Counted per batch: the worst
+    * case of the tess eval varyings this draw may take from the indirect
+    * varying buffer, and what the nested draws so far took from the tess
+    * GS scratch. Past the budget the draw starts a new batch (render pass
+    * contents are kept, as for any batch split). Also split before the
+    * ~5k-job split of panvk_cmd_draw_indirect() could fall between the
+    * phases of this draw.
+    */
+   const uint64_t tess_budget = panvk_v7_tess_batch_budget();
+   const uint64_t vary_w =
+      (uint64_t)max_indices * layers *
+         (16 + 4 + tes_v->info.varyings.formats.generic_size_B) +
+      (uint64_t)layers * 3 * 64;
+   if (!draw->indirect_dep_job && tess_budget) {
+      struct panvk_batch *b = cmdbuf->cur_batch;
+      const bool used = b->tess_vary_w || b->tess_gs_off;
+      const bool over = used && (b->tess_vary_w + vary_w > tess_budget ||
+                                 b->tess_gs_off >= tess_budget);
+      const bool jobs = b->vtc_jc.job_index + panvk_tess_draw_jobs(layers) +
+                           64 > 5 * 1024;
+      if (over || jobs) {
+         static unsigned logged;
+         if (over && logged < 3) {
+            logged++;
+            mesa_logi("panvk: v%u tess batch budget %llu MiB: new batch "
+                      "(varyings %llu MiB worst case, GS scratch %llu MiB)",
+                      PAN_ARCH, (unsigned long long)(tess_budget >> 20),
+                      (unsigned long long)((b->tess_vary_w + vary_w) >> 20),
+                      (unsigned long long)(b->tess_gs_off >> 20));
+         }
+         panvk_per_arch(cmd_close_batch)(cmdbuf);
+         panvk_per_arch(cmd_open_batch)(cmdbuf);
+         gfx->vs.indirect_varying_bufs_infos = 0;
+      }
+   }
+   if (dev->tess_gs_scratch[0] || dev->indirect_varying_buffer2) {
+      /* The heap half picks the buffers this batch reuses. */
+      if (panvk_per_arch(cmd_prepare_tiler_context)(cmdbuf, 0) !=
+          VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmdbuf->vk,
+                                     VK_ERROR_OUT_OF_DEVICE_MEMORY);
+         return;
+      }
+   }
+   cmdbuf->cur_batch->tess_vary_w += vary_w;
+
    struct pan_ptr td =
       panvk_cmd_alloc_dev_mem(cmdbuf, desc, sizeof(struct panlib_v7_tess), 16);
    struct pan_ptr direct = {0};
@@ -3874,7 +3968,9 @@ panvk_tess_draw(struct panvk_cmd_buffer *cmdbuf,
       .tess_phase = PANVK_TESS_PHASE_TES,
       .gs_max_prims = nested ? max_indices / vpp : 0,
    };
+   gfx->tess.gs_scratch = nested && dev->tess_gs_scratch[0];
    panvk_cmd_draw_indirect(cmdbuf, &out);
+   gfx->tess.gs_scratch = false;
 #undef TD
 
    gfx->vs.shader = vs;
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index f4b7b96e..09d57a51 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -142,6 +142,10 @@ panvk_reset_issued_batch(struct panvk_cmd_buffer *cmdbuf,
             memcpy(&ctxs[i], &batch->tiler.ctx_templ, sizeof(*ctxs));
       }
 
+      /* jm-v7 106: the indirect varying allocators start over. */
+      util_dynarray_foreach(&batch->vary_infos, uint32_t *, offset)
+         **offset = 0;
+
       /* We don't keep track of BO <-> job relationship, so let's just flush the
        * whole desc pool for now. */
       panvk_pool_flush_maps(&cmdbuf->desc_pool);
diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
index 148a54b5..527a43c3 100644
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -336,6 +336,9 @@ struct panvk_cmd_graphics_state {
       uint64_t td;
       uint64_t src_draw;
       unsigned tcs_job;
+      /* jm-v7 106: the nested tess eval draw being recorded takes its
+       * geometry emulation buffers from the batch's tess_gs_scratch. */
+      bool gs_scratch;
    } tess;
 #endif
 
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index c4da0d33..2178c678 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -78,6 +78,13 @@ struct panvk_device {
    struct panvk_priv_bo *indirect_varying_buffer;
    /* v6/v7 tessellation (jm-v7 014), see panvk_gs.h. NULL elsewhere. */
    struct panvk_priv_bo *tess_arena;
+   /* jm-v7 106: v6/v7 tessellation, one per PANVK_OVERLAP heap half (the
+    * batch's heap_half): the indirect varying buffer of odd-half batches,
+    * and the geometry emulation buffers of nested tess draws, bump
+    * allocated from 0 in every batch. NULL when unused.
+    */
+   struct panvk_priv_bo *indirect_varying_buffer2;
+   struct panvk_priv_bo *tess_gs_scratch[2];
    struct panvk_priv_bo *sample_positions;
 
    struct {
diff --git a/src/panfrost/vulkan/panvk_gs.h b/src/panfrost/vulkan/panvk_gs.h
index 3bb01394..c776602f 100644
--- a/src/panfrost/vulkan/panvk_gs.h
+++ b/src/panfrost/vulkan/panvk_gs.h
@@ -333,6 +333,11 @@ bool panvk_nir_lower_gs(struct nir_shader *nir,
  * whole patches past it, so a low bound loses patches, never memory).
  */
 #define PANVK_TESS_MAX_PRIMS_PER_PATCH 8704u
+/* jm-v7 106: VA of each tess_gs_scratch half (growable, committed up to
+ * the highest offset a batch used). A nested draw that does not fit what
+ * is left takes gs_pool BOs instead.
+ */
+#define PANVK_TESS_GS_SCRATCH_SIZE (256ull << 20)
 #define PANVK_TESS_UNSET 0xff
 
 /* What the draw path needs from a tess control or tess eval shader. The
diff --git a/src/panfrost/vulkan/panvk_v7_knobs.h b/src/panfrost/vulkan/panvk_v7_knobs.h
index 41a3aced..13eb907a 100644
--- a/src/panfrost/vulkan/panvk_v7_knobs.h
+++ b/src/panfrost/vulkan/panvk_v7_knobs.h
@@ -13,6 +13,7 @@
 #define PANVK_V7_KNOBS_H
 
 #include <stdbool.h>
+#include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -113,4 +114,30 @@ panvk_v7_tess_gs_tight(void)
    return panvk_v7_knob_on("PANVK_V7_TESS_GS_TIGHT", &v);
 }
 
+/* PANVK_OVERLAP (v67b, default on), as panvk_overlap_enabled(). */
+static inline bool
+panvk_v7_overlap_on(void)
+{
+   static int v = -1;
+   return panvk_v7_knob_on("PANVK_OVERLAP", &v);
+}
+
+/* jm-v7 106: per-batch budget (MiB) of v6/v7 tessellation memory that is
+ * reused by the next batch of the same heap half: worst-case tess eval
+ * varyings and nested geometry emulation buffers. A tess draw that would
+ * go past it starts a new batch. 0 = no budget (one batch, as before).
+ */
+static inline uint64_t
+panvk_v7_tess_batch_budget(void)
+{
+   static int64_t v = -1;
+   if (v < 0) {
+      const char *e = getenv("PANVK_V7_TESS_BATCH_MB");
+      v = e ? atoll(e) : 32;
+      if (v < 0)
+         v = 0;
+   }
+   return (uint64_t)v << 20;
+}
+
 #endif /* PANVK_V7_KNOBS_H */
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index eaef0e58..1dc25e88 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -979,6 +979,37 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
          VK_SYSTEM_ALLOCATION_SCOPE_DEVICE, &device->tess_arena);
       if (result != VK_SUCCESS)
          goto err_free_priv_bos;
+
+      /* jm-v7 106: per heap half, so a batch may reuse what the batch
+       * before it in the same half used (panvk_tess_draw()). Growable:
+       * each commits only up to the highest offset one batch reaches.
+       */
+      if (panvk_v7_tess_batch_budget()) {
+         if (device->tiler_heap2 || panvk_v7_overlap_on()) {
+            result = panvk_priv_bo_create(
+               device,
+               PANVK_JM_MAX_VERTICES_INDIRECT *
+                  PANVK_JM_MAX_PER_VTX_ATTRIBUTES_INDIRECT_SIZE,
+               PAN_KMOD_BO_FLAG_NO_MMAP | PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT,
+               VK_SYSTEM_ALLOCATION_SCOPE_DEVICE,
+               &device->indirect_varying_buffer2);
+            if (result != VK_SUCCESS)
+               goto err_free_priv_bos;
+         }
+         if (device->vk.enabled_features.geometryShader ||
+             device->vk.enabled_features.transformFeedback ||
+             device->vk.enabled_features.fillModeNonSolid) {
+            for (unsigned h = 0; h < 2; h++) {
+               result = panvk_priv_bo_create(
+                  device, PANVK_TESS_GS_SCRATCH_SIZE,
+                  PAN_KMOD_BO_FLAG_NO_MMAP | PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT,
+                  VK_SYSTEM_ALLOCATION_SCOPE_DEVICE,
+                  &device->tess_gs_scratch[h]);
+               if (result != VK_SUCCESS)
+                  goto err_free_priv_bos;
+            }
+         }
+      }
    }
 #endif
 #endif
@@ -1111,6 +1142,9 @@ err_free_priv_bos:
    panvk_priv_bo_unref(device->sample_positions);
    panvk_priv_bo_unref(device->indirect_varying_buffer);
    panvk_priv_bo_unref(device->tess_arena);
+   panvk_priv_bo_unref(device->indirect_varying_buffer2);
+   panvk_priv_bo_unref(device->tess_gs_scratch[0]);
+   panvk_priv_bo_unref(device->tess_gs_scratch[1]);
    panvk_priv_bo_unref(device->tiler_heap);
    panvk_priv_bo_unref(device->tiler_heap2);
    panvk_device_cleanup_mempools(device);
@@ -1170,6 +1204,9 @@ panvk_per_arch(destroy_device)(struct panvk_device *device,
    panvk_priv_bo_unref(device->tiler_oom.handlers_bo);
     panvk_priv_bo_unref(device->indirect_varying_buffer);
     panvk_priv_bo_unref(device->tess_arena);
+    panvk_priv_bo_unref(device->indirect_varying_buffer2);
+    panvk_priv_bo_unref(device->tess_gs_scratch[0]);
+    panvk_priv_bo_unref(device->tess_gs_scratch[1]);
     panvk_priv_bo_unref(device->tiler_heap);
     panvk_priv_bo_unref(device->tiler_heap2);
     panvk_priv_bo_unref(device->sample_positions);
