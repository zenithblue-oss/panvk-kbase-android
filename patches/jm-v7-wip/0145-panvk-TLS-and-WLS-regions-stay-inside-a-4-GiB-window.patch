From fbbac61b356d1f0c9454924de4182fadbc076023 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 29 Oct 2026 07:28:59 +0530
Subject: [PATCH] panvk: TLS and WLS regions stay inside a 4 GiB window

The GPU adds the per-thread (TLS) and per-workgroup (WLS) offset to the
low 32 bits of the base only, so a region that crosses a 4 GiB boundary
writes 4 GiB below its base (kbase documents BASE_MEM_GPU_VA_SAME_4GB_PAGE
as required for TLS memory; pan_emit_tls() asserts it for WLS). On the
Mali-G1-Ultra (v14) kbase places SAME_VA allocations around 0x6000000000
and the tessellation test faulted (exception 0xc1, translation fault, write
to 0x5f0005d040).

Command-buffer TLS/WLS pool allocations that cross are skipped, and the
CSF device TLS (alias region or full BO) is re-created while the crossing
ones are held.
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c | 113 +++++++++++++-----
 .../vulkan/csf/panvk_vX_cmd_dispatch.c        |   3 +-
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c  |   6 +-
 src/panfrost/vulkan/panvk_cmd_alloc.h         |  20 ++++
 4 files changed, 108 insertions(+), 34 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index ebda1cda719..7a83fee4f56 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -183,6 +183,17 @@ struct dev_tls_layout {
    unsigned thread_size, threads;
 };
 
+/* jm-v7 0145: the TLS region must not cross a 4 GiB boundary (see
+ * panvk_cmd_alloc_tls_mem()). Callers retry while holding the rejects, so the
+ * next region gets another address. */
+#define DEV_TLS_MAX_REJECTS 8
+
+static bool
+dev_tls_crosses_4g(uint64_t va, uint64_t size)
+{
+   return (va >> 32) != ((va + size - 1) >> 32);
+}
+
 #ifdef HAVE_PAN_KMOD_KBASE
 static uint64_t
 dev_tls_page(void)
@@ -212,35 +223,59 @@ dev_tls_alias(struct panvk_device *dev, const struct panvk_priv_bo *backing,
          idx++;
    }
 
-   union kbase_ioctl_mem_alias req = {
-      .in = {
-         .flags = BASE_MEM_PROT_GPU_RD | BASE_MEM_PROT_GPU_WR |
-                  BASE_MEM_PROT_CPU_RD,
-         .stride = stride,
-         .nents = l->range,
-         .aliasing_info = (uintptr_t)ai,
-      },
-   };
+   void *rejects[DEV_TLS_MAX_REJECTS];
+   unsigned n_rejects = 0;
+   uint64_t va = 0;
+
+   for (;;) {
+      union kbase_ioctl_mem_alias req = {
+         .in = {
+            .flags = BASE_MEM_PROT_GPU_RD | BASE_MEM_PROT_GPU_WR |
+                     BASE_MEM_PROT_CPU_RD,
+            .stride = stride,
+            .nents = l->range,
+            .aliasing_info = (uintptr_t)ai,
+         },
+      };
 
-   if (ioctl(dev->kmod.dev->fd, KBASE_IOCTL_MEM_ALIAS, &req)) {
-      mesa_logw("panvk: device TLS: KBASE_IOCTL_MEM_ALIAS failed (%s), "
-                "using a full BO", strerror(errno));
-      return 0;
-   }
+      if (ioctl(dev->kmod.dev->fd, KBASE_IOCTL_MEM_ALIAS, &req)) {
+         mesa_logw("panvk: device TLS: KBASE_IOCTL_MEM_ALIAS failed (%s), "
+                   "using a full BO", strerror(errno));
+         break;
+      }
 
-   /* 64-bit clients get a SAME_VA cookie; mmap() places the region, and
-    * the address is both the CPU and the GPU VA (as for the ring buffer). */
-   void *ptr = mmap(NULL, l->span, PROT_READ, MAP_SHARED, dev->kmod.dev->fd,
-                    req.out.gpu_va);
-   if (ptr == MAP_FAILED) {
-      mesa_logw("panvk: device TLS: alias mmap failed (%s), using a full BO",
-                strerror(errno));
-      struct kbase_ioctl_mem_free free_req = {.gpu_addr = req.out.gpu_va};
-      ioctl(dev->kmod.dev->fd, KBASE_IOCTL_MEM_FREE, &free_req);
-      return 0;
+      /* 64-bit clients get a SAME_VA cookie; mmap() places the region, and
+       * the address is both the CPU and the GPU VA (as for the ring buffer).
+       */
+      void *ptr = mmap(NULL, l->span, PROT_READ, MAP_SHARED,
+                       dev->kmod.dev->fd, req.out.gpu_va);
+      if (ptr == MAP_FAILED) {
+         mesa_logw("panvk: device TLS: alias mmap failed (%s), using a full "
+                   "BO", strerror(errno));
+         struct kbase_ioctl_mem_free free_req = {.gpu_addr = req.out.gpu_va};
+         ioctl(dev->kmod.dev->fd, KBASE_IOCTL_MEM_FREE, &free_req);
+         break;
+      }
+
+      if (!dev_tls_crosses_4g((uintptr_t)ptr, l->span)) {
+         va = (uintptr_t)ptr;
+         break;
+      }
+
+      if (n_rejects == DEV_TLS_MAX_REJECTS) {
+         munmap(ptr, l->span);
+         mesa_logw("panvk: device TLS: no alias region inside a 4 GiB "
+                   "window, using a full BO");
+         break;
+      }
+      rejects[n_rejects++] = ptr;
    }
 
-   return (uintptr_t)ptr;
+   /* munmap() of a SAME_VA alias region frees it. */
+   for (unsigned i = 0; i < n_rejects; i++)
+      munmap(rejects[i], l->span);
+
+   return va;
 }
 #endif
 
@@ -285,9 +320,31 @@ dev_tls_create(struct panvk_device *dev, const struct dev_tls_layout *l)
    }
 #endif
 
-   if (panvk_priv_bo_create_kind(dev, l->span, flags,
-                                 VK_SYSTEM_ALLOCATION_SCOPE_DEVICE, &bo,
-                                 PANVK_MEM_DEV_TLS) != VK_SUCCESS)
+   struct panvk_priv_bo *rejects[DEV_TLS_MAX_REJECTS];
+   unsigned n_rejects = 0;
+
+   for (;;) {
+      if (panvk_priv_bo_create_kind(dev, l->span, flags,
+                                    VK_SYSTEM_ALLOCATION_SCOPE_DEVICE, &bo,
+                                    PANVK_MEM_DEV_TLS) != VK_SUCCESS) {
+         bo = NULL;
+         break;
+      }
+      if (!dev_tls_crosses_4g(bo->addr.dev, l->span))
+         break;
+      if (n_rejects == DEV_TLS_MAX_REJECTS) {
+         mesa_loge("panvk: device TLS: no BO inside a 4 GiB window");
+         panvk_priv_bo_unref(bo);
+         bo = NULL;
+         break;
+      }
+      rejects[n_rejects++] = bo;
+   }
+
+   for (unsigned i = 0; i < n_rejects; i++)
+      panvk_priv_bo_unref(rejects[i]);
+
+   if (!bo)
       return NULL;
 
    mesa_logi("panvk: device TLS %u B/thread x %u threads x %u core IDs "
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
index 978f4213276..0a912fbc873 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
@@ -167,8 +167,7 @@ panvk_per_arch(cmd_dispatch_prepare_tls)(
        * instance count) might differ significantly between dispatch commands,
        * rather than track a single maximum size, we might want to consider
        * multiple allocations for different size buckets. */
-      tlsinfo.wls.ptr =
-         panvk_cmd_alloc_dev_mem(cmdbuf, tls, wls_total_size, 4096).gpu;
+      tlsinfo.wls.ptr = panvk_cmd_alloc_tls_mem(cmdbuf, wls_total_size);
       if (!tlsinfo.wls.ptr)
          return 0;
    }
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index f991c5620e8..e5239dcc6fe 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -188,8 +188,7 @@ cmd_close_batch_impl(struct panvk_cmd_buffer *cmdbuf)
           cmdbuf->tls_half[h].tls_size >= size) {
          batch->tlsinfo.tls.ptr = cmdbuf->tls_half[h].tls_ptr;
       } else {
-         batch->tlsinfo.tls.ptr =
-            panvk_cmd_alloc_dev_mem(cmdbuf, tls, size, 4096).gpu;
+         batch->tlsinfo.tls.ptr = panvk_cmd_alloc_tls_mem(cmdbuf, size);
          if (batch->tlsinfo.tls.ptr) {
             cmdbuf->tls_half[h].tls_ptr = batch->tlsinfo.tls.ptr;
             cmdbuf->tls_half[h].tls_size = size;
@@ -213,8 +212,7 @@ cmd_close_batch_impl(struct panvk_cmd_buffer *cmdbuf)
          batch->tlsinfo.wls.ptr = cmdbuf->tls_half[h].wls_ptr;
       } else {
          batch->tlsinfo.wls.ptr =
-            panvk_cmd_alloc_dev_mem(cmdbuf, tls, batch->wls_total_size, 4096)
-               .gpu;
+            panvk_cmd_alloc_tls_mem(cmdbuf, batch->wls_total_size);
          if (batch->tlsinfo.wls.ptr) {
             cmdbuf->tls_half[h].wls_ptr = batch->tlsinfo.wls.ptr;
             cmdbuf->tls_half[h].wls_size = batch->wls_total_size;
diff --git a/src/panfrost/vulkan/panvk_cmd_alloc.h b/src/panfrost/vulkan/panvk_cmd_alloc.h
index 947300ff2a7..0220e182dde 100644
--- a/src/panfrost/vulkan/panvk_cmd_alloc.h
+++ b/src/panfrost/vulkan/panvk_cmd_alloc.h
@@ -37,6 +37,26 @@ panvk_cmd_alloc_from_pool(struct panvk_cmd_buffer *cmdbuf,
                                 .alignment = __alignment,                      \
                              })
 
+/* jm-v7 0145: TLS and WLS regions must not cross a 4 GiB boundary: the GPU
+ * adds the per-thread/per-workgroup offset to the low 32 bits of the base
+ * only (kbase: BASE_MEM_GPU_VA_SAME_4GB_PAGE, "required for TLS memory";
+ * pan_emit_tls() asserts it for WLS). A crossing region writes 4 GiB below
+ * its base (Mali-G1-Ultra tessellation: translation fault at 0x5f0005d040,
+ * pool BOs straddling 0x6000000000). A crossing allocation is skipped: the
+ * next one starts past the boundary, or in a new pool BO. */
+static inline uint64_t
+panvk_cmd_alloc_tls_mem(struct panvk_cmd_buffer *cmdbuf, uint64_t size)
+{
+   for (unsigned i = 0; i < 4; i++) {
+      uint64_t va = panvk_cmd_alloc_dev_mem(cmdbuf, tls, size, 4096).gpu;
+      if (!va || (va >> 32) == ((va + size - 1) >> 32))
+         return va;
+   }
+
+   vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   return 0;
+}
+
 static inline struct pan_ptr
 panvk_cmd_upload_to_pool(struct panvk_cmd_buffer *cmdbuf,
                          struct panvk_pool *pool,
-- 
2.56.0

