From 9ea8ae695980995564d404337eb41032a5002cd3 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Fri, 23 Oct 2026 08:50:55 +0000
Subject: [PATCH 86/89] jm-v7 113: drop the dead per-batch BO list on JM submit

Rationale: every JM batch built a VLA of all the command buffer's desc,
varying and TLS pool BOs plus the FB/blit/heap BOs, then deduplicated it
in O(n^2); kbase_atom_alloc_try() only copied the first 8 entries into
kbase_atom_slot::bos, which nothing reads (perf review 2026-10-22 K7).
kbase JM atoms have no BO list: memory residency belongs to the kbase
context.
Expected gain: CPU per vkQueueSubmit, growing with command buffer size
(a 30-batch command buffer with 100 pool BOs did 30 x ~5000 compares),
and no large stack VLA.

The submit path now passes NULL/0. Trivially safe (the list had no
reader), so no knob.
Arch: kbase JM (v6/v7/v9). Not device-tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 52 +++------------------
 1 file changed, 7 insertions(+), 45 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 09d57a51..910301a2 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -473,51 +473,13 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
 #endif
 
       list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
-         /* FIXME: should be done at the batch level */
-         unsigned nr_bos = panvk_pool_num_bos(&cmdbuf->desc_pool) +
-                           panvk_pool_num_bos(&cmdbuf->varying_pool) +
-                           panvk_pool_num_bos(&cmdbuf->tls_pool) +
-                           batch->fb.bo_count + (batch->blit.src ? 1 : 0) +
-                           (batch->blit.dst ? 1 : 0) +
-                           (batch->vtc_jc.first_tiler ? 1 : 0) + 1;
-         unsigned bo_idx = 0;
-         struct pan_kmod_bo *bos[nr_bos];
-
-         panvk_pool_get_bos(&cmdbuf->desc_pool, &bos[bo_idx]);
-         bo_idx += panvk_pool_num_bos(&cmdbuf->desc_pool);
-
-         panvk_pool_get_bos(&cmdbuf->varying_pool, &bos[bo_idx]);
-         bo_idx += panvk_pool_num_bos(&cmdbuf->varying_pool);
-
-         panvk_pool_get_bos(&cmdbuf->tls_pool, &bos[bo_idx]);
-         bo_idx += panvk_pool_num_bos(&cmdbuf->tls_pool);
-
-         for (unsigned i = 0; i < batch->fb.bo_count; i++)
-            bos[bo_idx++] = batch->fb.bos[i];
-
-         if (batch->blit.src)
-            bos[bo_idx++] = batch->blit.src;
-
-         if (batch->blit.dst)
-            bos[bo_idx++] = batch->blit.dst;
-
-         if (batch->vtc_jc.first_tiler)
-            bos[bo_idx++] = (batch->heap_half && dev->tiler_heap2)
-                               ? dev->tiler_heap2->bo
-                               : dev->tiler_heap->bo;
-
-         bos[bo_idx++] = dev->sample_positions->bo;
-         assert(bo_idx == nr_bos);
-
-         /* Merge identical BO entries. */
-         for (unsigned x = 0; x < nr_bos; x++) {
-            for (unsigned y = x + 1; y < nr_bos;) {
-               if (bos[x] == bos[y])
-                  bos[y] = bos[--nr_bos];
-               else
-                  y++;
-            }
-         }
+         /* jm-v7 113: kbase JM atoms carry no BO list (residency is the
+          * kbase context's), and kbase_kmod only copied it into an unused
+          * slot field, so the per-batch gathering of every pool BO and its
+          * O(n^2) dedup were dead work.
+          */
+         struct pan_kmod_bo **bos = NULL;
+         unsigned nr_bos = 0;
 
          panvk_wait_event_ops(batch);
 
