From b68d166fe30e5e7a10b57344df30340c15f02bad Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 13:04:29 +0000
Subject: [PATCH] jm-v7 047: lower 64-bit arithmetic atomics to an ACMPXCHG
 loop on Bifrost

ATOM_C.i64 on Mali-G52 stores a value whose high word equals the low word (A06 bachata_exec int64_atomics: max = 0x13e7_000013e7). Route every 64-bit arithmetic atomic through nir_lower_atomics on arch < 9; 64-bit xchg and cmpxchg build their staging vector explicitly and stay native.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/compiler/bifrost/bifrost_nir.c | 26 +++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/panfrost/compiler/bifrost/bifrost_nir.c b/src/panfrost/compiler/bifrost/bifrost_nir.c
index 4cab1df..4237378 100644
--- a/src/panfrost/compiler/bifrost/bifrost_nir.c
+++ b/src/panfrost/compiler/bifrost/bifrost_nir.c
@@ -990,6 +990,26 @@ static bool pan_nir_lower_buf_image_access(nir_shader *nir, unsigned arch);
 static bool bi_should_idvs(nir_shader *nir, const struct pan_compile_inputs *inputs);
 static bool bifrost_nir_lower_vs_atomics(nir_shader *nir);
 
+/* nir_lower_atomics filter: true = native. */
+static bool
+bi_atomic_i64_supported(const nir_instr *instr, const void *data)
+{
+   const nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+
+   if (intr->def.bit_size != 64)
+      return true;
+
+   /* Only xchg/cmpxchg (which build their staging vector explicitly) are
+    * trusted at 64 bits; every arithmetic op goes through the CAS loop. */
+   switch (nir_intrinsic_atomic_op(intr)) {
+   case nir_atomic_op_xchg:
+   case nir_atomic_op_cmpxchg:
+      return true;
+   default:
+      return false;
+   }
+}
+
 void
 bifrost_postprocess_nir(nir_shader *nir,
                         const struct pan_compile_inputs *inputs,
@@ -1003,6 +1023,12 @@ bifrost_postprocess_nir(nir_shader *nir,
    if (gpu_arch >= 9)
       NIR_PASS(_, nir, pan_nir_lower_image_64bit);
 
+   /* Bifrost ATOM_C.i64 stores a value whose high word is the low word
+    * (jm-v7 047, A06 int64_atomics max = 0x13e7_000013e7). Lower 64-bit
+    * arithmetic atomics to a 64-bit ACMPXCHG loop. */
+   if (gpu_arch < 9)
+      NIR_PASS(_, nir, nir_lower_atomics, bi_atomic_i64_supported);
+
    if ((gpu_arch == 9 || gpu_arch == 10) &&
        (inputs->robust_modes & (nir_var_mem_ssbo | nir_var_mem_ubo))) {
       nir_variable_mode robust_modes = inputs->robust_modes;
-- 
