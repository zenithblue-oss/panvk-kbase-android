+   nir_def *vid = nir_load_vertex_id(&b);
+   nir_def *p = nir_load_tess_param_buffer_poly(&b);
+   nir_def *ib = nir_load_global_constant(
+      &b, 1, 64,
+      nir_iadd_imm(&b, p, offsetof(struct poly_tess_params, index_buffer)),
+      .align_mul = 8);
