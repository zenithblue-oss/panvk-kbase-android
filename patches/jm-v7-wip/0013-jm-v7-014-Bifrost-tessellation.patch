+   struct panvk_compute_sysvals sysvals = {0};
+   sysvals.num_work_groups.x = 1;
+   sysvals.num_work_groups.y = 1;
+   sysvals.num_work_groups.z = 1;
+   sysvals.local_group_size.x = local_size;
+   sysvals.local_group_size.y = 1;
