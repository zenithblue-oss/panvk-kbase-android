From 29d20553ff2a8004029baafcce7123bf4a22e835 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Thu, 22 Oct 2026 09:23:46 +0000
Subject: [PATCH] jm-v7 104: v6/v7 counter-clockwise tess triangles from the
 tessellator

panlib_v7_tessellate(WITH_COUNTS) ran a serial post-pass over every
counter-clockwise patch, swapping two indices per triangle after the
tessellator had written them (one thread per patch, up to 24576 index
loads+stores at factor 64). csf-v11 216 lets the shared CHWTessellator
write the swapped triangle directly when the params carry
POLY_TESS_CCW_INLINE (bit 1); this uses it on v6/v7: the JM v7 tess
path passes POLY_TESS_CCW_INLINE for ccw draws and the v7 post-pass only
runs for bit 0.

PANVK_TESS_WINDING_INLINE=0 restores the post-pass (read per tess draw).

Depends on csf-v11 216 (POLY_TESS_CCW_INLINE, CHWTessellator
swap_winding). Host-checked: libpan v6/v7 mesa_clc + panfrost_compile,
jm/panvk_vX_cmd_draw.c v7 -fsyntax-only. Not device-tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/libpan/draw_helper.cl         | 5 +++--
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c | 7 ++++++-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/libpan/draw_helper.cl b/src/panfrost/libpan/draw_helper.cl
index 8177734b..57cf2d37 100644
--- a/src/panfrost/libpan/draw_helper.cl
+++ b/src/panfrost/libpan/draw_helper.cl
@@ -1855,9 +1855,10 @@ panlib_v7_tessellate(constant struct poly_tess_params *p, uint32_t domain__3,
       poly_tess_isoline_process(p, patch, mode);
 
    /* The tessellator emits clockwise triangles, swap two vertices of each
-    * one for the other winding.
+    * one for the other winding (bit 0; POLY_TESS_CCW_INLINE: already
+    * swapped by the tessellator).
     */
-   if (mode == POLY_TESS_MODE_WITH_COUNTS && p->ccw && domain__3 != 2 &&
+   if (mode == POLY_TESS_MODE_WITH_COUNTS && (p->ccw & 1) && domain__3 != 2 &&
        !p->points_mode) {
       global uint32_t *idx = p->index_buffer;
       uint32_t end = p->counts[patch];
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 6eb2626a..910cab6b 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -3764,7 +3764,12 @@ panvk_tess_draw(struct panvk_cmd_buffer *cmdbuf,
       .partitioning = spacing,
       .points_mode = points,
       .isolines = domain == 2,
-      .ccw = ccw,
+      /* PANVK_TESS_WINDING_INLINE (default 1): the tessellator writes the
+       * counter-clockwise triangles, no per-patch serial swap pass. */
+      .ccw = !ccw ? 0
+             : debug_get_num_option("PANVK_TESS_WINDING_INLINE", 1)
+                ? POLY_TESS_CCW_INLINE
+                : 1,
    };
    t->heap.base = l_heap;
    t->heap.size = heap_size;
-- 
