From d365303c3da40aaef4d0db1f3522d1175cab4d30 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Fri, 30 Oct 2026 14:20:55 +0530
Subject: [PATCH 172/173] panvk/bc: per-mode SPIR-V for the lowmem BC
 transcoders

On the X6 Pro (v11, lowmem BC: BC1-BC5 transcoded to ETC2/EAC, BC6H
decoded per block) a cold bc_decode took 5.2 s against rc4's 0.55 s.
Timing the pipeline creates showed 490-690 ms per ETC2 mode, of which
the back end (panvk_compile_shaders) was 4-45 ms: the rest is the
driver front end on the full transcoder, which carries every mode and
option behind specialization constants and big constant tables.

bc/gen_etc2_fixed.sh now builds the ETC2 transcoder once per mode at the
default PANVK_BC_LM_OPTS (0x3020000) and the BC6H block decoder once per
signedness, with the mode as a plain constant and spirv-opt -O folding the
rest away. In those builds the lookup tables are private arrays instead of
const arrays: glslang copies a const array into a function variable at
every dynamic index (EAC_NEAR, 512 words, 32 times in BC2), which made BC2
927 ms even after folding. Non-default PANVK_BC_LM_OPTS keeps the full
shader.

X6 Pro, cold (shader cache cleared), imported slot:
- bc_decode 612-648 ms (122f 5192, rc4 526-588, PASS mismatch=0)
- per mode: ETC2 8-55 ms, BC6H block 61-74 ms (was 490-690 / 236-262)
- workload_perf bc_level 39 ms per op (122f 462, rc4 49)
- bc_perf 28.6 s (122f 37.6, rc4 28.7)

PANVK_BC_XC_FIXED=0 compiles every mode from the full shaders again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/bc/gen_etc2_fixed.sh      |    34 +
 src/panfrost/vulkan/bc/gen_spv.sh             |     2 +
 src/panfrost/vulkan/bc/panvk_bc_bc6.comp      |     4 +
 src/panfrost/vulkan/bc/panvk_bc_etc2.comp     |    14 +
 .../vulkan/bc/panvk_bc_etc2_fixed_spv.h       | 15764 ++++++++++++++++
 src/panfrost/vulkan/panvk_vX_cmd_meta.c       |    52 +-
 6 files changed, 15868 insertions(+), 2 deletions(-)
 create mode 100755 src/panfrost/vulkan/bc/gen_etc2_fixed.sh
 create mode 100644 src/panfrost/vulkan/bc/panvk_bc_etc2_fixed_spv.h

diff --git a/src/panfrost/vulkan/bc/gen_etc2_fixed.sh b/src/panfrost/vulkan/bc/gen_etc2_fixed.sh
new file mode 100755
index 00000000000..509bdc5d47c
--- /dev/null
+++ b/src/panfrost/vulkan/bc/gen_etc2_fixed.sh
@@ -0,0 +1,34 @@
+#!/bin/sh
+# 0172: the BC1-BC5 -> ETC2/EAC transcoder once per mode at the default
+# PANVK_BC_LM_OPTS (0x3020000), with spirv-opt -O folding away the other
+# modes: the full shader costs the driver front end ~500 ms per mode on the
+# X6 Pro, of which the back end is under 45 ms. Called by gen_spv.sh.
+set -eu
+cd "$(dirname "$0")"
+t=$(mktemp -d)
+out=panvk_bc_etc2_fixed_spv.h
+{
+   echo "/* Generated by gen_etc2_fixed.sh from panvk_bc_etc2.comp. */"
+   echo "#pragma once"
+} > $out
+for m in 0 1 2 3 4 5 6 7; do
+   glslangValidator -V --target-env vulkan1.1 -DXC_MODE_FIXED=${m}u \
+      -DXC_OPTS_FIXED=0x3020000u -o $t/m.spv panvk_bc_etc2.comp > /dev/null
+   spirv-opt -O $t/m.spv -o $t/o.spv
+   {
+      echo "static const uint32_t panvk_bc_etc2_m${m}_spv[] = {"
+      od -An -v -tx4 -w32 $t/o.spv | sed -e 's/^ */\t0x/' -e 's/ \+/,0x/g' -e 's/$/,/'
+      echo "};"
+   } >> $out
+done
+for m in 8 9; do
+   glslangValidator -V --target-env vulkan1.1 -DPANVK_BC_BLOCK -DXC_MODE_FIXED=${m}u \
+      -o $t/m.spv panvk_bc_bc6.comp > /dev/null
+   spirv-opt -O $t/m.spv -o $t/o.spv
+   {
+      echo "static const uint32_t panvk_bc_bc6_blk_m${m}_spv[] = {"
+      od -An -v -tx4 -w32 $t/o.spv | sed -e 's/^ */\t0x/' -e 's/ \+/,0x/g' -e 's/$/,/'
+      echo "};"
+   } >> $out
+done
+rm -rf $t
