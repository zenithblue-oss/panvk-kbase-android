index ad6ca6ae8b4..1f99d37798f 100644
--- a/src/panfrost/vulkan/bc/gen_spv.sh
+++ b/src/panfrost/vulkan/bc/gen_spv.sh
@@ -33,3 +33,5 @@ sed -i 's/^const uint32_t/static const uint32_t/' panvk_bc_bc7_fs_fast_spv.h
 glslangValidator -V --target-env vulkan1.1 --vn panvk_bc_scopy_spv \
    -o panvk_bc_scopy_spv.h panvk_bc_scopy.comp
 sed -i 's/^const uint32_t/static const uint32_t/' panvk_bc_scopy_spv.h
+# 0172: per-mode ETC2 transcoders.
+sh ./gen_etc2_fixed.sh
diff --git a/src/panfrost/vulkan/bc/panvk_bc_bc6.comp b/src/panfrost/vulkan/bc/panvk_bc_bc6.comp
index 762fb6f68f8..0fa8340baed 100644
--- a/src/panfrost/vulkan/bc/panvk_bc_bc6.comp
+++ b/src/panfrost/vulkan/bc/panvk_bc_bc6.comp
@@ -16,7 +16,11 @@ layout(location = 0) out vec4 o_color;
 layout(local_size_x = 8, local_size_y = 8, local_size_z = 1,
        local_size_x_id = 0, local_size_y_id = 1) in;
 /* 8: UF16 -> B10G11R11_UFLOAT, 9: SF16 -> R16G16B16A16_SFLOAT. */
+#ifdef XC_MODE_FIXED
+const uint XC_MODE = XC_MODE_FIXED; /* 0172 */
+#else
 layout(constant_id = 2) const uint XC_MODE = 8u;
+#endif
 #else
 layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
 #endif
diff --git a/src/panfrost/vulkan/bc/panvk_bc_etc2.comp b/src/panfrost/vulkan/bc/panvk_bc_etc2.comp
index 248bcfc2353..414ba033853 100644
--- a/src/panfrost/vulkan/bc/panvk_bc_etc2.comp
+++ b/src/panfrost/vulkan/bc/panvk_bc_etc2.comp
@@ -64,8 +64,15 @@
 layout(local_size_x = 8, local_size_y = 8, local_size_z = 1,
        local_size_x_id = 0, local_size_y_id = 1) in;
 
+#ifdef XC_MODE_FIXED
+/* 0172: one SPIR-V per mode at the default PANVK_BC_LM_OPTS (gen_spv.sh),
+ * so the driver front end only parses that mode's code. */
+const uint XC_MODE = XC_MODE_FIXED;
+const uint XC_OPTS = XC_OPTS_FIXED;
+#else
 layout(constant_id = 2) const uint XC_MODE = 0u;      /* XC_* */
 layout(constant_id = 3) const uint XC_OPTS = 0x30000u; /* PANVK_BC_LM_OPTS */
+#endif
 /* csf-v11/218: 1 = one dispatch over several small whole levels, whose
  * addresses come from a table at registers.src (see main()). */
 layout(constant_id = 4) const uint XC_BATCH = 0u;
@@ -108,7 +115,14 @@ layout(push_constant) uniform Registers
 #define U(x) uint(x)
 #define F(x) float(x)
 #define GLOBAL
+#ifdef XC_MODE_FIXED
+/* 0172: one private array per table; a const array is copied into a
+ * function variable at every dynamic index (EAC_NEAR: 32 copies of 512
+ * words in BC2), which costs the driver front end most of a second. */
+#define CARR(type, name, n) type name[n] = type[n](
+#else
 #define CARR(type, name, n) const type name[n] = type[n](
+#endif
 #define CEND );
 #define UNROLL [[unroll]]
 #endif
