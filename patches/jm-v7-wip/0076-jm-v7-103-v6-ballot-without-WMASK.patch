From c68c6859804c4c17a3523d5f8e316428b06a8b39 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 22 Oct 2026 06:42:58 +0000
Subject: [PATCH] jm-v7 103: v6 ballot without WMASK

The FTL Galaxy S9 (Mali-G72, gpu_id 0x62210010, RC5-dev-v7M) PanProbe
runs lost the device in three compute shaders with kbase event 0x51
(INSTR_INVALID_ENC): shader_arith subgroup_size_control (subgroupAdd),
sampler gather_offsets (dynamic textureGatherOffset, which takes a
waterfall over the offset) and vkd3d_heap image_heap (the 085 texture
waterfall over a NonUniform heap index). A host compile for 0x6221
(panvk + panfrost drm-shim) shows WMASK.subgroup4 in all three and in
none of the passing shaders; the rest of the code (CLPER_OLD, CLZ, MUX,
TEXC, U8_TO_U32) is also in v6 code that runs. WMASK, like the full
CLPER with its subgroup2/4/8 modifier, is a v7 instruction.

On v6, build nir ballot from CLPER_OLD, which reads another lane of the
4-wide warp and returns zero for an inactive lane: every lane contributes
src & (1 << lane_id) and the result is the OR of the four lanes. This
covers ballot, vote any/all, the active-lane mask used by the reduce and
scan lowering, first_invocation/read_first_invocation and every waterfall.
The packer now asserts that no WMASK reaches a v6 clause. v7 (including
G31) and v9+ are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../compiler/bifrost/bifrost/bi_pack.c        |  3 ++
 .../compiler/bifrost/bifrost_compile.c        | 29 +++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/src/panfrost/compiler/bifrost/bifrost/bi_pack.c b/src/panfrost/compiler/bifrost/bifrost/bi_pack.c
index 90561284..74696157 100644
--- a/src/panfrost/compiler/bifrost/bifrost/bi_pack.c
+++ b/src/panfrost/compiler/bifrost/bifrost/bi_pack.c
@@ -615,6 +615,9 @@ bi_pack_clause(bi_context *ctx, bi_clause *clause, bi_clause *next_1,
          assert(ctx->quirks & BIFROST_LIMITED_CLPER);
       else if (add && add->op == BI_OPCODE_CLPER_I32)
          assert(!(ctx->quirks & BIFROST_LIMITED_CLPER));
+
+      /* jm-v7 103: v6 has no WMASK (INSTR_INVALID_ENC on Mali-G72). */
+      assert(!(add && add->op == BI_OPCODE_WMASK && ctx->arch == 6));
    }
 
    bool ec0_packed = bi_ec0_packed(clause->tuple_count);
diff --git a/src/panfrost/compiler/bifrost/bifrost_compile.c b/src/panfrost/compiler/bifrost/bifrost_compile.c
index 710a7f12..4c616080 100644
--- a/src/panfrost/compiler/bifrost/bifrost_compile.c
+++ b/src/panfrost/compiler/bifrost/bifrost_compile.c
@@ -1985,6 +1985,35 @@ bi_emit_intrinsic(bi_builder *b, nir_intrinsic_instr *instr)
    case nir_intrinsic_ballot:
    case nir_intrinsic_ballot_relaxed: {
       assert(instr->src[0].ssa->bit_size == 32);
+      /* jm-v7 103: WMASK is not a v6 instruction. On the FTL Galaxy S9
+       * (Mali-G72) every compute shader with a WMASK (subgroupAdd's
+       * active-lane mask, the 085 texture waterfall, the nir_lower_shuffle
+       * waterfall) ended with INSTR_INVALID_ENC (event 0x51); the same
+       * CLPER_OLD/CLZ/MUX code without WMASK runs. Like the full CLPER, WMASK
+       * (with its subgroup2/4/8 modifier) came with v7.
+       *
+       * Build the ballot of the 4-wide v6 warp from CLPER_OLD instead, which
+       * reads another lane and returns zero for an inactive one: each lane
+       * contributes (src & (1 << lane_id)), and the OR of the four lanes'
+       * values is the ballot of the active lanes.
+       */
+      if (b->shader->arch == 6) {
+         bi_index src = bi_src_index(&instr->src[0]);
+         bi_index lane = bi_mov_i32(b, bi_fau(BIR_FAU_LANE_ID, false));
+         bi_index bit =
+            bi_lshift_or_i32(b, bi_imm_u32(1), bi_zero(), bi_byte(lane, 0));
+         bi_index mine = bi_lshift_and_i32(b, bit, src, bi_imm_u8(0));
+         bi_index acc = bi_clper_old_i32(b, mine, bi_imm_u8(0));
+         unsigned lanes = pan_subgroup_size(b->shader->arch);
+         for (unsigned i = 1; i < lanes; i++) {
+            bi_index other = bi_clper_old_i32(b, mine, bi_imm_u8(i));
+            if (i + 1 < lanes)
+               acc = bi_lshift_or_i32(b, other, acc, bi_imm_u8(0));
+            else
+               bi_lshift_or_i32_to(b, dst, other, acc, bi_imm_u8(0));
+         }
+         break;
+      }
       enum bi_subgroup subgroup =
          bi_subgroup_from_cluster_size(pan_subgroup_size(b->shader->arch));
       bi_wmask_to(b, dst, bi_src_index(&instr->src[0]), subgroup, 0);
-- 
