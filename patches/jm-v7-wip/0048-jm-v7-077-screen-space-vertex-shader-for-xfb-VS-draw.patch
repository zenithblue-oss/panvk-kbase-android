From 5ab6d5c66f44027a023187a4ebb3d7d5ac9b62f6 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 14:02:34 +0000
Subject: [PATCH] jm-v7 077: screen-space vertex shader for xfb VS draws
 without transform feedback

A last-stage VS with xfb decorations is compiled for clip space
(jm-v7 009) and every draw goes through the passthrough GS emulation,
even while transform feedback is inactive: `if (!emu &&
vs->gs.vs_clip_space) emu = passthrough_gs(...)` never checks
xfb.active. DXVK declares xfb outputs on many vertex shaders, so those
draws paid a vertex job, a GS compute job and worst-case buffers for
nothing (perf review M3).

Such a VS (no GS/TCS next stage, no gl_ViewportIndex) now gets an
alternate compile without its xfb info (jm-v7 076 panvk_shader::alt):
a plain screen-space VS (IDVS where jm-v7 075 allows it).
panvk_v7_select_alt_shaders() uses it while xfb is inactive and no
geometry shader is bound, and the clip-space one otherwise.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c | 19 +++++++++++++++++++
 src/panfrost/vulkan/panvk_vX_shader.c      | 20 +++++++++++++++++---
 2 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 5f296b05..ecb73bfb 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -2924,6 +2924,25 @@ panvk_v7_select_alt_shaders(struct panvk_cmd_buffer *cmdbuf)
          }
       }
    }
+
+   /* jm-v7 077: the screen-space VS without xfb while transform feedback is
+    * inactive and no geometry shader is bound; the clip-space one (drawn
+    * through the capturing passthrough GS) otherwise.
+    */
+   const struct panvk_shader *vs = cmdbuf->state.gfx.vs.shader;
+   if (vs && (vs->vk.stage == MESA_SHADER_VERTEX)) {
+      const struct panvk_shader *main_vs = vs->alt_parent ? vs->alt_parent : vs;
+      if (main_vs->alt) {
+         const bool plain =
+            !cmdbuf->state.gfx.xfb.active && !cmdbuf->state.gfx.gs.shader;
+         const struct panvk_shader *want = plain ? main_vs->alt : main_vs;
+         if (want != vs) {
+            cmdbuf->state.gfx.vs.shader = want;
+            gfx_state_set_dirty(cmdbuf, VS);
+            gfx_state_set_dirty(cmdbuf, VS_PUSH_UNIFORMS);
+         }
+      }
+   }
 }
 #endif
 
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index 12da80b2..1b823eb5 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -5159,16 +5159,30 @@ panvk_v7_wants_alt(const struct vk_features *features,
               BITSET_TEST(state->dynamic,
                           MESA_VK_DYNAMIC_DS_DEPTH_BOUNDS_TEST_ENABLE));
 
+   /* jm-v7 077: a last-stage vertex shader with xfb outputs is compiled for
+    * clip space and always drawn through the passthrough GS, even while
+    * transform feedback is inactive (DXVK declares xfb on many VS). Its
+    * alternate is the plain screen-space VS without xfb, drawn directly.
+    */
+   if (info->stage == MESA_SHADER_VERTEX)
+      return panvk_vs_wants_xfb_passthrough(info) &&
+             !(info->next_stage_mask &
+               (VK_SHADER_STAGE_GEOMETRY_BIT |
+                VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT)) &&
+             !panvk_v7_vs_writes_viewport(info);
+
    return false;
 }
 
-/* The alternate's NIR: the fragment shader skips the depth bounds lowering
- * (panvk_compile_shader(alt = true)), nothing to change here.
+/* The alternate's NIR. The fragment shader skips the depth bounds lowering
+ * (panvk_compile_shader(alt = true)); the vertex shader loses its xfb info,
+ * so it is compiled for screen space with no passthrough.
  */
 static void
 panvk_v7_prepare_alt_nir(struct vk_shader_compile_info *info)
 {
-   (void)info;
+   if (info->stage == MESA_SHADER_VERTEX)
+      info->nir->xfb_info = NULL;
 }
 #endif
 
