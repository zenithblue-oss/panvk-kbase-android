    panvk_meta_cleanup(device);
@@ -902,6 +1044,9 @@ panvk_per_arch(destroy_device)(struct panvk_device *device,
    panvk_precomp_cleanup(device);
 #if PAN_ARCH >= 10 && PAN_ARCH < 14
    panvk_per_arch(device_draw_context_cleanup)(device);
+#endif
