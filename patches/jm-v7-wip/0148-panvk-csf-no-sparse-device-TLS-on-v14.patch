From 41aa2dafce2a6798df8b7cc9fa70f5855d04c1f2 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 29 Oct 2026 09:11:51 +0530
Subject: [PATCH] panvk/csf: no sparse device TLS on v14

On the Mali-G1-Ultra (v14, shader_present 0x3300ff) the DXVK D3D9 cube
lost the device within seconds in most runs: kbase reported a GPU read
translation fault (exception 0xc0/0xc1) at garbage addresses (0x0,
0x3f800000, 0x3f67f100, 0x144xxxxxxxx, one write at 0x5f00000000),
then every CSF subqueue timed out. With PANVK_TLS_SPARSE=0 (or
PANVK_DEBUG=sync, which also skips the alias) no run faulted. The
sparse alias region maps the core-ID slots of absent cores onto slab 0,
so a v14 stack placement that differs from the per-core slots makes
threads share stacks and reload other threads' spills as pointers.

PANVK_TLS_SPARSE defaults to 0 on v14; =1 still forces the alias.
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index 7a83fee4f56..ace715bb2b2 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -133,7 +133,7 @@ dev_tls_release(struct panvk_cmd_buffer *cmdbuf)
  * exist, and kbase commits and zeroes all of them. The "device TLS" log
  * line prints the real numbers.
  *
- * PANVK_TLS_SPARSE=1 (default on kbase): one BO holds a slab per present
+ * PANVK_TLS_SPARSE=1 (default on kbase before v14): one BO holds a slab per present
  * core, and a KBASE_IOCTL_MEM_ALIAS region spans the whole core-ID range
  * with each present core's slot mapped to its own slab. The slots of absent
  * cores alias the first slab (no extra pages; nothing runs there), so the
@@ -157,7 +157,15 @@ static bool
 dev_tls_sparse(void)
 {
    static int v = -1;
-   return dev_tls_knob(&v, "PANVK_TLS_SPARSE", 1) != 0;
+   /* v14 (Mali-G1-Ultra, mask 0x3300ff): with the alias region, shaders
+    * that spill read back garbage pointers (GPU read faults at 0x0,
+    * 0x3f800000, 0x144xxxxxxxx; DXVK D3D9 cube DEVICE_LOST in most 15 s
+    * runs), never with the full BO. The v14 stack placement does not match
+    * the per-core slots the alias assumes. Full BO by default there;
+    * PANVK_TLS_SPARSE=1 still forces the alias.
+    * ponytail: off for all of v14; re-enable once the v14 core-to-slot
+    * mapping is known. */
+   return dev_tls_knob(&v, "PANVK_TLS_SPARSE", PAN_ARCH < 14) != 0;
 }
 
 static uint64_t
-- 
2.56.0

