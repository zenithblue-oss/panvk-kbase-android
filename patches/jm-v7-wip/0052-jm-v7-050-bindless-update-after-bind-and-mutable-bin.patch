diff --git a/src/panfrost/vulkan/panvk_cmd_desc_state.h b/src/panfrost/vulkan/panvk_cmd_desc_state.h
index 9b82fc38..1532f3ab 100644
--- a/src/panfrost/vulkan/panvk_cmd_desc_state.h
+++ b/src/panfrost/vulkan/panvk_cmd_desc_state.h
@@ -79,6 +79,22 @@ VkResult panvk_per_arch(cmd_prepare_shader_desc_tables)(
    const struct panvk_shader_desc_info *desc_info,
    bool fill_image_table,
    struct panvk_shader_desc_state *shader_desc_state);
+
+/* Bindless textures/samplers (jm-v7 050): the direct texture and sampler
+ * tables point at a device-constant base 64 GiB below the device dummy
+ * sampler, and shaders index set memory as (set - base) / 32 + descriptor
+ * (desc.direct_idx sysvals). kbase maps GPU memory at its CPU address
+ * (SAME_VA), so descriptor pools land within the +-64 GiB a 32-bit index
+ * covers. A constant base keeps the textures pointer and the sysvals in
+ * sync whatever is bound.
+ */
+#define PANVK_DIRECT_BASE_SPAN (64ull << 30)
+
+static inline uint32_t
+panvk_desc_direct_idx(uint64_t base, uint64_t addr)
+{
+   return addr >= base ? (uint32_t)((addr - base) / PANVK_DESCRIPTOR_SIZE) : 0;
+}
 #else
 void panvk_per_arch(cmd_fill_dyn_bufs)(
    const struct panvk_descriptor_state *desc_state,
diff --git a/src/panfrost/vulkan/panvk_descriptor_set_layout.h b/src/panfrost/vulkan/panvk_descriptor_set_layout.h
index 603a4c63..35b796f2 100644
--- a/src/panfrost/vulkan/panvk_descriptor_set_layout.h
+++ b/src/panfrost/vulkan/panvk_descriptor_set_layout.h
@@ -129,6 +129,37 @@ panvk_get_desc_stride(const struct panvk_descriptor_set_binding_layout *layout)
       ? layout->textures_per_desc + layout->samplers_per_desc : 1;
 }
 
+/* v6/v7 descriptor indexing (jm-v7 050): the per-draw descriptor copy into
+ * the per-type hardware tables cannot cover update-after-bind arrays of a
+ * million descriptors, nor mutable bindings whose type is only known per
+ * element. Such bindings are bindless: shaders read their descriptors from
+ * the set memory (storage images and texel buffers become address
+ * computations, textures and samplers are indexed relative to the lowest
+ * bound set, see panvk_per_arch(cmd_desc_direct_base)()).
+ */
+static inline bool
+panvk_binding_is_bindless(
+   const struct panvk_descriptor_set_binding_layout *layout)
+{
+#if PAN_ARCH < 9
+   switch (layout->type) {
+   case VK_DESCRIPTOR_TYPE_MUTABLE_EXT:
+      return true;
+   case VK_DESCRIPTOR_TYPE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+   case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      return layout->flags & VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT;
+   default:
+      return false;
+   }
+#else
+   return false;
+#endif
+}
