From fd60d4db52f23faf24aba8d848aea3ad95541232 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 13:43:16 +0000
Subject: [PATCH] jm-v7 071: keep query availability words out of the WB-mapped
 pool on v6/v7

Since jm-v7 021 the availability words (one u32 per query) live in the
WB_MMAP mempools.rw, so 16 queries share each 64-byte line. The host
reset (reset_query_pool: memset + clean, no invalidate first) writes
back whole lines: a GPU availability write to a neighbouring query
between the CPU line fill and the clean is lost, and a later WAIT
spins 2 s and reports DEVICE_LOST (perf review H4).

Give each query pool its own BO for the availability words, GPU-cached
(no BASE_MEM_UNCACHED_GPU, which faulted on G52) but write-combined on
the CPU, so host writes only touch the words they store. Host reads
still go through panvk_priv_mem_readback() (no invalidate needed for a
WC mapping). The GPU-side layout (u32 per query) is unchanged.
PANVK_QUERY_UNCACHED=1 keeps the old rw_nc placement.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_vX_query_pool.c | 25 ++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_vX_query_pool.c b/src/panfrost/vulkan/panvk_vX_query_pool.c
index 9917acc..9ea833a 100644
--- a/src/panfrost/vulkan/panvk_vX_query_pool.c
+++ b/src/panfrost/vulkan/panvk_vX_query_pool.c
@@ -131,9 +131,28 @@ panvk_per_arch(CreateQueryPool)(VkDevice _device,
       const char *e = getenv("PANVK_QUERY_UNCACHED");
       query_nc = e && e[0] == '1';
    }
-   pool->available_mem = panvk_pool_alloc_mem(
-      query_nc ? &device->mempools.rw_nc : &device->mempools.rw,
-      syncobjs_alloc_info);
+   if (query_nc) {
+      pool->available_mem =
+         panvk_pool_alloc_mem(&device->mempools.rw_nc, syncobjs_alloc_info);
+   } else {
+      /* Not from mempools.rw: with a WB (cached CPU) mapping, the host
+       * reset memsets and cleans whole cache lines, and 16 queries share
+       * one. A GPU availability write to a neighbouring query between the
+       * line fill and the clean would be overwritten, and a later WAIT
+       * spins into DEVICE_LOST (perf review H4). Use a BO of the pool's
+       * own, GPU-cached but write-combined on the CPU, so host writes only
+       * touch the words they store.
+       */
+      struct panvk_priv_bo *avail_bo = NULL;
+      if (panvk_priv_bo_create(device, syncobjs_alloc_info.size,
+                               panvk_device_adjust_bo_flags(device, 0),
+                               VK_SYSTEM_ALLOCATION_SCOPE_OBJECT,
+                               &avail_bo) == VK_SUCCESS)
+         pool->available_mem = (struct panvk_priv_mem){
+            .bo = (uintptr_t)avail_bo,
+            .offset = 0,
+         };
+   }
 #else
    pool->available_mem =
       panvk_pool_alloc_mem(&device->mempools.rw_nc, syncobjs_alloc_info);
-- 
