From 574c2c28a47ab692d5b4a37079aec49d8e01bf57 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 06:45:32 +0000
Subject: [PATCH] jm-v7 017: Bifrost multiViewport through the geometry
 emulation

multiViewport and 16 viewports on v6/v7. Without
shaderOutputViewportIndex only a geometry shader selects a viewport, and
on Bifrost it already runs as the compute emulation that does the
viewport transform itself (007), from a per-viewport table that was
filled with viewport 0. Now:

- The table has each viewport's transform and scissor box (40-byte
  entries, PANVK_GS_VIEWPORT_STRIDE). An index past viewportCount uses
  the last viewport.
- The tiler has one viewport descriptor: while the bound emulation writes
  gl_ViewportIndex and viewportCount > 1, it gets the union of the
  scissor boxes and of the depth ranges (re-emitted when the GS changes).
- Each primitive is cut to its own scissor in the FS: the emulation
  writes the four edge distances (times clip w, so perspective
  interpolation keeps the sign) to CLIP_DIST1, which an FS compiled
  without the previous stage's layout already tests (the clip-distance
  kill). The GS's own compact clip distances are not carried by the
  emulation, so the slot is free.
- The FS reads gl_ViewportIndex from the emulation's copy
  (PANVK_GS_VIEWPORT_INDEX_SLOT); unwritten, it reads constant 0.

Limits: depth clamping and near/far clipping use the union of the depth
ranges, not the selected viewport's (only differs when viewports have
different depth ranges). A GS that writes non-compact data to CLIP_DIST1
gets no per-viewport scissor. Not device-tested.
---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c    | 136 +++++++++++++++---
 src/panfrost/vulkan/panvk_gs.h                |  12 +-
 src/panfrost/vulkan/panvk_nir_lower_gs.c      |  32 ++++-
 src/panfrost/vulkan/panvk_shader.h            |   5 +
 .../vulkan/panvk_vX_physical_device.c         |   6 +-
 src/panfrost/vulkan/panvk_vX_shader.c         |  24 ++++
 6 files changed, 189 insertions(+), 26 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 32c50f9..d71fcef 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -997,6 +997,67 @@ panvk_draw_prepare_attributes(struct panvk_cmd_buffer *cmdbuf,
       cmdbuf->state.gfx.vs.indirect_attrib_bufs_infos;
 }
 
+/* The scissor box of viewport i: the viewport rectangle cut by scissor i,
+ * max exclusive.
+ */
+static void
+panvk_viewport_scissor_box(const struct vk_viewport_state *vp, unsigned i,
+                           int *minx, int *miny, int *maxx, int *maxy)
+{
+   const VkViewport *viewport = &vp->viewports[i];
+   const VkRect2D *scissor = &vp->scissors[MIN2(i, vp->scissor_count - 1)];
+
+   /* The spec says "width must be greater than 0.0" */
+   assert(viewport->width >= 0);
+   *minx = (int)viewport->x;
+   *maxx = (int)(viewport->x + viewport->width);
+
+   /* Viewport height can be negative */
+   *miny = MIN2((int)viewport->y, (int)(viewport->y + viewport->height));
+   *maxy = MAX2((int)viewport->y, (int)(viewport->y + viewport->height));
+
+   assert(scissor->offset.x >= 0 && scissor->offset.y >= 0);
+   *minx = MAX2(scissor->offset.x, *minx);
+   *miny = MAX2(scissor->offset.y, *miny);
+   *maxx = MIN2(scissor->offset.x + scissor->extent.width, *maxx);
+   *maxy = MIN2(scissor->offset.y + scissor->extent.height, *maxy);
+}
+
+/* multiViewport (jm-v7 017): the bound geometry emulation selects the
+ * viewport per primitive, so the tiler gets the union of the scissor boxes
+ * and depth ranges, and each primitive is cut to its own scissor in the FS
+ * (panvk_gs_lower_options::scissor_slot).
+ */
+static bool
+panvk_multi_viewport_draw(const struct panvk_cmd_buffer *cmdbuf)
+{
+   const struct panvk_shader *emu = cmdbuf->state.gfx.gs.emu;
+
+   return emu && panvk_shader_only_variant(emu)->gs.writes_viewport &&
+          cmdbuf->vk.dynamic_graphics_state.vp.viewport_count > 1;
+}
+
+static void
+panvk_viewport_depth_range_i(const struct panvk_cmd_buffer *cmdbuf,
+                             unsigned i, float *z_min, float *z_max)
+{
+   const struct vk_viewport_state *vp = &cmdbuf->vk.dynamic_graphics_state.vp;
+
+   if (vp->depth_clamp_mode == VK_DEPTH_CLAMP_MODE_USER_DEFINED_RANGE_EXT) {
+      *z_min = vp->depth_clamp_range.minDepthClamp;
+      *z_max = vp->depth_clamp_range.maxDepthClamp;
+      return;
+   }
+
+   float scale, offset;
+   panvk_viewport_z_coeffs(vp, &cmdbuf->vk.dynamic_graphics_state.rs, i,
+                           &scale, &offset);
+   const float a = vp->depth_clip_negative_one_to_one ? offset - scale : offset;
+   const float b = offset + scale;
+   *z_min = MIN2(a, b);
+   *z_max = MAX2(a, b);
+}
+
 static void
 panvk_emit_viewport(struct panvk_cmd_buffer *cmdbuf,
                     struct mali_viewport_packed *vpd)
@@ -1006,26 +1067,34 @@ panvk_emit_viewport(struct panvk_cmd_buffer *cmdbuf,
    if (vp->viewport_count < 1)
       return;
 
-   const VkViewport *viewport = &vp->viewports[0];
-   const VkRect2D *scissor = &vp->scissors[0];
    float minz, maxz;
    panvk_depth_range(&cmdbuf->state.gfx, &cmdbuf->vk.dynamic_graphics_state.vp,
                      &minz, &maxz);
 
-   /* The spec says "width must be greater than 0.0" */
-   assert(viewport->width >= 0);
-   int minx = (int)viewport->x;
-   int maxx = (int)(viewport->x + viewport->width);
-
-   /* Viewport height can be negative */
-   int miny = MIN2((int)viewport->y, (int)(viewport->y + viewport->height));
-   int maxy = MAX2((int)viewport->y, (int)(viewport->y + viewport->height));
+   int minx, miny, maxx, maxy;
+   panvk_viewport_scissor_box(vp, 0, &minx, &miny, &maxx, &maxy);
+
+   if (panvk_multi_viewport_draw(cmdbuf)) {
+      for (unsigned i = 1; i < vp->viewport_count; i++) {
+         int x0, y0, x1, y1;
+         panvk_viewport_scissor_box(vp, i, &x0, &y0, &x1, &y1);
+         if (x1 <= x0 || y1 <= y0)
+            continue;
+         if (maxx <= minx || maxy <= miny) {
+            minx = x0, miny = y0, maxx = x1, maxy = y1;
+         } else {
+            minx = MIN2(minx, x0);
+            miny = MIN2(miny, y0);
+            maxx = MAX2(maxx, x1);
+            maxy = MAX2(maxy, y1);
+         }
 
-   assert(scissor->offset.x >= 0 && scissor->offset.y >= 0);
-   minx = MAX2(scissor->offset.x, minx);
-   miny = MAX2(scissor->offset.y, miny);
-   maxx = MIN2(scissor->offset.x + scissor->extent.width, maxx);
-   maxy = MIN2(scissor->offset.y + scissor->extent.height, maxy);
+         float z0, z1;
+         panvk_viewport_depth_range_i(cmdbuf, i, &z0, &z1);
+         minz = MIN2(minz, z0);
+         maxz = MAX2(maxz, z1);
+      }
+   }
 
    /* Make sure we don't end up with a max < min when width/height is 0 */
    maxx = maxx > minx ? maxx - 1 : maxx;
@@ -1058,6 +1127,8 @@ panvk_draw_prepare_viewport(struct panvk_cmd_buffer *cmdbuf,
    if (!cmdbuf->state.gfx.vpd || dyn_gfx_state_dirty(cmdbuf, VP_VIEWPORTS) ||
        dyn_gfx_state_dirty(cmdbuf, VP_DEPTH_CLIP_NEGATIVE_ONE_TO_ONE) ||
        dyn_gfx_state_dirty(cmdbuf, VP_SCISSORS) ||
+       /* The union of the viewports while a GS selects one (017). */
+       gfx_state_dirty(cmdbuf, GS) ||
        dyn_gfx_state_dirty(cmdbuf, RS_DEPTH_CLIP_ENABLE) ||
        dyn_gfx_state_dirty(cmdbuf, RS_DEPTH_CLAMP_ENABLE) ||
        dyn_gfx_state_dirty(cmdbuf, VP_DEPTH_CLAMP_RANGE)) {
@@ -1872,17 +1943,42 @@ emit_gs_job(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw,
    if (!in_prims)
       return dep_job_id;
 
-   /* gl_ViewportIndex: one viewport only (no multiViewport), so every
-    * entry of the table is viewport 0.
+   /* gl_ViewportIndex (jm-v7 017): each viewport's transform and scissor
+    * box. An index past viewportCount (undefined) uses the last viewport.
     */
    uint64_t viewports = 0;
    if (gs->gs.writes_viewport) {
+      const struct vk_viewport_state *vps =
+         &cmdbuf->vk.dynamic_graphics_state.vp;
       struct pan_ptr vp = panvk_cmd_alloc_dev_mem(
-         cmdbuf, desc, PANVK_GS_MAX_VIEWPORTS * 24, 4);
+         cmdbuf, desc, PANVK_GS_MAX_VIEWPORTS * PANVK_GS_VIEWPORT_STRIDE, 4);
       if (!vp.gpu)
          return 0;
-      for (unsigned i = 0; i < PANVK_GS_MAX_VIEWPORTS; i++)
-         memcpy((uint8_t *)vp.cpu + i * 24, &gfx_sysvals->viewport, 24);
+      for (unsigned i = 0; i < PANVK_GS_MAX_VIEWPORTS; i++) {
+         float *e = (float *)((uint8_t *)vp.cpu + i * PANVK_GS_VIEWPORT_STRIDE);
+         const unsigned v = MIN2(i, MAX2(vps->viewport_count, 1) - 1);
+         if (v == 0) {
+            memcpy(e, &gfx_sysvals->viewport, 24);
+         } else {
+            const VkViewport *w = &vps->viewports[v];
+            float z_scale, z_offset;
+            panvk_viewport_z_coeffs(vps, &cmdbuf->vk.dynamic_graphics_state.rs,
+                                    v, &z_scale, &z_offset);
+            e[0] = 0.5f * w->width;
+            e[1] = 0.5f * w->height;
+            e[2] = z_scale;
+            e[3] = 0.5f * w->width + w->x;
+            e[4] = 0.5f * w->height + w->y;
+            e[5] = z_offset;
+         }
+         int x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+         if (vps->viewport_count)
+            panvk_viewport_scissor_box(vps, v, &x0, &y0, &x1, &y1);
+         e[6] = x0;
+         e[7] = y0;
+         e[8] = MAX2(x1, x0);
+         e[9] = MAX2(y1, y0);
+      }
       viewports = vp.gpu;
    }
 
diff --git a/src/panfrost/vulkan/panvk_gs.h b/src/panfrost/vulkan/panvk_gs.h
index 9bb477b..577788b 100644
--- a/src/panfrost/vulkan/panvk_gs.h
+++ b/src/panfrost/vulkan/panvk_gs.h
@@ -120,8 +120,9 @@ struct panvk_gs_push {
     * for the tiler): the emulation undoes the viewport transform.
     */
    uint32_t in_screen_space;
-   /* A shader writing gl_ViewportIndex: PANVK_GS_MAX_VIEWPORTS x
-    * {scale xyz, offset xyz}. 0 otherwise.
+   /* A shader writing gl_ViewportIndex: PANVK_GS_MAX_VIEWPORTS entries of
+    * PANVK_GS_VIEWPORT_STRIDE bytes, {scale xyz, offset xyz, scissor
+    * min x, min y, max x, max y (floats, max exclusive)}. 0 otherwise.
     */
    uint64_t viewports;
    /* Tessellation: the draw's struct poly_tess_params. */
@@ -160,6 +161,7 @@ struct panvk_gs_push {
  */
 #define PANVK_GS_VIEWPORT_INDEX_SLOT VARYING_SLOT_CLIP_VERTEX
 #define PANVK_GS_MAX_VIEWPORTS       16
+#define PANVK_GS_VIEWPORT_STRIDE     40
 
 #define PANVK_GS_CULL_FRONT (1u << 0)
 #define PANVK_GS_CULL_BACK  (1u << 1)
@@ -248,6 +250,12 @@ struct panvk_gs_lower_options {
    const struct nir_xfb_info *xfb;
    /* The vertex streams the shader emits on. */
    unsigned stream_mask;
+
+   /* multiViewport: with gl_ViewportIndex written, the output slot that
+    * gets the selected viewport's scissor edge distances (times clip w, so
+    * that perspective interpolation keeps their sign), 0 for none.
+    */
+   unsigned scissor_slot;
 };
 
 bool panvk_nir_lower_gs(struct nir_shader *nir,
diff --git a/src/panfrost/vulkan/panvk_nir_lower_gs.c b/src/panfrost/vulkan/panvk_nir_lower_gs.c
index ca128bc..4d2db6d 100644
--- a/src/panfrost/vulkan/panvk_nir_lower_gs.c
+++ b/src/panfrost/vulkan/panvk_nir_lower_gs.c
@@ -633,12 +633,40 @@ lower_emit_vertex(nir_builder *b, nir_intrinsic_instr *intr,
                nir_def *idx =
                   nir_umin(b, nir_load_var(b, st->viewport_var),
                            nir_imm_int(b, PANVK_GS_MAX_VIEWPORTS - 1));
-               nir_def *xf = nir_iadd(b, st->viewports,
-                                      nir_u2u64(b, nir_imul_imm(b, idx, 24)));
+               nir_def *xf = nir_iadd(
+                  b, st->viewports,
+                  nir_u2u64(b, nir_imul_imm(b, idx, PANVK_GS_VIEWPORT_STRIDE)));
                nir_def *scale = load_components(b, xf, nir_imm_int(b, 0), 3, 32);
                nir_def *offset =
                   load_components(b, xf, nir_imm_int(b, 12), 3, 32);
                val = clip_to_screen_xf(b, clip, scale, offset);
+
+               /* multiViewport (jm-v7 017): the tiler only has one scissor
+                * box (the union), so the selected viewport's scissor is a
+                * clip-distance kill in the FS. d >= 0 inside; times clip w
+                * so that perspective interpolation keeps the sign.
+                */
+               if (opts->scissor_slot) {
+                  nir_def *sc = load_components(b, xf, nir_imm_int(b, 24), 4, 32);
+                  nir_def *sx = nir_channel(b, val, 0);
+                  nir_def *sy = nir_channel(b, val, 1);
+                  nir_def *w = nir_channel(b, clip, 3);
+                  nir_def *d = nir_vec4(
+                     b, nir_fsub(b, sx, nir_channel(b, sc, 0)),
+                     nir_fsub(b, nir_channel(b, sc, 2), sx),
+                     nir_fsub(b, sy, nir_channel(b, sc, 1)),
+                     nir_fsub(b, nir_channel(b, sc, 3), sy));
+                  d = nir_fmul(b, d, nir_replicate(b, w, 4));
+                  nir_def *soff =
+                     load_slot_offset(b, st->out_offsets, opts->scissor_slot);
+                  nir_push_if(b, nir_ine_imm(b, soff, PANVK_GS_SLOT_UNUSED));
+                  store_components(
+                     b, st->out_general,
+                     nir_iadd(b, nir_imul(b, slot, st->out_general_stride),
+                              soff),
+                     d);
+                  nir_pop_if(b, NULL);
+               }
             } else {
                val = clip_to_screen(b, st, clip);
             }
diff --git a/src/panfrost/vulkan/panvk_shader.h b/src/panfrost/vulkan/panvk_shader.h
index 4da02b9..ff273c1 100644
--- a/src/panfrost/vulkan/panvk_shader.h
+++ b/src/panfrost/vulkan/panvk_shader.h
@@ -464,6 +464,11 @@ struct panvk_shader_variant {
       enum mesa_prim output_prim;
       /* Writes gl_ViewportIndex. */
       bool writes_viewport;
+      /* multiViewport (jm-v7 017): the generic slot the emulation writes the
+       * four scissor edge distances of the selected viewport to, for the
+       * FS clip-distance kill. 0 when none.
+       */
+      uint8_t scissor_slot;
       /* Transform feedback, see panvk_gs_xfb_table(): the staging record
        * size in dwords (0 = captures nothing), each xfb buffer's stride in
        * bytes (0 = not captured to), and where every record dword goes.
diff --git a/src/panfrost/vulkan/panvk_vX_physical_device.c b/src/panfrost/vulkan/panvk_vX_physical_device.c
index 8da6f41..3c95160 100644
--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -338,7 +338,9 @@ panvk_per_arch(get_physical_device_features)(
       .wideLines = true,
       .largePoints = true,
       .alphaToOne = PAN_ARCH >= 10,
-      .multiViewport = PAN_ARCH >= 9,
+      /* v6/v7: a geometry shader selects the viewport in the emulation
+       * (jm-v7 017). */
+      .multiViewport = true,
       .samplerAnisotropy = true,
       .textureCompressionETC2 = has_texture_compression_etc2(device),
       .textureCompressionASTC_LDR = has_texture_compression_astc_ldr(device),
@@ -1019,7 +1021,7 @@ panvk_per_arch(get_physical_device_properties)(
       .maxDrawIndirectCount = PAN_ARCH >= 10 ? UINT32_MAX : UINT16_MAX,
       .maxSamplerLodBias = (float)INT16_MAX / 256.0f,
       .maxSamplerAnisotropy = 16,
-      .maxViewports = PAN_ARCH >= 9 ? 16 : 1,
+      .maxViewports = 16,
       .maxViewportDimensions = {MAX_FRAMEBUFFER_DIMENSION, MAX_FRAMEBUFFER_DIMENSION},
       .viewportBoundsRange = {-2.0f * MAX_FRAMEBUFFER_DIMENSION, 2.0f * MAX_FRAMEBUFFER_DIMENSION - 1.0f},
       .viewportSubPixelBits = 0,
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index b6f0a39..3bdd1c9 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -4274,6 +4274,19 @@ panvk_compile_shader(struct panvk_device *dev,
          variant->gs.outputs_written |=
             BITFIELD64_BIT(PANVK_GS_VIEWPORT_INDEX_SLOT);
 
+      /* multiViewport (jm-v7 017): the selected viewport's scissor goes to
+       * the FS as four clip distances in CLIP_DIST1, which an FS compiled
+       * without the previous stage's layout always tests. The emulation
+       * does not carry the GS's own (compact) clip distances, so the slot
+       * is free unless a non-compact output sits there.
+       */
+      variant->gs.scissor_slot = 0;
+      if (variant->gs.writes_viewport && dev->vk.enabled_features.multiViewport &&
+          !(variant->gs.outputs_written & VARYING_BIT_CLIP_DIST1)) {
+         variant->gs.scissor_slot = VARYING_SLOT_CLIP_DIST1;
+         variant->gs.outputs_written |= VARYING_BIT_CLIP_DIST1;
+      }
+
       const int xfb_dwords =
          panvk_gs_xfb_table(nir->xfb_info, variant->gs.xfb_table);
       if (xfb_dwords < 0) {
@@ -4319,6 +4332,7 @@ panvk_compile_shader(struct panvk_device *dev,
          .pos_stride = sizeof(uint32_t) * 4,
          .params_base = SYSVALS_PUSH_CONST_BASE +
                         offsetof(struct panvk_compute_sysvals, gs),
+         .scissor_slot = variant->gs.scissor_slot,
       };
 
       if (!panvk_nir_lower_gs(nir, &gs_opts)) {
@@ -5966,6 +5980,16 @@ panvk_fs_cull_value(nir_builder *b, UNUSED nir_shader *nir,
 UNUSED static uint64_t
 panvk_fs_dist_defaults(UNUSED nir_shader *nir)
 {
+#if PAN_ARCH < 9
+   /* gl_ViewportIndex comes from the geometry emulation's copy
+    * (jm-v7 017). Without a GS writing it the slot reads constant 0, the
+    * value for an unwritten index.
+    */
+   nir_foreach_shader_in_variable(var, nir) {
+      if (var->data.location == VARYING_SLOT_VIEWPORT)
+         var->data.location = PANVK_GS_VIEWPORT_INDEX_SLOT;
+   }
+#endif
    return PANVK_FS_CULL_BITS;
 }
 
