---
 src/panfrost/vulkan/panvk_cmd_meta.h    |  3 +++
 src/panfrost/vulkan/panvk_vX_cmd_meta.c | 10 ++++++++++
 2 files changed, 13 insertions(+)

diff --git a/src/panfrost/vulkan/panvk_cmd_meta.h b/src/panfrost/vulkan/panvk_cmd_meta.h
index 6d5f698..2eed362 100644
--- a/src/panfrost/vulkan/panvk_cmd_meta.h
+++ b/src/panfrost/vulkan/panvk_cmd_meta.h
@@ -64,6 +64,9 @@ struct panvk_cmd_meta_graphics_save_ctx {
 
 #if PAN_ARCH >= 9
    const struct panvk_shader *gs, *tcs, *tes;
+#else
+   /* The emulated geometry shader (jm-v7 007): meta pipelines bind none. */
+   const struct panvk_shader *gs;
 #endif
 
    struct panvk_occlusion_query_state occlusion_query;
diff --git a/src/panfrost/vulkan/panvk_vX_cmd_meta.c b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
index bb299e0..d3dd0a4 100644
--- a/src/panfrost/vulkan/panvk_vX_cmd_meta.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
@@ -190,6 +190,13 @@ meta_gfx_start(struct panvk_cmd_buffer *cmdbuf,
    cmdbuf->state.gfx.gs.shader = NULL;
    cmdbuf->state.gfx.tcs.shader = NULL;
    cmdbuf->state.gfx.tes.shader = NULL;
+#else
+   /* Binding the meta pipeline clears the geometry shader, and nothing
+    * would bind the application's one again after the meta operation.
+    */
+   save_ctx->gs = cmdbuf->state.gfx.gs.shader;
+   cmdbuf->state.gfx.gs.shader = NULL;
+   gfx_state_set_dirty(cmdbuf, GS);
 #endif
 
    save_ctx->dyn_state.all = cmdbuf->vk.dynamic_graphics_state;
@@ -261,6 +268,9 @@ meta_gfx_end(struct panvk_cmd_buffer *cmdbuf,
    cmdbuf->state.gfx.gs.shader = save_ctx->gs;
    cmdbuf->state.gfx.tcs.shader = save_ctx->tcs;
    cmdbuf->state.gfx.tes.shader = save_ctx->tes;
+#else
+   cmdbuf->state.gfx.gs.shader = save_ctx->gs;
+   gfx_state_set_dirty(cmdbuf, GS);
 #endif
 
 #if PAN_ARCH < 9
