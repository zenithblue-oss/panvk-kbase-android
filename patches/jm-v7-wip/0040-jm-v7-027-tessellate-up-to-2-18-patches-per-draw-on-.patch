From cf32bdc86872251b57f389701eeb31afac1f0d44 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 14:05:09 +0000
Subject: [PATCH 26/26] jm-v7 027: tessellate up to 2^18 patches per draw on
 v6/v7

PANVK_TESS_MAX_PATCHES was 8192, the limit of the serial
panlib_v7_tess_prefix(): a bigger draw kept the first 8192 patches (whole
instances), so PanProbe large_draw tess_direct/indirect (70000 isoline
patches) captured 16384 points, tess_tri_* (70000 triangles) 8192, and
tess_instanced (9000 instances) 8192*2 ("tessellated draw of 70000
patches, only 8192 are drawn").

The prefix sum now runs on one workgroup of 256 invocations (run sums, a
workgroup scan, then each run writes its prefix and finds its first patch
past the budget; sums saturate), and the cap is 1 << 18, still bounded by
the tess arena per tess control output size. A draw the CPU knows sizes
the tessellator grid for its own patches instead of max_patches.
---
 src/panfrost/libpan/draw_helper.cl         | 79 +++++++++++++++++++---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c |  9 ++-
 src/panfrost/vulkan/panvk_gs.h             |  9 ++-
 3 files changed, 84 insertions(+), 13 deletions(-)

diff --git a/src/panfrost/libpan/draw_helper.cl b/src/panfrost/libpan/draw_helper.cl
index 09c8ffb..7581be2 100644
--- a/src/panfrost/libpan/draw_helper.cl
+++ b/src/panfrost/libpan/draw_helper.cl
@@ -1747,12 +1747,29 @@ panlib_v7_tessellate(constant struct poly_tess_params *p, uint32_t domain__3,
  * while their indices fit max_indices and, with varying_info, the indirect
  * varying buffer the tess eval draw allocates from. The tessellator then
  * writes the kept patches only, and the tess eval draw covers them.
- * ponytail: serial, a draw holds at most PANVK_TESS_MAX_PATCHES patches.
+ *
+ * jm-v7 027: one workgroup of TESS_PREFIX_WG invocations (it was serial, for
+ * at most 8192 patches): each invocation sums a run of patches, a workgroup
+ * scan gives each run its start, then each run writes its prefix and finds
+ * the first patch past the budget. Sums saturate at UINT32_MAX, the budget
+ * is far below it.
  */
-KERNEL(1)
+#define TESS_PREFIX_WG 256
+
+static inline uint32_t
+tess_sat_add(uint32_t a, uint32_t b)
+{
+   return b > UINT32_MAX - a ? UINT32_MAX : a + b;
+}
+
+KERNEL(TESS_PREFIX_WG)
 panlib_v7_tess_prefix(global struct panlib_v7_tess *t)
 {
+   local uint32_t scan[TESS_PREFIX_WG];
+   local uint32_t cut[TESS_PREFIX_WG];
+   local uint32_t cut_sum[TESS_PREFIX_WG];
    global struct poly_tess_params *p = &t->p;
+   const uint32_t tid = cl_local_id.x;
    uint32_t budget = t->max_indices;
 
    if (t->varying_info && t->varying_bytes) {
@@ -1766,17 +1783,61 @@ panlib_v7_tess_prefix(global struct panlib_v7_tess *t)
       budget = min(budget, left / t->varying_bytes);
    }
 
-   uint32_t sum = 0, n = 0;
-   for (; n < p->nr_patches; n++) {
-      uint32_t c = p->counts[n];
-      if (c > budget - sum)
+   const uint32_t nr = p->nr_patches;
+   const uint32_t seg = (nr + TESS_PREFIX_WG - 1) / TESS_PREFIX_WG;
+   const uint32_t b = min(tid * seg, nr), e = min(b + seg, nr);
+
+   uint32_t own = 0;
+   for (uint32_t i = b; i < e; i++)
+      own = tess_sat_add(own, p->counts[i]);
+
+   /* Inclusive scan of the run sums. */
+   scan[tid] = own;
+   barrier(CLK_LOCAL_MEM_FENCE);
+   for (uint32_t o = 1; o < TESS_PREFIX_WG; o <<= 1) {
+      uint32_t v = tid >= o ? scan[tid - o] : 0;
+      barrier(CLK_LOCAL_MEM_FENCE);
+      scan[tid] = tess_sat_add(scan[tid], v);
+      barrier(CLK_LOCAL_MEM_FENCE);
+   }
+   const uint32_t total = scan[TESS_PREFIX_WG - 1];
+
+   /* The run's prefix, up to its first patch that does not fit. */
+   uint32_t sum = scan[tid] - own, my_cut = UINT32_MAX;
+   if (own == UINT32_MAX || scan[tid] == UINT32_MAX) {
+      /* Saturated: recount the start from the runs before. */
+      sum = 0;
+      for (uint32_t r = 0; r < tid; r++) {
+         uint32_t rb = min(r * seg, nr), re = min(rb + seg, nr);
+         for (uint32_t i = rb; i < re && sum <= budget; i++)
+            sum = tess_sat_add(sum, p->counts[i]);
+      }
+   }
+   for (uint32_t i = b; i < e; i++) {
+      uint32_t c = p->counts[i];
+      if (sum > budget || c > budget - sum) {
+         my_cut = i;
          break;
+      }
       sum += c;
-      p->counts[n] = sum;
+      p->counts[i] = sum;
    }
+   cut[tid] = my_cut;
+   cut_sum[tid] = sum;
+   barrier(CLK_LOCAL_MEM_FENCE);
 
-   p->nr_patches = n;
-   t->draw[0] = sum;
+   if (tid == 0) {
+      uint32_t n = nr, kept = total;
+      for (uint32_t r = 0; r < TESS_PREFIX_WG; r++) {
+         if (cut[r] != UINT32_MAX) {
+            n = cut[r];
+            kept = cut_sum[r];
+            break;
+         }
+      }
+      p->nr_patches = n;
+      t->draw[0] = kept;
+   }
 }
 
 /* Pipeline statistics on v6/v7 (jm-v7 016). The report of a query holds two
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 16d45e1..69f42de 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -3480,8 +3480,15 @@ panvk_tess_draw(struct panvk_cmd_buffer *cmdbuf,
 
    /* 2. The tessellator. */
    struct panvk_precomp_ctx precomp_ctx = panvk_per_arch(precomp_cs)(cmdbuf);
+   /* jm-v7 027: a draw the CPU knows takes a grid for its own patches, not
+    * for max_patches (now up to PANVK_TESS_MAX_PATCHES).
+    */
+   const uint64_t grid_patches =
+      cpu_known ? MIN2((uint64_t)(cpu_vertices / ps) * cpu_instances,
+                       max_patches)
+                : max_patches;
    const struct panlib_precomp_grid tess_grid =
-      panlib_1d(DIV_ROUND_UP(max_patches, 64));
+      panlib_1d(MAX2(DIV_ROUND_UP(grid_patches, 64), 1));
    panlib_v7_tessellate(&precomp_ctx, tess_grid, PANLIB_BARRIER_JM_BARRIER,
                         TD(p), domain, POLY_TESS_MODE_COUNT);
    panlib_v7_tess_prefix(&precomp_ctx, panlib_1d(1), PANLIB_BARRIER_JM_BARRIER,
diff --git a/src/panfrost/vulkan/panvk_gs.h b/src/panfrost/vulkan/panvk_gs.h
index 4a0ddb2..8f9afa3 100644
--- a/src/panfrost/vulkan/panvk_gs.h
+++ b/src/panfrost/vulkan/panvk_gs.h
@@ -314,10 +314,13 @@ bool panvk_nir_lower_gs(struct nir_shader *nir,
  * dropped (panlib_v7_tess_prefix).
  */
 #define PANVK_TESS_MAX_INDICES (1u << 23)
-/* Patches one draw tessellates, at most: the tessellator grid and the serial
- * prefix sum are sized for it.
+/* Patches one draw tessellates, at most: the tess arena and an indirect
+ * draw's tessellator grid are sized for it. jm-v7 027: was 8192, the limit
+ * of the serial prefix sum; the workgroup prefix sum takes many more, and
+ * the arena (PANVK_TESS_HEAP_SIZE) bounds it further per tess control
+ * output size.
  */
-#define PANVK_TESS_MAX_PATCHES 8192u
+#define PANVK_TESS_MAX_PATCHES (1u << 18)
 /* With a geometry shader or transform feedback after the tess eval shader,
  * the geometry emulation of the generated draw is sized for this many input
  * primitives (instead of PANVK_GS_INDIRECT_MAX_PRIMS).
-- 
2.55.0

