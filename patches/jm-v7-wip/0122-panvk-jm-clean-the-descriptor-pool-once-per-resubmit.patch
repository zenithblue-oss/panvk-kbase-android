From b9282b8bbc37b5f0face202c64585c2ec5d339bb Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Mon, 26 Oct 2026 02:19:13 +0000
Subject: [PATCH 2/7] panvk/jm: clean the descriptor pool once per resubmitted
 command buffer

Rationale: perf review 2026-10-26, finding D5. gpu_queue_submit() resets
every issued batch of a resubmitted command buffer before any of them runs
(the conditional rendering rule of jm-v9 030), and each
panvk_reset_issued_batch() ended with panvk_pool_flush_maps() of the whole
descriptor pool: batches x pool bytes of DC CVAC per submit, all before the
first atom while the GPU idles. PanProbe tess_perf has 256 batches per frame
on v6/v7 (D1), so its fence-timed resubmits cleaned the pool 256 times per
frame (estimated 10-50 ms of a 120-150 ms L=1 frame), which also biases
every other measurement that resubmits a recorded command buffer.

Every write of the reset (job headers, MALLOC_VERTEX vertex arrays on v9,
tiler heap and context descriptors, indirect varying allocators) is in the
descriptor pool, and DC CVAC only writes back dirty lines, so the pool is
now cleaned once after the last reset, still before the first submit. The
memory the GPU sees is the same, and the ordering (all resets, then all
submits) is unchanged. The reset inside panvk_queue_submit_batch() (not
reached after the loop) keeps its own flush.

Not done: flushing only the rewritten ranges. That needs a CPU-address
flush that the kernel cache-sync path (PANVK_KBASE_USER_CACHE_SYNC=0)
does not have, for little more than "once" saves.

Knob: PANVK_JM_RESET_FLUSH=batch (or =0) cleans per batch (114). Read once
per VkDevice into panvk_device::jm_opt. Arch: v6/v7/v9 (JM). Only command
buffers submitted more than once are affected (DXVK and vkd3d re-record).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 30 ++++++++++++++++-----
 src/panfrost/vulkan/panvk_device.h          |  3 +++
 src/panfrost/vulkan/panvk_vX_device.c       |  4 +++
 3 files changed, 30 insertions(+), 7 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 910301a2..c9155de6 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -107,10 +107,12 @@ batch_has_timestamps(const struct panvk_batch *batch)
    return batch->timestamps || batch->after_frag;
 }
 
-/* Reset a batch that has already been issued. */
+/* Reset a batch that has already been issued. flush = clean the descriptor
+ * pool after it; a caller that resets several batches can pass false and
+ * flush once after the last one. */
 static void
 panvk_reset_issued_batch(struct panvk_cmd_buffer *cmdbuf,
-                         struct panvk_batch *batch)
+                         struct panvk_batch *batch, bool flush)
 {
    {
       util_dynarray_foreach(&batch->jobs, void *, job)
@@ -148,7 +150,8 @@ panvk_reset_issued_batch(struct panvk_cmd_buffer *cmdbuf,
 
       /* We don't keep track of BO <-> job relationship, so let's just flush the
        * whole desc pool for now. */
-      panvk_pool_flush_maps(&cmdbuf->desc_pool);
+      if (flush)
+         panvk_pool_flush_maps(&cmdbuf->desc_pool);
    }
 
    batch->issued = false;
@@ -168,7 +171,7 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
 
    /* Reset the batch if it's already been issued */
    if (batch->issued)
-      panvk_reset_issued_batch(cmdbuf, batch);
+      panvk_reset_issued_batch(cmdbuf, batch, true);
 
    /* Flush pending synchronization requests before submitting the job, to
     * make sure things are GPU-visible. */
@@ -465,11 +468,24 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
       /* A conditional rendering predicate job rewrites job headers of the
        * later batches of its draw (cmd_cond_render_end()). Reset (CPU write
        * plus cache flush) every batch before any of them runs, so that no
-       * flush lands after a predicate job wrote a header. */
+       * flush lands after a predicate job wrote a header.
+       *
+       * Every reset write is in the descriptor pool, which the old code
+       * cleaned whole once per batch (256 times per PanProbe tess_perf frame
+       * on v6/v7). DC CVAC only writes back dirty lines, so one clean after
+       * the last reset, still before the first submit, leaves memory in the
+       * same state. PANVK_JM_RESET_FLUSH=batch (or 0) = once per batch.
+       */
+      const bool flush_once = dev->jm_opt.reset_flush_once;
+      bool reset_any = false;
       list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
-         if (batch->issued)
-            panvk_reset_issued_batch(cmdbuf, batch);
+         if (batch->issued) {
+            panvk_reset_issued_batch(cmdbuf, batch, !flush_once);
+            reset_any = true;
+         }
       }
+      if (reset_any && flush_once)
+         panvk_pool_flush_maps(&cmdbuf->desc_pool);
 #endif
 
       list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index 5b3bb37b..3de854bc 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -90,6 +90,9 @@ struct panvk_device {
       /* PANVK_V7_FS_COPY_ONCE (default 1): v6/v7 FS descriptor copy job
        * only when the FS tables change, none per tiler job. */
       bool fs_copy_once;
+      /* PANVK_JM_RESET_FLUSH (default once, batch/0 = old): a resubmitted
+       * command buffer cleans its descriptor pool once, not per batch. */
+      bool reset_flush_once;
    } jm_opt;
    struct panvk_priv_bo *sample_positions;
 
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index 59877e2e..6f5cc59e 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -895,6 +895,10 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
 #if PAN_ARCH <= 9
    device->jm_opt.fs_copy_once =
       debug_get_bool_option("PANVK_V7_FS_COPY_ONCE", true);
+   const char *reset_flush = os_get_option("PANVK_JM_RESET_FLUSH");
+   device->jm_opt.reset_flush_once =
+      !reset_flush ||
+      (strcmp(reset_flush, "batch") && strcmp(reset_flush, "0"));
 #endif
 
 #if PAN_ARCH >= 9
-- 
