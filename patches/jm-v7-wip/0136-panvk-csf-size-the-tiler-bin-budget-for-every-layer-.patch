From 2c4a4b2abd9e0ec95d96f7fdf31b6f8c4e6c6f72 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Wed, 28 Oct 2026 08:23:34 +0000
Subject: [PATCH 136/139] panvk/csf: size the tiler bin budget for every layer
 of a tiler context

The hierarchy mask is chosen so that the bin pointers of one layer
(pan_calc_bins_pointer_size()) fit in a tiler heap chunk. The tiler
takes the bins of every layer of a tiler context (up to
MAX_LAYERS_PER_TILER_DESC = 8 before v14) from one chunk, and on
v10/v11 it needs twice pan_calc_bins_pointer_size() per layer.

vkd3d-proton renders without attachments (UAV-only draws: the D3D12
FL 11_1 target-independent rasterization check, the FL 12_1
conservative rasterization check) at maxFramebufferWidth x
maxFramebufferHeight with maxFramebufferLayers layers: 32768x32768 on
v10, 65536x65536 on v11, 256 layers, so 32 tiler contexts of 8 layers.
The one-layer budget keeps mask 0x1fe0 there (171 KiB of bins per
layer). The tiler then OOMs on every new chunk until the heap is full,
kbase cannot handle the next OOM (no CSI exception handler) and
terminates the group: "CSF group 3 tiler heap OOM notification", the
queue timeout and VK_ERROR_DEVICE_LOST (FTL Pixel 7 and Pixel 8).

Measured on the Pixel 8 (Mali-G715) with a chunk size override:
mask 0x1fe0 OOMs with 1 and 2 MiB chunks and passes with 4 and 8 MiB;
mask 0x1fc0 (43 KiB per layer) passes with 1 MiB and OOMs with
512 KiB. 2 x 8 x 171 KiB = 2.7 MiB and 2 x 8 x 43 KiB = 683 KiB fit
both results, 8 x 171 KiB = 1.4 MiB does not.

Divide the budget by twice the layer count of a tiler context on
v10/v11 (by the layer count on v12+, not measured), so the finest
hierarchy levels are dropped only when the bins of all its layers would
not fit. One- and two-layer passes keep their mask (171 KiB at most per
layer with 8 levels), ordinary layered passes too (1080p, 6 layers:
2 x 6 x 21 KiB). PANVK_TILER_LAYER_BUDGET=0 restores the one-layer
budget (115b).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index d40eaf36..8a0303e7 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -1405,6 +1405,8 @@ account_tiler_work(struct panvk_cmd_buffer *cmdbuf, uint64_t work)
       cmdbuf->state.tiler_work_estimate += work;
 }
 
+DEBUG_GET_ONCE_BOOL_OPTION(tiler_layer_budget, "PANVK_TILER_LAYER_BUDGET", true)
+
 static VkResult
 get_tiler_desc(struct panvk_cmd_buffer *cmdbuf)
 {
@@ -1446,9 +1448,21 @@ get_tiler_desc(struct panvk_cmd_buffer *cmdbuf)
       ASSERTED unsigned max_levels = tiler_features.max_levels;
       assert(max_levels >= 2);
 
-      /* The tiler chunk start with a header of 64 bytes */
+      /* The bins of every layer of a tiler context come from one heap
+       * chunk (after its 64-byte header), and v10/v11 need twice
+       * pan_calc_bins_pointer_size() per layer. Measured on Mali-G715 with
+       * the vkd3d-proton pass without attachments (65536x65536, 256
+       * layers, 8 per context): mask 0x1fe0 (171 KiB per layer) OOMs with
+       * 1 and 2 MiB chunks, not with 4 MiB; mask 0x1fc0 (43 KiB) OOMs with
+       * 512 KiB chunks, not with 1 MiB. kbase terminates the group on that
+       * OOM. PANVK_TILER_LAYER_BUDGET=0 = 115b (budget of one layer). */
+      uint32_t bin_budget = phys_dev->csf.tiler.chunk_size - 64;
+      if (debug_get_option_tiler_layer_budget())
+         bin_budget /= (PAN_ARCH < 12 ? 2 : 1) *
+                       CLAMP(cmdbuf->state.gfx.render.layer_count, 1,
+                             MAX_LAYERS_PER_TILER_DESC);
       cfg.hierarchy_mask = panvk_select_tiler_hierarchy_mask(
-         phys_dev, &cmdbuf->state.gfx, phys_dev->csf.tiler.chunk_size - 64);
+         phys_dev, &cmdbuf->state.gfx, bin_budget);
       cfg.fb_width = fb->width_px;
       cfg.fb_height = fb->height_px;
 
-- 
