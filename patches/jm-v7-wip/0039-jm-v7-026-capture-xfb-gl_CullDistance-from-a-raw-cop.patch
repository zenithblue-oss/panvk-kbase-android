From 7fbda324fa12c57ac270c6740e66574d9b40817e Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 14:01:21 +0000
Subject: [PATCH 25/26] jm-v7 026: capture xfb gl_CullDistance from a raw copy
 on v6/v7

On v6/v7 the vertex shader's CULL_DIST0/1 stores are rewritten into the
FS kill flags (panvk_lower_cull_dist_flags_intr(): 1.0 for a negative
distance, else 0.0), so the xfb passthrough that captured cull from
CULL_DIST0 (jm-v7 023) got 1,1,0,0 instead of -1.5,-0.5,0.5,1.5
(PanProbe xfb vs_clip_cull_capture mismatch=4, one per vertex).

A VS or TES whose transform feedback captures a cull component now also
writes the raw distances to VARYING_SLOT_TEX0/1 (PANVK_XFB_RAW_CULL_SLOT0/1,
generic, never passed to the FS by the emulation), and the passthrough
captures them from there.
---
 src/panfrost/vulkan/panvk_gs.h        |  9 +++++
 src/panfrost/vulkan/panvk_vX_shader.c | 52 +++++++++++++++++++++++++--
 2 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_gs.h b/src/panfrost/vulkan/panvk_gs.h
index 5d1b0e6..4a0ddb2 100644
--- a/src/panfrost/vulkan/panvk_gs.h
+++ b/src/panfrost/vulkan/panvk_gs.h
@@ -187,6 +187,15 @@ struct panvk_gs_push {
  * slot Vulkan never uses and pan lays out as generic.
  */
 #define PANVK_GS_VIEWPORT_INDEX_SLOT VARYING_SLOT_CLIP_VERTEX
+/* jm-v7 026: on v6/v7 a vertex shader's CULL_DIST0/1 hold the "cull < 0"
+ * flags the FS kill interpolates (panvk_lower_cull_dist_flags_intr()), not
+ * the distances. A VS or TES whose transform feedback captures
+ * gl_CullDistance also writes the raw distances to these two slots (unused
+ * by Vulkan, generic to pan, not passed on to the FS by the emulation), and
+ * its passthrough captures them from there.
+ */
+#define PANVK_XFB_RAW_CULL_SLOT0     VARYING_SLOT_TEX0
+#define PANVK_XFB_RAW_CULL_SLOT1     VARYING_SLOT_TEX1
 #define PANVK_GS_MAX_VIEWPORTS       16
 #define PANVK_GS_VIEWPORT_STRIDE     40
 
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index 5829a18..2130dca 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -546,6 +546,31 @@ panvk_create_dist_var(nir_shader *nir, nir_variable_mode mode,
    return var;
 }
 
+#if PAN_ARCH < 9
+/* Whether a transform feedback capture takes a gl_CullDistance component:
+ * the xfb info sees the merged array (vk_spirv_to_nir() merges before
+ * gathering it), cull right after the nclip clip distances.
+ */
+static bool
+panvk_xfb_captures_cull(const nir_xfb_info *xfb, unsigned nclip)
+{
+   if (!xfb)
+      return false;
+
+   for (unsigned i = 0; i < xfb->output_count; i++) {
+      const nir_xfb_output_info *o = &xfb->outputs[i];
+      if (o->location != VARYING_SLOT_CLIP_DIST0 &&
+          o->location != VARYING_SLOT_CLIP_DIST1)
+         continue;
+      u_foreach_bit(c, o->component_mask) {
+         if ((o->location - VARYING_SLOT_CLIP_DIST0) * 4 + c >= nclip)
+            return true;
+      }
+   }
+   return false;
+}
+#endif
+
 static bool
 panvk_lower_clip_cull_vs(nir_shader *nir)
 {
@@ -597,6 +622,25 @@ panvk_lower_clip_cull_vs(nir_shader *nir)
                     nir_vec(&b, &cull_v[4], 4), 0xf);
    }
    panvk_store_cull_flags(&b, nir, cull, cull_v, ncull);
+#if PAN_ARCH < 9
+   /* jm-v7 026: CULL_DIST0/1 get the kill flags, keep the distances for a
+    * transform feedback capture (see PANVK_XFB_RAW_CULL_SLOT0).
+    */
+   if (ncull && panvk_xfb_captures_cull(nir->xfb_info, nclip)) {
+      nir_store_var(&b,
+                    panvk_create_dist_var(nir, nir_var_shader_out,
+                                          PANVK_XFB_RAW_CULL_SLOT0,
+                                          "xfb_cull0"),
+                    nir_vec(&b, &cull_v[0], 4), 0xf);
+      if (ncull > 4) {
+         nir_store_var(&b,
+                       panvk_create_dist_var(nir, nir_var_shader_out,
+                                             PANVK_XFB_RAW_CULL_SLOT1,
+                                             "xfb_cull1"),
+                       nir_vec(&b, &cull_v[4], 4), 0xf);
+      }
+   }
+#endif
    return nir_progress(true, nir_shader_get_entrypoint(nir),
                        nir_metadata_none);
 }
@@ -3598,8 +3642,10 @@ panvk_vs_store_xfb(struct panvk_shader_variant *variant,
 
       /* jm-v7 023: the xfb info sees the merged clip+cull array (the cull
        * distances right after the clip ones in CLIP_DIST0/1), the vertex
-       * shader writes them apart (panvk_lower_clip_cull_vs()): capture each
-       * cull component from CULL_DIST0/1.
+       * shader writes them apart (panvk_lower_clip_cull_vs()). jm-v7 026:
+       * CULL_DIST0/1 then hold the FS kill flags (1.0 for a negative
+       * distance), so capture each cull component from the raw copy in
+       * PANVK_XFB_RAW_CULL_SLOT0/1.
        */
       if (dist && ncull) {
          unsigned dw = o->offset / 4;
@@ -3607,7 +3653,7 @@ panvk_vs_store_xfb(struct panvk_shader_variant *variant,
             const unsigned idx = (o->location - VARYING_SLOT_CLIP_DIST0) * 4 + c;
             unsigned loc = o->location, comp = c;
             if (idx >= nclip) {
-               loc = VARYING_SLOT_CULL_DIST0 + (idx - nclip) / 4;
+               loc = PANVK_XFB_RAW_CULL_SLOT0 + (idx - nclip) / 4;
                comp = (idx - nclip) % 4;
             }
             assert(n < ARRAY_SIZE(variant->gs.xfb_outputs));
-- 
2.55.0

