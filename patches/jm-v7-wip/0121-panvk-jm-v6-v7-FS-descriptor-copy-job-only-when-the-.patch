From f6a42a19dbe72d7df2cbcf0604292bb6ce6ae3f4 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Mon, 26 Oct 2026 02:18:04 +0000
Subject: [PATCH 1/7] panvk/jm: v6/v7 FS descriptor copy job only when the FS
 tables change

Rationale: perf review 2026-10-26, finding D3. panvk_draw_prepare_tiler_job()
built an FS descriptor copy job (copy_info push uniforms, COMPUTE_JOB,
LOCAL_STORAGE, copy RSD lookup) for every layer of every draw that runs
the FS, and appended it to batch->jobs. It was never chained:
panvk_cmd_draw() and panvk_cmd_draw_indirect() add
draw->jobs.frag_copy_desc to the job chain before the layer loop that calls
prepare_draw_layer(), so the only FS copy job the GPU ever ran is the one
prepare_draw() builds when the FS tables are rebuilt (the review assumed
the opposite order). The dead job cost 1-3 us of CPU per draw and layer,
about 0.5 KiB of descriptor pool, a 16-byte header reset per job on every
resubmit, and more pool to clean (D5).

On a draw whose FS is not required (no FS bound: every DXVK depth-only or
shadow draw), `ptr` was read uninitialized (upstream code) and the stack
value appended to batch->jobs, where a resubmit memsets 16 bytes at it.

Now the per-layer job is not built and ptr starts zeroed. The job chain
the GPU runs is unchanged.

Knob: PANVK_V7_FS_COPY_ONCE=0 builds the per-layer job again (the 114
behaviour, without the uninitialized read). Read once per VkDevice into
panvk_device::jm_opt. Arch: v6/v7 (v9 has no descriptor copy jobs).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c | 42 +++++++++++++---------
 src/panfrost/vulkan/panvk_device.h         |  6 ++++
 src/panfrost/vulkan/panvk_vX_device.c      |  5 +++
 3 files changed, 37 insertions(+), 16 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 24e139c9..0d390cf6 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -1744,24 +1744,34 @@ panvk_draw_prepare_tiler_job(struct panvk_cmd_buffer *cmdbuf,
                              struct panvk_draw_data *draw)
 {
    struct panvk_batch *batch = cmdbuf->cur_batch;
-   struct pan_ptr ptr;
-
-   if (cmdbuf->state.gfx.fs.required) {
-      const struct panvk_shader_desc_info *fs_desc_info =
-         &cmdbuf->state.gfx.fs.shader->desc_info;
-      struct panvk_shader_desc_state *fs_desc_state =
-         &cmdbuf->state.gfx.fs.desc;
-      VkResult result = panvk_per_arch(meta_get_copy_desc_job)(
-         cmdbuf, fs_desc_info, &cmdbuf->state.gfx.desc_state,
-         fs_desc_state, 0, &ptr);
-      if (result != VK_SUCCESS)
-         return result;
-   }
+   struct pan_ptr ptr = {0};
+
+   /* The FS descriptor copy job that runs is the one prepare_draw() builds
+    * when the FS tables change: panvk_cmd_draw() and
+    * panvk_cmd_draw_indirect() chain draw->jobs.frag_copy_desc before the
+    * per-layer prepare_draw_layer() calls that get here, so the copy job
+    * this built for every layer was never chained, only allocated, packed
+    * and reset on every resubmit. PANVK_V7_FS_COPY_ONCE=0 builds it again
+    * (old, without the uninitialized ptr on FS-less draws).
+    */
+   if (!to_panvk_device(cmdbuf->vk.base.device)->jm_opt.fs_copy_once) {
+      if (cmdbuf->state.gfx.fs.required) {
+         const struct panvk_shader_desc_info *fs_desc_info =
+            &cmdbuf->state.gfx.fs.shader->desc_info;
+         struct panvk_shader_desc_state *fs_desc_state =
+            &cmdbuf->state.gfx.fs.desc;
+         VkResult result = panvk_per_arch(meta_get_copy_desc_job)(
+            cmdbuf, fs_desc_info, &cmdbuf->state.gfx.desc_state,
+            fs_desc_state, 0, &ptr);
+         if (result != VK_SUCCESS)
+            return result;
+      }
 
-   if (ptr.cpu)
-      util_dynarray_append(&batch->jobs, ptr.cpu);
+      if (ptr.cpu)
+         util_dynarray_append(&batch->jobs, ptr.cpu);
 
-   draw->jobs.frag_copy_desc = ptr;
+      draw->jobs.frag_copy_desc = ptr;
+   }
 
    /* Per-viewport tiler jobs (jm-v7 031): one array, the emulation patches
     * each one's index count.
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index 16ae3820..5b3bb37b 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -85,6 +85,12 @@ struct panvk_device {
     */
    struct panvk_priv_bo *indirect_varying_buffer2;
    struct panvk_priv_bo *tess_gs_scratch[2];
+   /* JM (v6/v7/v9) options, read once at device creation. */
+   struct {
+      /* PANVK_V7_FS_COPY_ONCE (default 1): v6/v7 FS descriptor copy job
+       * only when the FS tables change, none per tiler job. */
+      bool fs_copy_once;
+   } jm_opt;
    struct panvk_priv_bo *sample_positions;
 
    struct {
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index 67643e87..59877e2e 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -892,6 +892,11 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
       panvk_slab_cache_init(&device->slab_cache[i], slab_cache_window_ns,
                             slab_evict_windows);
 
+#if PAN_ARCH <= 9
+   device->jm_opt.fs_copy_once =
+      debug_get_bool_option("PANVK_V7_FS_COPY_ONCE", true);
+#endif
+
 #if PAN_ARCH >= 9
    if (PANVK_DEBUG(GPU_PRERAST) || device->vk.enabled_features.fillModeNonSolid ||
        device->vk.enabled_features.geometryShader ||
-- 
