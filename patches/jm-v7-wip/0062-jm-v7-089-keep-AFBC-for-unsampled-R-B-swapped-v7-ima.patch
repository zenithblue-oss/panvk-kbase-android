From d160802965557ce1c580cd633e270871e430554c Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Wed, 21 Oct 2026 20:37:56 +0000
Subject: [PATCH 62/62] jm-v7 089: keep AFBC for unsampled R/B-swapped v7
 images with customBorderColorWithoutFormat

jm-v7 044 turns AFBC off for every R/B-swapped image (BGRA8, ...) once
customBorderColorWithoutFormat is enabled, which DXVK and Zink do, so
BGRA8 render targets lost AFBC (perf review M11). The reason is the
border color, which only a sampled view can see: an image without
SAMPLED or INPUT_ATTACHMENT usage (render targets that are only resolved
or blitted, backbuffers, transfer-only images) can keep AFBC. Its texture
views (meta blits/copies) get the AFBC reswizzle from the image modifier,
as 044 already does for imported AFBC images, and view usage is always a
subset of the image usage. Sampled R/B-swapped images are unchanged.

PANVK_V7_CBC_AFBC=0 restores the 044 rule.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_image.c | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/vulkan/panvk_image.c b/src/panfrost/vulkan/panvk_image.c
index ae00436..db8b926 100644
--- a/src/panfrost/vulkan/panvk_image.c
+++ b/src/panfrost/vulkan/panvk_image.c
@@ -157,6 +157,17 @@ select_plane_pfmt(struct panvk_image *image, uint64_t mod, unsigned plane)
    return vk_format_to_pipe_format(plane_format);
 }
 
+static bool
+panvk_v7_cbc_afbc(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("PANVK_V7_CBC_AFBC");
+      on = !(e && e[0] == '0');
+   }
+   return on;
+}
+
 static bool
 panvk_image_can_use_mod(struct panvk_image *image,
                         const struct pan_image_usage *iusage, uint64_t mod,
@@ -197,9 +208,20 @@ panvk_image_can_use_mod(struct panvk_image *image,
        * color. A sampler without a format cannot pre-swizzle it, so keep
        * these formats uncompressed when the feature is enabled.
        */
+      /* jm-v7 089 (review M11): the border color only matters when the
+       * image is sampled, so an image without SAMPLED/INPUT_ATTACHMENT usage
+       * (render targets, backbuffers, transfer-only images) keeps AFBC; its
+       * views get the AFBC reswizzle from the image modifier. View usage
+       * can only be a subset of the image usage.
+       * PANVK_V7_CBC_AFBC=0 restores the old rule (no AFBC for any
+       * R/B-swapped image).
+       */
+      const VkImageUsageFlags cbc_sampled =
+         VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
       if (arch == 7 &&
           image->vk.base.device->enabled_features
-             .customBorderColorWithoutFormat) {
+             .customBorderColorWithoutFormat &&
+          ((image->vk.usage & cbc_sampled) || !panvk_v7_cbc_afbc())) {
          const struct util_format_description *fdesc =
             util_format_description(vk_format_to_pipe_format(image->vk.format));
          if (fdesc && fdesc->swizzle[0] == PIPE_SWIZZLE_Z &&
