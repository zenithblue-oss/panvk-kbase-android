From 84af9c5390c2381d7d425c0fd689bf56c8defb87 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 22 Oct 2026 05:20:48 +0000
Subject: [PATCH 74/75] jm-v7 101: v6 robustImageAccess2 out-of-bounds alpha
 from the view format

jm-v7 048/083 give a format-less storage image load and a uniform texel
buffer fetch out of bounds the inverted hardware alpha: v7 returns 1 for
rgba8 and 0 for r32ui there, the spec wants 0 and 1. v6 does not invert:
the FTL Galaxy S9 (Mali-G72, RC5-dev-v7K) PanProbe robust_image_access2
failed 10 r32ui cases (r32ui.tbuf_oob, r32ui.tbuf_alias65537,
r32ui_nofmt.load_x/_y/_layer/_neg_x/_x_alias65537/_layer_alias65536,
r32ui_nofmt.tbuf_oob/_alias65537) with alpha 0, while every rgba8 case
passed, so the v6 hardware alpha is nonzero for both formats.

On v6 read the view's hardware format from the descriptor set instead
(image_deref_format, lowered in nir_lower_descriptors: word 2 >> 10 for
storage images, word 4 >> 10 for texel buffers). v6 formats carry a
3-bit-per-channel swizzle, so the out-of-bounds alpha is 1 when the alpha
swizzle is the constant 1 (R001, RG01, RGB1) and 0 otherwise. The jm-v7 084
rule (a 0-element null texel buffer reads 0) is kept. v7 is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../vulkan/panvk_vX_nir_lower_descriptors.c   | 19 ++++++++++
 src/panfrost/vulkan/panvk_vX_shader.c         | 38 +++++++++++++++++--
 2 files changed, 54 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c b/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
index ae59e27..1734a1a 100644
--- a/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
+++ b/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
@@ -1370,6 +1370,22 @@ lower_img_intrinsic(nir_builder *b, nir_intrinsic_instr *intr,
    nir_deref_instr *deref = nir_src_as_deref(intr->src[0]);
 
 #if PAN_ARCH < 9
+   /* jm-v7 101: the 22-bit hardware format of a storage image or texel
+    * buffer, read from the set. Images pack it above the texel stride in
+    * word 2 (panvk_vX_image_view.c), texel buffers have it in their
+    * ATTRIBUTE word (word 4, bits 10..31).
+    */
+   if (intr->intrinsic == nir_intrinsic_image_deref_format) {
+      const bool buf = nir_intrinsic_image_dim(intr) == GLSL_SAMPLER_DIM_BUF;
+      nir_def *w = load_resource_deref_desc(
+         b, deref,
+         buf ? VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER
+             : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+         buf ? 16 : 8, 1, 32, ctx);
+      nir_def_replace(&intr->def, nir_ushr_imm(b, w, 10));
+      return true;
+   }
+
    if (intr->intrinsic == nir_intrinsic_image_deref_size ||
        intr->intrinsic == nir_intrinsic_image_deref_samples) {
       const enum glsl_sampler_dim dim = nir_intrinsic_image_dim(intr);
@@ -1447,6 +1463,9 @@ lower_intrinsic(nir_builder *b, nir_intrinsic_instr *intr,
    case nir_intrinsic_image_deref_atomic_swap:
    case nir_intrinsic_image_deref_size:
    case nir_intrinsic_image_deref_samples:
+#if PAN_ARCH < 9
+   case nir_intrinsic_image_deref_format:
+#endif
       return lower_img_intrinsic(b, intr, ctx);
    default:
       return false;
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index e385efb..0b9803f 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -2890,6 +2890,34 @@ struct panvk_v7_ria2_state {
    struct vk_descriptor_set_layout *const *set_layouts;
 };
 
+/* Whether the out-of-bounds alpha of a format-less access must be 1 (the
+ * view format has no alpha), from the hardware alpha hw_a of the same
+ * out-of-bounds access.
+ *
+ * jm-v7 101: v7 returns the inverted alpha (1 for rgba8, 0 for r32ui), so
+ * inverting it is right there. v6 does not: the FTL Galaxy S9 (G72,
+ * RC5-dev-v7K) returned 0 after the inversion for every r32ui case
+ * (tbuf_oob, tbuf_alias65537, r32ui_nofmt.load_*), while rgba8 passed, so
+ * the v6 hardware alpha is nonzero for both. v6 formats carry a swizzle
+ * (3 bits per channel, pan_format.h), so read the view's hardware format
+ * from the descriptor and give alpha 1 when the alpha swizzle is the
+ * constant 1 (R001, RG01, RGB1).
+ */
+static nir_def *
+panvk_v7_ria2_no_alpha(nir_builder *b, nir_def *deref,
+                       enum glsl_sampler_dim dim, bool array, nir_def *hw_a)
+{
+#if PAN_ARCH == 6
+   nir_def *fmt = nir_image_deref_format(b, 32, deref, .image_dim = dim,
+                                         .image_array = array);
+   nir_def *a_swz = nir_iand_imm(b, nir_ushr_imm(b, fmt, 9), 0x7);
+   (void)hw_a;
+   return nir_ieq_imm(b, a_swz, MALI_CHANNEL_1);
+#else
+   return nir_ieq_imm(b, hw_a, 0);
+#endif
+}
+
 static bool
 panvk_v7_lower_robust_image2_intr(nir_builder *b, nir_intrinsic_instr *intr,
                                   void *data)
@@ -2967,7 +2995,8 @@ panvk_v7_lower_robust_image2_intr(nir_builder *b, nir_intrinsic_instr *intr,
          oob_a = is_float ? nir_imm_floatN_t(b, one, bit_size)
                           : nir_imm_intN_t(b, one, bit_size);
       } else {
-         nir_def *no_alpha = nir_ieq_imm(b, hw_a, 0);
+         nir_def *no_alpha =
+            panvk_v7_ria2_no_alpha(b, intr->src[0].ssa, dim, array, hw_a);
          oob_a = is_float ? nir_b2fN(b, no_alpha, bit_size)
                           : nir_b2iN(b, no_alpha, bit_size);
       }
@@ -3047,8 +3076,11 @@ panvk_v7_lower_robust_txf_buf(nir_builder *b, nir_instr *instr, void *data)
     * 0-element R32_UINT view) must read (0, 0, 0, 0) (PanProbe robustness2
     * null_descriptors); only a real view, size >= 1, inverts the alpha.
     */
-   nir_def *no_alpha = nir_iand(b, nir_ieq_imm(b, hw_a, 0),
-                                nir_ine_imm(b, size, 0));
+   nir_def *no_alpha = nir_iand(
+      b,
+      panvk_v7_ria2_no_alpha(b, tex->src[tex_idx].src.ssa,
+                             GLSL_SAMPLER_DIM_BUF, false, hw_a),
+      nir_ine_imm(b, size, 0));
    nir_def *oob_a = is_float ? nir_b2fN(b, no_alpha, bit_size)
                              : nir_b2iN(b, no_alpha, bit_size);
    nir_def *zero = nir_imm_zero(b, 1, bit_size);
-- 
