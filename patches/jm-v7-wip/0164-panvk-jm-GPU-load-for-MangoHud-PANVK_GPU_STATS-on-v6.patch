From 8ef1c974697f5b59ae49ea994bc4b71f9ddfb4f2 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 29 Oct 2026 19:59:45 +0530
Subject: [PATCH 164/165] panvk/jm: GPU load for MangoHud (PANVK_GPU_STATS) on
 v6/v7/v9

0158 left JM at 0: the JM chains have no cheap GPU timestamps (they need
PERMON and write-value jobs in every chain). JM now reports the
CPU-observed time with at least one atom of the context in flight:
kbase_kmod counts atoms from JOB_SUBMIT to their completion event (only
once PANVK_GPU_STATS enabled it), and each submit reports the growth of
that busy time as consecutive intervals on a busy-time axis, so the
union in panvk_gpu_stats_busy() is that time. VRAM is the same as CSF.
Unset: no tracking, no cost.
---
 src/panfrost/lib/kmod/kbase_kmod.c          | 59 +++++++++++++++++++++
 src/panfrost/lib/kmod/kbase_kmod.h          |  4 ++
 src/panfrost/vulkan/jm/panvk_queue.h        |  2 +
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 16 ++++++
 4 files changed, 81 insertions(+)

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 8ebed40389f..9ab162707ad 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -149,6 +149,8 @@ struct kbase_atom_slot {
    uint32_t core_req;
    bool completed;
    bool errored;
+   /* Counted in kbase_kmod_dev::busy_inflight (PANVK_GPU_STATS on JM). */
+   bool busy_counted;
    uint32_t waiters;
 };
 
@@ -235,6 +237,11 @@ struct kbase_kmod_dev {
 
    simple_mtx_t atoms_lock;
    simple_mtx_t atoms_read_lock;
+   /* JM GPU stats (kbase_kmod_jm_busy_ns()), under atoms_lock: time with at
+    * least one atom of this context submitted and not yet completed. */
+   bool busy_track;
+   uint32_t busy_inflight;
+   uint64_t busy_start_ns, busy_ns;
    struct kbase_atom_slot atoms[KBASE_MAX_ATOMS];
    uint64_t next_atom_number;
    unsigned atom_stride;
@@ -3523,6 +3530,11 @@ kbase_atom_process_event_locked(struct kbase_kmod_dev *kd,
          struct kbase_atom_slot *s = &kd->atoms[i];
          s->completed = true;
          s->errored = errored;
+         if (s->busy_counted) {
+            s->busy_counted = false;
+            if (!--kd->busy_inflight)
+               kd->busy_ns += os_time_get_nano() - kd->busy_start_ns;
+         }
          if (errored)
             mesa_loge("kbase: JM atom %u failed: event=0x%x core_req=0x%x",
                       num, ev->event_code, s->core_req);
@@ -3684,6 +3696,49 @@ kbase_wait_atom(struct kbase_kmod_dev *kd, uint64_t atom_num,
    }
 }
 
+/* JM GPU stats: count the atom in flight before JOB_SUBMIT (its event can't
+ * come earlier), and back out when the ioctl fails. */
+static void
+kbase_busy_begin(struct kbase_kmod_dev *kd, struct kbase_atom_slot *slot)
+{
+   slot->busy_counted = false;
+   if (!kd->busy_track)
+      return;
+   simple_mtx_lock(&kd->atoms_lock);
+   if (!kd->busy_inflight++)
+      kd->busy_start_ns = os_time_get_nano();
+   slot->busy_counted = true;
+   simple_mtx_unlock(&kd->atoms_lock);
+}
+
+static void
+kbase_busy_cancel_locked(struct kbase_kmod_dev *kd,
+                         struct kbase_atom_slot *slot)
+{
+   if (slot->busy_counted && !--kd->busy_inflight)
+      kd->busy_ns += os_time_get_nano() - kd->busy_start_ns;
+   slot->busy_counted = false;
+}
+
+void
+kbase_kmod_jm_busy_track(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   kd->busy_track = !kd->is_csf;
+}
+
+uint64_t
+kbase_kmod_jm_busy_ns(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   simple_mtx_lock(&kd->atoms_lock);
+   uint64_t ns = kd->busy_ns;
+   if (kd->busy_inflight)
+      ns += os_time_get_nano() - kd->busy_start_ns;
+   simple_mtx_unlock(&kd->atoms_lock);
+   return ns;
+}
+
 uint64_t
 kbase_kmod_job_submit(struct pan_kmod_dev *dev, uint64_t jc,
                       uint32_t core_req, struct pan_kmod_bo **bos,
@@ -3725,9 +3780,11 @@ kbase_kmod_job_submit(struct pan_kmod_dev *dev, uint64_t jc,
       .nr_atoms = 1,
       .stride = kd->atom_stride,
    };
+   kbase_busy_begin(kd, slot);
    if (ioctl(dev->fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
       mesa_loge("kbase: JOB_SUBMIT failed: %s", strerror(errno));
       simple_mtx_lock(&kd->atoms_lock);
+      kbase_busy_cancel_locked(kd, slot);
       slot->atom_number = 0;
       simple_mtx_unlock(&kd->atoms_lock);
       return 0;
@@ -3776,9 +3833,11 @@ kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc,
       .nr_atoms = 1,
       .stride = kd->atom_stride,
    };
+   kbase_busy_begin(kd, slot);
    if (ioctl(dev->fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
       mesa_loge("kbase: JOB_SUBMIT(dep) failed: %s", strerror(errno));
       simple_mtx_lock(&kd->atoms_lock);
+      kbase_busy_cancel_locked(kd, slot);
       slot->atom_number = 0;
       simple_mtx_unlock(&kd->atoms_lock);
       return 0;
diff --git a/src/panfrost/lib/kmod/kbase_kmod.h b/src/panfrost/lib/kmod/kbase_kmod.h
index 15f03932785..d63b6649b4c 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.h
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -53,6 +53,10 @@ bool kbase_kmod_wait_atom(struct pan_kmod_dev *dev, uint64_t atom_number,
                          int64_t timeout_ns);
 void kbase_kmod_atom_release(struct pan_kmod_dev *dev, uint64_t atom_num);
 void kbase_kmod_jm_clean_imports(struct pan_kmod_dev *dev);
+/* JM only: track the time with atoms in flight (enable once, for
+ * PANVK_GPU_STATS), and read it in ns. */
+void kbase_kmod_jm_busy_track(struct pan_kmod_dev *dev);
+uint64_t kbase_kmod_jm_busy_ns(struct pan_kmod_dev *dev);
 struct pan_kmod_bo *kbase_kmod_bo_import_host(struct pan_kmod_dev *dev,
                                             void *host_ptr, uint64_t size);
 
diff --git a/src/panfrost/vulkan/jm/panvk_queue.h b/src/panfrost/vulkan/jm/panvk_queue.h
index f52a7569773..2c8665aaef9 100644
--- a/src/panfrost/vulkan/jm/panvk_queue.h
+++ b/src/panfrost/vulkan/jm/panvk_queue.h
@@ -40,6 +40,8 @@ struct panvk_gpu_queue {
    /* v67b: last fragment atom per tiler heap half, last vtc atom */
    uint64_t half_frag_atom[2];
    uint64_t last_vtc_atom;
+   /* PANVK_GPU_STATS: kbase_kmod_jm_busy_ns() at the last report. */
+   uint64_t stats_busy_ns;
 #if PAN_ARCH == 9
    /* Atom numbers submitted by the current vkQueueSubmit (see dep_type()). */
    BITSET_DECLARE(submit_atoms, 256);
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index c9155de691a..6b50d5ccbab 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -546,6 +546,20 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
                                    panvk_jm_kbase_wait_atoms, targets, NULL);
    }
 
+   /* PANVK_GPU_STATS: JM chains have no cheap GPU timestamps (they need
+    * PERMON and write jobs), so the busy time is the CPU-observed time with
+    * atoms in flight. It is reported as consecutive intervals on a busy-time
+    * axis shared by the device's queues, so their union is that time. */
+   if (panvk_gpu_stats_path()) {
+      const struct panvk_physical_device *pdev =
+         to_panvk_physical_device(dev->vk.physical);
+      const uint64_t busy = kbase_kmod_jm_busy_ns(dev->kmod.dev);
+      panvk_gpu_stats_busy(1000000000ull,
+                           p_atomic_read_relaxed(&pdev->memory.heap_used),
+                           queue->stats_busy_ns, busy);
+      queue->stats_busy_ns = busy;
+   }
+
    return VK_SUCCESS;
 }
 
@@ -584,6 +598,8 @@ panvk_per_arch(create_gpu_queue)(struct panvk_device *device,
       goto err_finish_queue;
 
    queue->vk.driver_submit = panvk_per_arch(gpu_queue_submit);
+   if (panvk_gpu_stats_path())
+      kbase_kmod_jm_busy_track(device->kmod.dev);
    *out_queue = &queue->vk;
    return VK_SUCCESS;
 
-- 
2.56.0

