diff --git a/src/panfrost/vulkan/panvk_cmd_pool.c b/src/panfrost/vulkan/panvk_cmd_pool.c
index e850f7c1..2e477a52 100644
--- a/src/panfrost/vulkan/panvk_cmd_pool.c
+++ b/src/panfrost/vulkan/panvk_cmd_pool.c
@@ -46,11 +46,33 @@ panvk_CreateCommandPool(VkDevice _device,
    panvk_bo_pool_init(&pool->gs_bo_pool);
    panvk_bo_pool_init(&pool->tls_bo_pool);
    panvk_bo_pool_init(&pool->tls_big_bo_pool);
+   if (device->cmdbuf_opt.slab_cache) {
+      pool->cs_bo_pool.cache = &device->slab_cache[PANVK_SLAB_CACHE_CS];
+      pool->desc_bo_pool.cache = &device->slab_cache[PANVK_SLAB_CACHE_DESC];
+      pool->tls_bo_pool.cache = &device->slab_cache[PANVK_SLAB_CACHE_TLS];
+   }
    list_inithead(&pool->push_sets);
    *pCmdPool = panvk_cmd_pool_to_handle(pool);
    return VK_SUCCESS;
 }
 
+/* Hands the free slabs of the pool's cached kinds but keep of each to the
+ * device slab caches. */
+static void
+panvk_cmd_pool_give_to_caches(struct panvk_cmd_pool *pool, unsigned keep)
+{
+   struct panvk_bo_pool *cached[] = {
+      &pool->cs_bo_pool,
+      &pool->desc_bo_pool,
+      &pool->tls_bo_pool,
+   };
+
+   for (unsigned i = 0; i < ARRAY_SIZE(cached); i++) {
+      if (cached[i]->cache)
+         panvk_bo_pool_give_to_cache(cached[i], keep);
+   }
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_DestroyCommandPool(VkDevice _device, VkCommandPool commandPool,
                          const VkAllocationCallbacks *pAllocator)
@@ -63,6 +85,10 @@ panvk_DestroyCommandPool(VkDevice _device, VkCommandPool commandPool,
 
    vk_command_pool_finish(&pool->vk);
 
+   /* None of the pool's command buffers is pending: its idle slabs can
+    * serve other pools. */
+   panvk_cmd_pool_give_to_caches(pool, 0);
+
    panvk_bo_pool_cleanup(&pool->cs_bo_pool);
    panvk_bo_pool_cleanup(&pool->desc_bo_pool);
    panvk_bo_pool_cleanup(&pool->varying_bo_pool);
@@ -136,6 +162,7 @@ panvk_cmd_pool_autotrim_enabled(struct panvk_device *dev)
 }
 
 #define PANVK_CMD_POOL_BO_POOLS 6
+#define PANVK_CMD_POOL_CACHE_KEEP 2
 
 /* csf-v11 231: 226 kept only what the last reset gave back (+25%), so a pool
  * whose recordings vary in size freed BOs at a light reset and allocated
@@ -220,9 +247,22 @@ panvk_ResetCommandPool(VkDevice _device, VkCommandPool commandPool,
    if (result == VK_SUCCESS && release_resources)
       panvk_cmd_pool_release_free_bos(pool);
 
+   /* With the device slab caches (PANVK_CMD_SLAB_CACHE), the pool keeps
+    * PANVK_CMD_POOL_CACHE_KEEP free slabs of each cached kind for its next
+    * recording and the caches get the rest: one DXVK command list records
+    * at a time, so per-pool peaks summed over its ~20 recycled pools were
+    * mostly idle. The caches trim themselves, csf-v11 231 does not apply to
+    * them.
+    */
+   if (result == VK_SUCCESS && !release_resources)
+      panvk_cmd_pool_give_to_caches(pool, PANVK_CMD_POOL_CACHE_KEEP);
+
    if (result == VK_SUCCESS && autotrim) {
       const unsigned window = panvk_cmd_pool_autotrim_window();
       for (unsigned i = 0; i < PANVK_CMD_POOL_BO_POOLS; i++) {
+         if (bo_pools[i]->cache)
+            continue;
+
          const unsigned after = list_length(&bo_pools[i]->free_bos);
          const unsigned used = after > before[i] ? after - before[i] : 0;
          unsigned base = used;
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index 1282f7ac..16ae3820 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -224,8 +224,15 @@ struct panvk_device {
       /* PANVK_CS_CHUNK_KB (default 4, 64 = fixed 64 KiB chunks): size of
        * the first CS chunk of a stream (CSF), doubling up to 64 KiB. */
       uint32_t cs_chunk_min_B;
+      /* PANVK_CMD_SLAB_CACHE (default 1, CSF): command pools share their
+       * idle CS, descriptor and TLS slabs through slab_cache[]. */
+      bool slab_cache;
    } cmdbuf_opt;
 
+   /* Device-wide caches of idle command buffer slabs, indexed by enum
+    * panvk_slab_cache_kind (used when cmdbuf_opt.slab_cache). */
+   struct panvk_slab_cache slab_cache[PANVK_SLAB_CACHE_COUNT];
+
    /* Device-wide thread local storage shared by all command buffers. The
     * last BO is the current one; outgrown ones stay alive for command
     * buffers that still point at them. */
diff --git a/src/panfrost/vulkan/panvk_mempool.c b/src/panfrost/vulkan/panvk_mempool.c
index ceaf82e4..4b0ad813 100644
--- a/src/panfrost/vulkan/panvk_mempool.c
+++ b/src/panfrost/vulkan/panvk_mempool.c
@@ -10,6 +10,8 @@
 
 #include "kmod/pan_kmod.h"
 
+#include "util/os_time.h"
+
 void
 panvk_bo_pool_cleanup(struct panvk_bo_pool *bo_pool)
 {
@@ -20,6 +22,111 @@ panvk_bo_pool_cleanup(struct panvk_bo_pool *bo_pool)
    }
 }
 
+void
+panvk_slab_cache_init(struct panvk_slab_cache *cache, uint64_t window_ns)
+{
+   memset(cache, 0, sizeof(*cache));
+   simple_mtx_init(&cache->lock, mtx_plain);
+   list_inithead(&cache->bos);
+   cache->window_ns = window_ns;
+   cache->window_start_ns = os_time_get_nano();
+}
+
+void
+panvk_slab_cache_finish(struct panvk_slab_cache *cache)
+{
+   list_for_each_entry_safe(struct panvk_priv_bo, bo, &cache->bos, node) {
+      list_del(&bo->node);
+      p_atomic_dec(&panvk_mem_stats.slab_cache_count);
+      p_atomic_add(&panvk_mem_stats.slab_cache_B,
+                   -(int64_t)pan_kmod_bo_size(bo->bo));
+      panvk_priv_bo_unref(bo);
+   }
+   simple_mtx_destroy(&cache->lock);
+}
+
+static struct panvk_priv_bo *
+panvk_slab_cache_take(struct panvk_slab_cache *cache)
+{
+   struct panvk_priv_bo *bo = NULL;
+
+   simple_mtx_lock(&cache->lock);
+   if (cache->count) {
+      bo = list_last_entry(&cache->bos, struct panvk_priv_bo, node);
+      list_del(&bo->node);
+      cache->count--;
+      cache->low = MIN2(cache->low, cache->count);
+   }
+   simple_mtx_unlock(&cache->lock);
+
+   if (bo) {
+      p_atomic_inc(&panvk_mem_stats.slab_cache_hits);
+      p_atomic_dec(&panvk_mem_stats.slab_cache_count);
+      p_atomic_add(&panvk_mem_stats.slab_cache_B,
+                   -(int64_t)pan_kmod_bo_size(bo->bo));
+   }
+
+   return bo;
+}
+
+void
+panvk_bo_pool_give_to_cache(struct panvk_bo_pool *bo_pool, unsigned keep)
+{
+   struct panvk_slab_cache *cache = bo_pool->cache;
+   struct list_head give, drop;
+   unsigned have = list_length(&bo_pool->free_bos), given = 0, dropped = 0;
+   uint64_t given_B = 0, dropped_B = 0;
+
+   list_inithead(&give);
+   list_inithead(&drop);
+   for (; have > keep; have--, given++) {
+      struct panvk_priv_bo *bo =
+         list_first_entry(&bo_pool->free_bos, struct panvk_priv_bo, node);
+      list_del(&bo->node);
+      list_addtail(&bo->node, &give);
+      given_B += pan_kmod_bo_size(bo->bo);
+   }
+
+   const uint64_t now = os_time_get_nano();
+
+   simple_mtx_lock(&cache->lock);
+   list_splicetail(&give, &cache->bos);
+   cache->count += given;
+   cache->high = MAX2(cache->high, cache->count);
+
+   if (now - cache->window_start_ns >= cache->window_ns) {
+      /* With takes from the tail, the low oldest slabs were not used in
+       * this window. */
+      const uint32_t margin = MAX2((cache->high - cache->low) / 4, 2);
+      uint32_t idle = MIN2(cache->low, cache->count);
+
+      for (; idle > margin; idle--, dropped++) {
+         struct panvk_priv_bo *bo =
+            list_first_entry(&cache->bos, struct panvk_priv_bo, node);
+         list_del(&bo->node);
+         list_addtail(&bo->node, &drop);
+         dropped_B += pan_kmod_bo_size(bo->bo);
+      }
+
+      cache->count -= dropped;
+      cache->low = cache->high = cache->count;
+      cache->window_start_ns = now;
+   }
+   simple_mtx_unlock(&cache->lock);
+
+   p_atomic_add(&panvk_mem_stats.slab_cache_count,
+                (int64_t)given - (int64_t)dropped);
+   p_atomic_add(&panvk_mem_stats.slab_cache_B,
+                (int64_t)given_B - (int64_t)dropped_B);
+   p_atomic_add(&panvk_mem_stats.slab_cache_freed_bos, dropped);
+   p_atomic_add(&panvk_mem_stats.slab_cache_freed_B, dropped_B);
+
+   list_for_each_entry_safe(struct panvk_priv_bo, bo, &drop, node) {
+      list_del(&bo->node);
+      panvk_priv_bo_unref(bo);
+   }
+}
+
