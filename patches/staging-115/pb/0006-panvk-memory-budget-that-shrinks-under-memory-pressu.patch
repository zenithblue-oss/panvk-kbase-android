From e742cc6bc631b53199c33b6e79a83163a4e186f7 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Mon, 26 Oct 2026 02:36:12 +0000
Subject: [PATCH 06/10] panvk: memory budget that shrinks under memory pressure

Rationale: perf review 2026-10-26 part B, finding Q1 (and section 4: 229
"honest" can only give DXVK more headroom, never less, so it stays
opt-in). The budget was min(heap, used + 0.9 x MemAvailable). On Android,
zram and the low memory killer hold MemAvailable at 200-400 MB until zram
is full, so DXVK always saw that much headroom (89 % in fo4-05) and kept
307 MB of allocated but unused chunks while the kernel was already
swapping the game out (SwapFree 23 MB in 112).

DXVK 3.1.1 (dxvk_memory.cpp) re-reads the budget every 500 ms as
heapBudget minus the non-DXVK part of heapUsage, minus 1 % of the heap.
When its allocations exceed that it frees empty chunks at once and
defragments device-local chunks (Auto = on outside ANV); defragmentation
only moves a chunk when the other chunks have room for it, one chunk at a
time, and on UMA nothing is evicted and no allocation is refused.

With PANVK_MEM_BUDGET_PRESSURE (default 1) the budget is
min(heap, used + 0.9 x max(0, MemAvailable - R)), never below heapUsage
(and never 0). R = PANVK_MEM_BUDGET_RESERVE_MB (default 256 with 8 GiB of
RAM or less, 0 above), plus 256 MiB while SwapFree is below SwapTotal / 8.
MemAvailable, SwapTotal and SwapFree come from one /proc/meminfo read,
cached for 100 ms as before. heapUsage stays the VkDeviceMemory total,
which matches DXVK's own accounting. In 112's end state (MemAvailable
365 MB, SwapFree 23 MB) the budget equals the usage, so DXVK gives back
its empty chunks and compacts. Above 8 GiB without swap pressure the
budget is unchanged.

Knobs: PANVK_MEM_BUDGET_PRESSURE=0 = 114 formula;
PANVK_MEM_BUDGET_RESERVE_MB=<n>. Both read once at physical device
creation. 229's PANVK_MEM_BUDGET=honest and _HEADROOM_MB stay opt-in and
apply on top. All arches.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_physical_device.c | 98 +++++++++++++++++++--
 src/panfrost/vulkan/panvk_physical_device.h |  8 ++
 2 files changed, 99 insertions(+), 7 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 259242a0..06c661e7 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -24,6 +24,7 @@
 #endif
 
 #include "util/disk_cache.h"
+#include "util/os_file.h"
 #include "util/os_misc.h"
 #include "util/os_time.h"
 #include "util/u_atomic.h"
@@ -593,6 +594,25 @@ get_device_heaps(struct panvk_physical_device *device,
    device->memory.max_supported_va =
       pan_clamp_to_usable_va_range(device->kmod.dev, request_va);
 
+   /* On Android, zram and the low memory killer hold MemAvailable at a few
+    * hundred MB until zram is full, so a budget of used + 90 % of it gave
+    * DXVK the same headroom while the game was being swapped out (DXVK
+    * kept 307 MB of allocated but unused chunks in Fallout 4). Keep a
+    * reserve out of the budget: PANVK_MEM_BUDGET_RESERVE_MB, default 256
+    * up to 8 GiB of RAM and 0 above. PANVK_MEM_BUDGET_PRESSURE=0 is the
+    * 114 budget.
+    */
+   uint64_t total_ram = 0;
+   os_get_total_physical_memory(&total_ram);
+   device->memory.budget_pressure =
+      debug_get_bool_option("PANVK_MEM_BUDGET_PRESSURE", true);
+   device->memory.budget_reserve =
+      (uint64_t)MAX2(debug_get_num_option(
+                        "PANVK_MEM_BUDGET_RESERVE_MB",
+                        total_ram && total_ram <= (8ull << 30) ? 256 : 0),
+                     0)
+      << 20;
+
    return VK_SUCCESS;
 }
 
@@ -1697,6 +1717,37 @@ panvk_GetPhysicalDeviceCooperativeMatrixPropertiesKHR(
    return vk_outarray_status(&out);
 }
 
+static bool
+panvk_meminfo_field(const char *meminfo, const char *key, uint64_t *bytes)
+{
+   const char *str = strstr(meminfo, key);
+
+   if (!str)
+      return false;
+
+   *bytes = strtoull(str + strlen(key), NULL, 10) << 10;
+   return true;
+}
+
+/* MemAvailable, SwapTotal and SwapFree from one /proc/meminfo read. */
+static bool
+panvk_read_meminfo(uint64_t *available, uint64_t *swap_total,
+                   uint64_t *swap_free)
+{
+   char *meminfo = os_read_file("/proc/meminfo", NULL);
+
+   if (!meminfo)
+      return false;
+
+   bool ok = panvk_meminfo_field(meminfo, "MemAvailable:", available);
+   if (!panvk_meminfo_field(meminfo, "SwapTotal:", swap_total) ||
+       !panvk_meminfo_field(meminfo, "SwapFree:", swap_free))
+      *swap_total = *swap_free = 0;
+
+   free(meminfo);
+   return ok;
+}
+
 static uint64_t
 panvk_available_system_memory(struct panvk_physical_device *physical_device)
 {
@@ -1706,15 +1757,40 @@ panvk_available_system_memory(struct panvk_physical_device *physical_device)
    if (last && now - last < 100000000ull)
       return p_atomic_read(&physical_device->memory.available);
 
-   uint64_t available;
-   if (!os_get_available_system_memory(&available))
+   uint64_t available, swap_total = 0, swap_free = 0;
+   if (physical_device->memory.budget_pressure) {
+      if (!panvk_read_meminfo(&available, &swap_total, &swap_free))
+         return 0;
+   } else if (!os_get_available_system_memory(&available)) {
       return 0;
+   }
 
+   p_atomic_set(&physical_device->memory.swap_total, swap_total);
+   p_atomic_set(&physical_device->memory.swap_free, swap_free);
    p_atomic_set(&physical_device->memory.available, available);
    p_atomic_set(&physical_device->memory.available_ns, now);
    return available;
 }
 
+/* MemAvailable the budget may hand out (PANVK_MEM_BUDGET_PRESSURE). */
+static uint64_t
+panvk_budget_available_memory(struct panvk_physical_device *physical_device)
+{
+   uint64_t available = panvk_available_system_memory(physical_device);
+
+   if (!physical_device->memory.budget_pressure)
+      return available;
+
+   uint64_t reserve = physical_device->memory.budget_reserve;
+   const uint64_t swap_total =
+      p_atomic_read(&physical_device->memory.swap_total);
+   if (swap_total &&
+       p_atomic_read(&physical_device->memory.swap_free) < swap_total / 8)
+      reserve += 256ull << 20;
+
+   return available > reserve ? available - reserve : 0;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_GetPhysicalDeviceMemoryProperties2(
    VkPhysicalDevice physicalDevice,
@@ -1754,9 +1830,10 @@ panvk_GetPhysicalDeviceMemoryProperties2(
          p->heapUsage[0] = used;
 
          /* Set the budget at 90% of available to avoid thrashing */
-         p->heapBudget[0] = vk_physical_device_heap_budget(
-            panvk_available_system_memory(physical_device), 0.9f, heap_size,
-            used);
+         const uint64_t available =
+            panvk_budget_available_memory(physical_device);
+         p->heapBudget[0] =
+            vk_physical_device_heap_budget(available, 0.9f, heap_size, used);
 
          /* csf-v11 229, opt-in (default: the two lines above).
           * PANVK_MEM_BUDGET=honest: heapUsage also counts the driver's
@@ -1779,8 +1856,7 @@ panvk_GetPhysicalDeviceMemoryProperties2(
                priv += p_atomic_read_relaxed(&panvk_mem_stats.bytes[k]);
             p->heapUsage[0] = used + priv;
             p->heapBudget[0] = vk_physical_device_heap_budget(
-               panvk_available_system_memory(physical_device), 0.9f,
-               heap_size, used + priv);
+               available, 0.9f, heap_size, used + priv);
          }
          if (p_atomic_read(&headroom_mb) > 0) {
             const uint64_t floor =
@@ -1790,6 +1866,14 @@ panvk_GetPhysicalDeviceMemoryProperties2(
             p->heapBudget[0] = MAX2(p->heapBudget[0], floor);
          }
 
+         /* Under pressure the budget can reach the usage, never less (nor
+          * zero, which the spec forbids). */
+         if (physical_device->memory.budget_pressure) {
+            p->heapBudget[0] =
+               MAX2(p->heapBudget[0],
+                    MIN2(heap_size, MAX2(p->heapUsage[0], 1ull << 20)));
+         }
+
          /* From the Vulkan 1.3.278 spec:
           *
           *    "The heapBudget and heapUsage values must be zero for array
diff --git a/src/panfrost/vulkan/panvk_physical_device.h b/src/panfrost/vulkan/panvk_physical_device.h
index 2edfbd9e..fd102fab 100644
--- a/src/panfrost/vulkan/panvk_physical_device.h
+++ b/src/panfrost/vulkan/panvk_physical_device.h
@@ -74,6 +74,14 @@ struct panvk_physical_device {
       alignas(8) uint64_t heap_used;
       alignas(8) uint64_t available;
       alignas(8) uint64_t available_ns;
+
+      /* PANVK_MEM_BUDGET_PRESSURE (default 1): the budget only counts
+       * MemAvailable beyond budget_reserve, plus 256 MiB more while swap is
+       * running out (swap_* sampled with MemAvailable). */
+      bool budget_pressure;
+      uint64_t budget_reserve;
+      alignas(8) uint64_t swap_total;
+      alignas(8) uint64_t swap_free;
    } memory;
 
    struct vk_sync_type drm_syncobj_type;
-- 
