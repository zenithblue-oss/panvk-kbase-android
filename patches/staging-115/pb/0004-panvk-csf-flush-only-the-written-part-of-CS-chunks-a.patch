From 4255d33e8af91d5b442630d02428023384d55e5c Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Mon, 26 Oct 2026 02:32:05 +0000
Subject: [PATCH 04/10] panvk/csf: flush only the written part of CS chunks at
 EndCommandBuffer

Rationale: perf review 2026-10-26 part A, finding A3. Every CS chunk is a
64 KiB allocation from the CS pool, whose slab is also 64 KiB, so the pool
never has a transient BO and 221's "flush up to transient_offset" never
applies to it: panvk_pool_flush_maps() cleaned every CS BO whole at
EndCommandBuffer. finish_cs() always emits into all three subqueues, so a
primary costs at least 3 x 64 KiB of dc cvac (3072 lines) however little
it records, and a large one cleans the unwritten tail of each subqueue's
last chunk (up to 1024 lines each). Those lines were cleaned at their
previous use and not written since.

alloc_cs_buffer() now records each chunk (BO, offset, GPU address, size =
capacity) in panvk_cmd_buffer::cs_chunks. Before each cs_end() of a
command buffer builder (finish_cs() and cmd_cut_vmr_segment()), the
pending cs_if() is flushed as cs_end() would and the size of the chunk
the builder ends in becomes what it wrote, rounded up to a cache line.
EndCommandBuffer flushes the recorded ranges instead of the whole pool.
Chunks a builder left (wrapped) are flushed whole: they are full up to the
last instruction block. Builder patches (cs_maybe, chunk length links)
land inside written ranges before End, and nothing writes a chunk after
End, so only lines that were never written are skipped. Secondaries take
the same path.

Knob: PANVK_CS_FLUSH_USED (default 1), read once at device creation;
0 = 114 (whole-BO flush, no chunk records). Arch: v10+ (CSF only).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/csf/panvk_cmd_buffer.h    | 12 +++
 src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c | 95 ++++++++++++++++++-
 src/panfrost/vulkan/panvk_device.h            |  7 ++
 src/panfrost/vulkan/panvk_vX_device.c         |  2 +
 4 files changed, 112 insertions(+), 4 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
index 9d8110e6..f72b8199 100644
--- a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
@@ -593,10 +593,22 @@ struct panvk_cond_render_state {
    enum mali_cs_condition exec_cond;
 };
 
+/* A CS chunk of the recording, see panvk_cmd_buffer::cs_chunks. */
+struct panvk_cs_chunk {
+   struct panvk_priv_bo *bo;
+   uint64_t gpu;
+   uint32_t offset;
+   /* Bytes to flush: the capacity, or what the builder wrote once it ended
+    * in this chunk. */
+   uint32_t size;
+};
+
 struct panvk_cmd_buffer {
    struct vk_command_buffer vk;
    VkCommandBufferUsageFlags flags;
    struct panvk_pool cs_pool;
+   /* struct panvk_cs_chunk, in allocation order (PANVK_CS_FLUSH_USED). */
+   struct util_dynarray cs_chunks;
    struct panvk_pool desc_pool;
    struct panvk_pool tls_pool;
    struct list_head push_sets;
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index 26206c88..7bfa3725 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -472,6 +472,51 @@ flush_sync_points(struct panvk_cmd_buffer *cmdbuf)
       cmdbuf->state.cs[i].relative_sync_point = 0;
 }
 
+/* Records how much of the builder's current chunk is written before
+ * cs_end() forgets it, so that EndCommandBuffer flushes only that. Later
+ * patches (cs_maybe, chunk links) land inside written ranges.
+ */
+static void
+cs_chunk_note_end(struct panvk_cmd_buffer *cmdbuf, struct cs_builder *b)
+{
+   const struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+
+   if (!dev->cmdbuf_opt.cs_flush_used || !cs_is_valid(b) ||
+       !b->cur_chunk.buffer.cpu)
+      return;
+
+   /* cs_end() first emits the instructions of a pending cs_if(). */
+   cs_flush_pending_if(b);
+
+   util_dynarray_foreach_reverse(&cmdbuf->cs_chunks, struct panvk_cs_chunk,
+                                 c) {
+      if (c->gpu == b->cur_chunk.buffer.gpu) {
+         c->size = MIN2(ALIGN_POT(b->cur_chunk.pos * sizeof(uint64_t), 64),
+                        c->size);
+         return;
+      }
+   }
+}
+
+static void
+flush_cs_maps(struct panvk_cmd_buffer *cmdbuf)
+{
+   const struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+
+   if (!dev->cmdbuf_opt.cs_flush_used) {
+      panvk_pool_flush_maps(&cmdbuf->cs_pool);
+      return;
+   }
+
+   if (!(cmdbuf->cs_pool.props.create_flags & PAN_KMOD_BO_FLAG_WB_MMAP))
+      return;
+
+   util_dynarray_foreach(&cmdbuf->cs_chunks, struct panvk_cs_chunk, c) {
+      if (c->size)
+         panvk_priv_bo_flush(c->bo, c->offset, c->size);
+   }
+}
+
 static void
 finish_cs(struct panvk_cmd_buffer *cmdbuf, uint32_t subqueue)
 {
@@ -567,6 +612,7 @@ finish_cs(struct panvk_cmd_buffer *cmdbuf, uint32_t subqueue)
 
    panvk_per_arch(kbase_mark_progress)(
       cmdbuf, subqueue, PANVK_KBASE_PROGRESS_CMDBUF_DONE);
+   cs_chunk_note_end(cmdbuf, b);
    cs_end(&cmdbuf->state.cs[subqueue].builder);
 }
 
@@ -647,7 +693,7 @@ panvk_per_arch(EndCommandBuffer)(VkCommandBuffer commandBuffer)
       }
    }
 
-   panvk_pool_flush_maps(&cmdbuf->cs_pool);
+   flush_cs_maps(cmdbuf);
    panvk_pool_flush_maps(&cmdbuf->desc_pool);
 
    return vk_command_buffer_end(&cmdbuf->vk);
@@ -1152,13 +1198,51 @@ static struct cs_buffer
 alloc_cs_buffer(void *cookie)
 {
    struct panvk_cmd_buffer *cmdbuf = cookie;
+   const struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
    const unsigned capacity = 64 * 1024 / sizeof(uint64_t);
 
-   struct pan_ptr ptr = panvk_cmd_alloc_dev_mem(cmdbuf, cs, capacity * 8, 64);
+   if (!dev->cmdbuf_opt.cs_flush_used) {
+      struct pan_ptr ptr =
+         panvk_cmd_alloc_dev_mem(cmdbuf, cs, capacity * 8, 64);
+
+      return (struct cs_buffer){
+         .cpu = ptr.cpu,
+         .gpu = ptr.gpu,
+         .capacity = capacity,
+      };
+   }
+
+   struct panvk_cs_chunk *chunk =
+      util_dynarray_grow(&cmdbuf->cs_chunks, struct panvk_cs_chunk, 1);
+   if (!chunk) {
+      vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return (struct cs_buffer){0};
+   }
+
+   struct panvk_priv_mem mem = panvk_pool_alloc_mem(
+      &cmdbuf->cs_pool, (struct panvk_pool_alloc_info){
+                           .size = capacity * sizeof(uint64_t),
+                           .alignment = 64,
+                        });
+   struct panvk_priv_bo *bo = panvk_priv_mem_bo(mem);
+   if (!bo) {
+      (void)util_dynarray_pop_ptr(&cmdbuf->cs_chunks, struct panvk_cs_chunk);
+      vk_command_buffer_set_error(
+         &cmdbuf->vk,
+         panvk_catch_indirect_alloc_failure(VK_ERROR_OUT_OF_DEVICE_MEMORY));
+      return (struct cs_buffer){0};
+   }
+
+   *chunk = (struct panvk_cs_chunk){
+      .bo = bo,
+      .gpu = panvk_priv_mem_dev_addr(mem),
+      .offset = mem.offset,
+      .size = capacity * sizeof(uint64_t),
+   };
 
    return (struct cs_buffer){
-      .cpu = ptr.cpu,
-      .gpu = ptr.gpu,
+      .cpu = panvk_priv_mem_host_addr(mem),
+      .gpu = chunk->gpu,
       .capacity = capacity,
    };
 }
@@ -1271,6 +1355,7 @@ panvk_per_arch(cmd_cut_vmr_segment)(struct panvk_cmd_buffer *cmdbuf)
        * this stream's pending loads.
        */
       cs_wait_slots(b, dev->csf.sb.all_mask);
+      cs_chunk_note_end(cmdbuf, b);
       cs_end(b);
       if (!cs_is_valid(b)) {
          vk_command_buffer_set_error(&cmdbuf->vk,
@@ -1325,6 +1410,7 @@ panvk_reset_cmdbuf(struct vk_command_buffer *vk_cmdbuf,
 
    memset(&cmdbuf->state, 0, sizeof(cmdbuf->state));
    util_dynarray_clear(&cmdbuf->vmr_segs);
+   util_dynarray_clear(&cmdbuf->cs_chunks);
    init_cs_builders(cmdbuf);
 }
 
@@ -1349,6 +1435,7 @@ panvk_destroy_cmdbuf(struct vk_command_buffer *vk_cmdbuf)
    util_dynarray_fini(&cmdbuf->bc_timing);
    util_dynarray_fini(&cmdbuf->bc_raw_refs);
    util_dynarray_fini(&cmdbuf->vmr_segs);
+   util_dynarray_fini(&cmdbuf->cs_chunks);
    panvk_pool_cleanup(&cmdbuf->cs_pool);
    panvk_pool_cleanup(&cmdbuf->desc_pool);
    panvk_pool_cleanup(&cmdbuf->tls_pool);
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index be6f39a7..2adda9c8 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -213,6 +213,13 @@ struct panvk_device {
       uint64_t vs_region_end;
    } tess_opt;
 
+   /* CSF command buffer memory options, read once at device creation. */
+   struct {
+      /* PANVK_CS_FLUSH_USED (default 1): EndCommandBuffer flushes each CS
+       * chunk up to what its builder wrote, not every CS pool BO whole. */
+      bool cs_flush_used;
+   } cmdbuf_opt;
+
    /* Device-wide thread local storage shared by all command buffers. The
     * last BO is the current one; outgrown ones stay alive for command
     * buffers that still point at them. */
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index a558f847..8da83334 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -868,6 +868,8 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
    panvk_device_init_mempools(device);
    simple_mtx_init(&device->tls.lock, mtx_plain);
    util_dynarray_init(&device->tls.bos, NULL);
+   device->cmdbuf_opt.cs_flush_used =
+      debug_get_bool_option("PANVK_CS_FLUSH_USED", true);
 
 #if PAN_ARCH >= 9
    if (PANVK_DEBUG(GPU_PRERAST) || device->vk.enabled_features.fillModeNonSolid ||
-- 
2.55.0

