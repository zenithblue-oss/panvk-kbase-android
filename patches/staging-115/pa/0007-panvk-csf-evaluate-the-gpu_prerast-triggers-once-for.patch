From dabab5058a30a79e9ee17f7e10bf5f5b1e03c716 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Mon, 26 Oct 2026 06:39:08 +0000
Subject: [PATCH 07/10] panvk/csf: evaluate the gpu_prerast triggers once for a
 plain draw

Rationale: perf review 2026-10-26 finding A5 (a-csf-cpu.md). Every CSF
draw that is not itself generated went through gpu_prerast_wanted()
(csf-v11 078), then gpu_prerast_draw() (046), which runs
gpu_prerast_chunk_wanted() (with gpu_prerast_max_verts() and
panlib_chunk_topology()) and gpu_prerast_lowers() (a copy of the whole
panvk_draw_info, chunk_wanted again and gpu_prerast_can_lower(), which
calls gpu_prerast_poly_mode() again), and then gpu_prerast_needed() a
second time. For a plain draw (no GS, tessellation, active xfb,
viewport-selecting VS, polygon mode or VS side effects) all of them are
false.

gpu_prerast_can_lower() returns false unless PANVK_DEBUG=gpu_prerast or
one of poly, gs, xfb, side effects or viewport select holds, and
gpu_prerast_wanted() covers each of those (xfb through
gpu_prerast_xfb_active(), viewport select through
panvk_prerast_viewport_shader()). Nothing between the two checks
changes their inputs. So the draw keeps the result of the first
gpu_prerast_wanted(), and when it is false (and the debug flag is off)
skips gpu_prerast_draw() and the second gpu_prerast_needed().

Knobs: PANVK_PRERAST_FAST_SKIP=0 = 114 (all three checks). Default on.
Arch: v10+ (CSF) only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 25 ++++++++++++++++-----
 src/panfrost/vulkan/panvk_instance.c        |  1 +
 src/panfrost/vulkan/panvk_perf_knobs.h      |  3 +++
 3 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index a4e9dcfc..bdd47054 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -6120,7 +6120,18 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info draw)
       draw.pstats_counted = true;
    }
 
-   if (gpu_prerast_wanted(cmdbuf, &draw) && gpu_prerast_split(cmdbuf, &draw))
+   /* A5 (115): evaluated once. A draw gpu_prerast does not want (none of
+    * its triggers, see gpu_prerast_needed()) can never be lowered either:
+    * gpu_prerast_can_lower() needs one of the same triggers or
+    * PANVK_DEBUG=gpu_prerast. Such a draw skips gpu_prerast_draw() and the
+    * second gpu_prerast_needed() below. PANVK_PRERAST_FAST_SKIP=0 runs
+    * them, as in 114.
+    */
+   const bool prerast_wanted = gpu_prerast_wanted(cmdbuf, &draw);
+   const bool prerast_skip = PANVK_PERF(PRERAST_FAST_SKIP) &&
+                             !prerast_wanted && !PANVK_DEBUG(GPU_PRERAST);
+
+   if (prerast_wanted && gpu_prerast_split(cmdbuf, &draw))
       return;
 
    /* A split chunk that falls back to IDVS has no instance ID offset: shift
@@ -6175,12 +6186,14 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info draw)
       return;
    }
 
-   if (!draw.gpu_prerast_generated && gpu_prerast_draw(cmdbuf, &draw))
-      return;
+   if (!prerast_skip) {
+      if (!draw.gpu_prerast_generated && gpu_prerast_draw(cmdbuf, &draw))
+         return;
 
-   if (gpu_prerast_needed(cmdbuf, &draw)) {
-      gpu_prerast_unhandled("shader variants missing");
-      return;
+      if (gpu_prerast_needed(cmdbuf, &draw)) {
+         gpu_prerast_unhandled("shader variants missing");
+         return;
+      }
    }
 
    /* For indirect draws, we need to patch the descriptors we just emitted */
diff --git a/src/panfrost/vulkan/panvk_instance.c b/src/panfrost/vulkan/panvk_instance.c
index cfa0d21e..e6cca0db 100644
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -89,6 +89,7 @@ static const struct {
    {"PANVK_CSF_INDIRECT_REEMIT", PANVK_PERF_CSF_INDIRECT_REEMIT},
    {"PANVK_CSF_DESC_DIRTY", PANVK_PERF_CSF_DESC_DIRTY},
    {"PANVK_VB_DIRTY_CMP", PANVK_PERF_VB_DIRTY_CMP},
+   {"PANVK_PRERAST_FAST_SKIP", PANVK_PERF_PRERAST_FAST_SKIP},
 };
 
 void
diff --git a/src/panfrost/vulkan/panvk_perf_knobs.h b/src/panfrost/vulkan/panvk_perf_knobs.h
index a46bec02..5f1f340d 100644
--- a/src/panfrost/vulkan/panvk_perf_knobs.h
+++ b/src/panfrost/vulkan/panvk_perf_knobs.h
@@ -37,6 +37,9 @@ enum panvk_perf_knob {
    /* A4, PANVK_VB_DIRTY_CMP: vkCmdBindVertexBuffers2 dirties the vertex
     * buffers only when a binding's address or size changes. */
    PANVK_PERF_VB_DIRTY_CMP = 1 << 5,
+   /* A5, PANVK_PRERAST_FAST_SKIP: a CSF draw that gpu_prerast does not
+    * want skips the other gpu_prerast checks. */
+   PANVK_PERF_PRERAST_FAST_SKIP = 1 << 6,
 };
 
 extern uint32_t panvk_perf_knobs;
-- 
2.55.0

