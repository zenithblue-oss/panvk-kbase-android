 src/panfrost/vulkan/bc/gen_spv.sh             |    4 +
 src/panfrost/vulkan/bc/panvk_bc_bc6.comp      |  220 ++
 src/panfrost/vulkan/bc/panvk_bc_bc6_blk_spv.h | 3279 +++++++++++++++++
 src/panfrost/vulkan/panvk_image.c             |   28 +
 src/panfrost/vulkan/panvk_image.h             |   11 +-
 src/panfrost/vulkan/panvk_vX_cmd_meta.c       |   51 +-
 6 files changed, 3578 insertions(+), 15 deletions(-)
