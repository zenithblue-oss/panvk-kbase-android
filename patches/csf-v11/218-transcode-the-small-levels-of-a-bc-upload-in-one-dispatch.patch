+static struct bc_decode_src
+bc_copy_region_src(const VkDeviceMemoryImageCopyKHR *r, uint32_t blk_B)
+{
+   const uint32_t row_px =
+      r->addressRowLength ? r->addressRowLength : r->imageExtent.width;
