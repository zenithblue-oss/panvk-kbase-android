From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 22 Oct 2026 09:40:00 +0000
Subject: [PATCH] panvk: transcode the small levels of a BC upload in one
 dispatch

A BC1-BC5 -> ETC2/EAC upload of a full mip chain was one dispatch per
level: 12 for a 2048^2 chain, of which the 9 smallest hold 1.6% of the
blocks but each pays the dispatch setup (pipeline bind, push upload,
RUN_COMPUTE and its sync). The whole-level, single-layer regions of an
upload with at most PANVK_BC_LM_BATCH blocks (default 4096, i.e. 256^2
and below; 0 = one dispatch per region as before) now go through one
dispatch of a new XC_BATCH specialization (constant 4) of
panvk_bc_etc2.comp: the push constants point at a table of up to 16
levels (first block index, source / shadow / raw addresses and
strides), invocation i transcodes block i of the levels laid end to end.
A 2048^2 chain takes 4 dispatches instead of 12.

The per-region pipeline (XC_BATCH 0) compiles to the same code as
before. The batch pipeline costs ~3.8 cycles more per block (table
lookup, division by the level width), on the small levels only.

tools/spvstat, v11, XC_BATCH=1 (cycles / registers / spills):
  BC1 51.44 / 57 / 0, BC3 55.16 / 57 / 0, BC4 13.88 / 22 / 0,
  BC5S 18.22 / 22 / 0.
Host check (tools/bc-glsl-host, shader as C++): batched and per-level
output (shadow and raw blocks) are byte-identical for BC1, BC1A and BC2
on a 100x60 chain (non-power-of-two widths).
---
 src/panfrost/vulkan/bc/panvk_bc_etc2.comp  |   84 +-
 src/panfrost/vulkan/bc/panvk_bc_etc2_spv.h | 3741 ++++++++++----------
 src/panfrost/vulkan/panvk_vX_cmd_meta.c    |  191 +-
 3 files changed, 2179 insertions(+), 1837 deletions(-)

diff --git a/src/panfrost/vulkan/bc/panvk_bc_etc2.comp b/src/panfrost/vulkan/bc/panvk_bc_etc2.comp
index 22c4b21a..248bcfc2 100644
--- a/src/panfrost/vulkan/bc/panvk_bc_etc2.comp
+++ b/src/panfrost/vulkan/bc/panvk_bc_etc2.comp
@@ -66,6 +66,9 @@ layout(local_size_x = 8, local_size_y = 8, local_size_z = 1,
 
 layout(constant_id = 2) const uint XC_MODE = 0u;      /* XC_* */
 layout(constant_id = 3) const uint XC_OPTS = 0x30000u; /* PANVK_BC_LM_OPTS */
+/* csf-v11/218: 1 = one dispatch over several small whole levels, whose
+ * addresses come from a table at registers.src (see main()). */
+layout(constant_id = 4) const uint XC_BATCH = 0u;
 
 layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer In2 {
     uvec2 data[];
@@ -1498,7 +1501,7 @@ eac_fast(uint a0w, uint a1w)
  * channels together, so for a colour at luma offset s (x3) from a base,
  * |p - (base + m)|^2 = |p - base|^2 - 2 m s + 3 m^2 and the best modifier
  * is the one nearest s / 3 (the palette fit of GunaCharanTeja's
- * csf-v11/214, MIT). Only the chosen indices get the exact (clamped)
+ * csf-v11/218, MIT). Only the chosen indices get the exact (clamped)
  * error, instead of the nearest of the 4 clamped levels for every colour
  * (48 distances per half).
  *
@@ -1918,21 +1921,76 @@ addr_mad(uvec2 a, uint m0, uint m1)
    return a;
 }
 
+/* csf-v11/218, XC_BATCH: the small levels of an upload in one dispatch.
+ * registers.src is a table of up to 16 levels, registers.bw the total
+ * block count, registers.bh the level count; invocation i transcodes
+ * block i of the levels laid end to end. Table: four uvec4 of first block
+ * indices (level k at component k & 3 of word k >> 2), then per level
+ * three uvec4: (src.xy, dst.xy), (raw.xy, src_row_B, dst_row_B),
+ * (raw_row_B, bw, -, -). Whole levels of one layer only (bx0 = by0 = 0). */
+layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer BatchTab {
+    uvec4 data[];
+};
+
 void
 main()
 {
-   uint x = gl_GlobalInvocationID.x;
-   uint y = gl_GlobalInvocationID.y;
-   uint z = gl_GlobalInvocationID.z;
+   uvec2 src = registers.src, dst = registers.dst, raw = registers.raw;
+   uint src_row_B = registers.src_row_B, src_slice_B = registers.src_slice_B;
+   uint dst_row_B = registers.dst_row_B, dst_slice_B = registers.dst_slice_B;
+   uint raw_row_B = registers.raw_row_B, raw_slice_B = registers.raw_slice_B;
+   uint bx0 = registers.bx0, by0 = registers.by0;
+   uint x, y, z;
+
+   if (XC_BATCH != 0u) {
+      uint gi = gl_WorkGroupID.x * (gl_WorkGroupSize.x * gl_WorkGroupSize.y) +
+                gl_LocalInvocationIndex;
+      if (gi >= registers.bw)
+         return;
+      BatchTab tab = BatchTab(registers.src);
+      uint n = registers.bh;
+      uint e = 0u, first = 0u;
+      UNROLL for (uint q = 0u; q < 4u; q++) {
+         uvec4 st = tab.data[q];
+         UNROLL for (uint c = 0u; c < 4u; c++) {
+            uint k = q * 4u + c;
+            if (k < n && st[c] <= gi) {
+               e = k;
+               first = st[c];
+            }
+         }
+      }
+      uvec4 t0 = tab.data[4u + 3u * e];
+      uvec4 t1 = tab.data[5u + 3u * e];
+      uvec4 t2 = tab.data[6u + 3u * e];
+      src = t0.xy;
+      dst = t0.zw;
+      raw = t1.xy;
+      src_row_B = t1.z;
+      dst_row_B = t1.w;
+      raw_row_B = t2.x;
+      uint off = gi - first, lbw = t2.y;
+      y = off / lbw;
+      x = off - y * lbw;
+      z = 0u;
+      src_slice_B = 0u;
+      dst_slice_B = 0u;
+      raw_slice_B = 0u;
+      bx0 = 0u;
+      by0 = 0u;
+   } else {
+      x = gl_GlobalInvocationID.x;
+      y = gl_GlobalInvocationID.y;
+      z = gl_GlobalInvocationID.z;
 
-   if (x >= registers.bw || y >= registers.bh)
-      return;
+      if (x >= registers.bw || y >= registers.bh)
+         return;
+   }
 
    bool wide = !(XC_MODE == U(XC_BC1_RGB) || XC_MODE == U(XC_BC1_RGBA) ||
                  XC_MODE == U(XC_BC4_U) || XC_MODE == U(XC_BC4_S));
 
-   uvec2 sa = addr_mad(addr_mad(registers.src, z, registers.src_slice_B), y,
-                       registers.src_row_B);
+   uvec2 sa = addr_mad(addr_mad(src, z, src_slice_B), y, src_row_B);
    uvec4 w;
    if (wide)
       w = In4(sa).data[x];
@@ -1941,9 +1999,8 @@ main()
 
    /* Upload into a raw-store image (csf-v11/203): keep the BC blocks here
     * instead of a separate copy pass over the source. */
-   if ((registers.raw.x | registers.raw.y) != 0u) {
-      uvec2 ra = addr_mad(addr_mad(registers.raw, z, registers.raw_slice_B),
-                          y, registers.raw_row_B);
+   if ((raw.x | raw.y) != 0u) {
+      uvec2 ra = addr_mad(addr_mad(raw, z, raw_slice_B), y, raw_row_B);
       if (wide)
          Out4(ra).data[x] = w;
       else
@@ -1953,12 +2010,11 @@ main()
    /* U-interleaved: 4x4-block tiles stored linearly per tile row, blocks in
     * a tile at | y1 | x1^y1 | y0 | x0^y0 |. The address is final before
     * the transcode, so only it (not x, y, z) stays live across. */
-   uint bx = registers.bx0 + x, by = registers.by0 + y;
+   uint bx = bx0 + x, by = by0 + y;
    uint ix = bx & 3u, iy = by & 3u;
    uint in_tile = ((iy >> 1) << 3) | (((ix ^ iy) >> 1) << 2) |
                   ((iy & 1u) << 1) | ((ix ^ iy) & 1u);
-   uvec2 da = addr_mad(addr_mad(registers.dst, z, registers.dst_slice_B),
-                       by >> 2, registers.dst_row_B);
+   uvec2 da = addr_mad(addr_mad(dst, z, dst_slice_B), by >> 2, dst_row_B);
    da = addr_mad(da, (bx >> 2) * 16u + in_tile, wide ? 16u : 8u);
 
    transcode_block(XC_MODE, w.x, w.y, w.z, w.w, XC_OPTS);
