+          PANVK_GPU_PRERAST_POLY_NONE)
+      return false;
+
+   if (draw->indirect.buffer_dev_addr)
+      return true;
+
+   return draw->index.index_size && draw->index.restart_enable &&
+          draw->vertex.count > gpu_prerast_max_verts(cmdbuf);
+}
