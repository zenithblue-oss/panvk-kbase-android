From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 22 Oct 2026 06:00:22 +0000
Subject: [PATCH] util/disk_cache: find the Android app cache dir for execve()d
 helpers

csf-v11/203 took the package for the app cache directory from
/proc/self/cmdline, but PanProbe (and any app that runs Vulkan in a
helper it fork()s and execve()s) has the helper's path there,
/data/app/~~<x>/<package>-<y>/lib/arm64/libpt_runner.so. HOME is /data,
so the G615 log still said "Failed to create /data/.cache for shader
cache (Permission denied)---disabling" and every process compiled the
BC transcode pipelines again.

u_android_app_dir.h resolves the app's writable cache directory,
/data/user/<uid / 100000>/<package>/cache or /data/data/<package>/cache,
from the first package that has one: our process name, the parent's
process name, the /data/app path of our binary, or an app directory in
TMPDIR, the current directory or HOME. disk_cache uses it before $HOME,
and on Android an unwritable XDG_CACHE_HOME now falls back to it instead
of disabling the cache. The BC raw store spill uses the same resolver.
MESA_SHADER_CACHE_DIR still wins and still disables the cache when it
cannot be created.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_image.c |  22 +---
 src/util/disk_cache_os.c          |  35 +++--
 src/util/u_android_app_dir.h      | 204 ++++++++++++++++++++++++++++++
 3 files changed, 225 insertions(+), 36 deletions(-)
 create mode 100644 src/util/u_android_app_dir.h

diff --git a/src/panfrost/vulkan/panvk_image.c b/src/panfrost/vulkan/panvk_image.c
index baf506db..af89690e 100644
--- a/src/panfrost/vulkan/panvk_image.c
+++ b/src/panfrost/vulkan/panvk_image.c
@@ -1811,6 +1811,7 @@ panvk_BindImageMemory2(VkDevice device, uint32_t bindInfoCount,
 #include <fcntl.h>
 #include <unistd.h>
 #include "util/detect_os.h"
+#include "util/u_android_app_dir.h"
 #include "util/u_queue.h"
 #include "panvk_priv_bo.h"
 
@@ -1908,26 +1909,13 @@ panvk_bc_raw_rebind(struct panvk_image *image)
    simple_mtx_unlock(&bc_raw_lock);
 }
 
-/* The Android app's cache directory, from the process name (the package,
- * up to a ':' service suffix): /data/user/<user>/<package>/cache. Android
- * app processes cannot write /data/local/tmp. */
+/* The Android app's cache directory (u_android_app_dir.h). Android app
+ * processes cannot write /data/local/tmp. */
 static const char *
 bc_raw_app_cache(char *buf, size_t size)
 {
 #if DETECT_OS_ANDROID
-   char name[256] = {0};
-   int fd = open("/proc/self/cmdline", O_RDONLY | O_CLOEXEC);
-
-   if (fd < 0)
-      return NULL;
-   const ssize_t n = read(fd, name, sizeof(name) - 1);
-   close(fd);
-   if (n <= 0 || !name[0] || name[0] == '/')
-      return NULL;
-   name[strcspn(name, ":")] = 0;
-   snprintf(buf, size, "/data/user/%u/%s/cache", (unsigned)(getuid() / 100000),
-            name);
-   return buf;
+   return u_android_app_cache_dir(buf, size);
 #else
    return NULL;
 #endif
@@ -1941,7 +1929,7 @@ bc_raw_file(struct panvk_device *dev)
    if (dev->bc_raw.fd_plus1)
       return dev->bc_raw.fd_plus1 - 1;
 
-   char app_cache[320];
+   char app_cache[512];
    const char *dirs[] = {
       os_get_option("PANVK_BC_RAW_DIR"),
       getenv("TMPDIR"),
diff --git a/src/util/disk_cache_os.c b/src/util/disk_cache_os.c
index 58904335..bdc1b765 100644
--- a/src/util/disk_cache_os.c
+++ b/src/util/disk_cache_os.c
@@ -37,6 +37,7 @@
 #include "util/u_debug.h"
 #include "util/disk_cache.h"
 #include "util/disk_cache_os.h"
+#include "util/u_android_app_dir.h"
 
 #if DETECT_OS_WINDOWS
 
@@ -932,33 +933,29 @@ disk_cache_generate_cache_dir(void *mem_ctx, const char *gpu_name,
       if (xdg_cache_home) {
          path = concatenate_and_mkdir(mem_ctx, xdg_cache_home, cache_dir_name,
                                       mkdir);
+#if !DETECT_OS_ANDROID
+         /* On Android an unwritable XDG_CACHE_HOME falls back to the app
+          * cache directory below. */
          if (!path)
             return NULL;
+#endif
       }
    }
 
 #if DETECT_OS_ANDROID
-   /* Android app processes have no writable $HOME/.cache, so without this
-    * the cache stayed off and every process compiled its pipelines again
-    * (panvk's BC transcoders cost seconds each). Use the app's cache
-    * directory /data/user/<user>/<package>/cache, from the process name
-    * (up to a ':' service suffix). Falls through to $HOME if it fails. */
+   /* Android app processes usually have no writable $HOME/.cache (HOME is
+    * often /data), so the cache stayed off and every process compiled its
+    * pipelines again (panvk's BC transcoders cost seconds each). Use the
+    * app's cache directory, /data/user/<user>/<package>/cache or
+    * /data/data/<package>/cache. The package comes from the process name,
+    * the parent's (for a helper the app execve()d, whose cmdline is its
+    * path), the /data/app path of the binary or an app directory in
+    * TMPDIR/cwd/HOME (u_android_app_dir.h). Falls through to $HOME. */
    if (!path) {
-      char name[256] = {0}, dir[320];
-      int fd = open("/proc/self/cmdline", O_RDONLY | O_CLOEXEC);
+      char dir[512];
 
-      if (fd >= 0) {
-         const ssize_t n = read(fd, name, sizeof(name) - 1);
-         close(fd);
-         if (n > 0 && name[0] && name[0] != '/') {
-            name[strcspn(name, ":")] = 0;
-            snprintf(dir, sizeof(dir), "/data/user/%u/%s/cache",
-                     (unsigned)(getuid() / 100000), name);
-            if (access(dir, W_OK) == 0)
-               path = concatenate_and_mkdir(mem_ctx, dir, cache_dir_name,
-                                            mkdir);
-         }
-      }
+      if (u_android_app_cache_dir(dir, sizeof(dir)))
+         path = concatenate_and_mkdir(mem_ctx, dir, cache_dir_name, mkdir);
    }
 #endif
 
diff --git a/src/util/u_android_app_dir.h b/src/util/u_android_app_dir.h
new file mode 100644
index 00000000..4ce7d48b
--- /dev/null
+++ b/src/util/u_android_app_dir.h
@@ -0,0 +1,204 @@
+/*
+ * Copyright © 2026 Collabora Ltd.
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Find the writable cache directory of the Android app that owns this
+ * process: /data/user/<uid / 100000>/<package>/cache or
+ * /data/data/<package>/cache.
+ *
+ * The package cannot always be read from /proc/self/cmdline: a helper that
+ * the app fork()s and execve()s (a test runner, a game launcher's native
+ * process) has the path of its binary there, under
+ * /data/app/[~~<hash>/]<package>-<hash>/, and its parent is the app process
+ * whose cmdline is the package (up to a ':' service suffix). The candidates,
+ * in order:
+ *
+ *   1. /proc/self/cmdline when it is a package name,
+ *   2. /proc/<ppid>/cmdline when it is a package name,
+ *   3. the package in the /data/app path of argv[0],
+ *   4. the package in $TMPDIR, the current directory or $HOME when they are
+ *      under /data/user/<n>/<package> or /data/data/<package>.
+ *
+ * The first candidate whose cache directory is writable wins. The parsing
+ * helpers are pure so that tools/android-cache-dir-test can test them on a
+ * host.
+ */
+
+#ifndef U_ANDROID_APP_DIR_H
+#define U_ANDROID_APP_DIR_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A Java package name: letters, digits, '_' and at least one '.', no
+ * leading digit or dot. */
+static inline bool
+u_android_is_package(const char *s, size_t len)
+{
+   bool dot = false;
+
+   if (len == 0 || len >= 224 || s[0] == '.' || (s[0] >= '0' && s[0] <= '9'))
+      return false;
+   for (size_t i = 0; i < len; i++) {
+      const char c = s[i];
+      if (c == '.') {
+         if (s[i - 1] == '.' || i + 1 == len)
+            return false;
+         dot = true;
+      } else if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                   (c >= '0' && c <= '9') || c == '_')) {
+         return false;
+      }
+   }
+   return dot;
+}
+
+/* Copy the package out of a process name ("pkg" or "pkg:service"). */
+static inline bool
+u_android_package_from_procname(const char *name, char *pkg, size_t size)
+{
+   const size_t len = strcspn(name, ":");
+
+   if (len >= size || !u_android_is_package(name, len))
+      return false;
+   memcpy(pkg, name, len);
+   pkg[len] = 0;
+   return true;
+}
+
+/* Copy the package out of a path under /data/app/[~~<x>/]<pkg>-<x>/,
+ * /data/user/<n>/<pkg>, /data/user_de/<n>/<pkg> or /data/data/<pkg>.
+ * Package names have no '-', so the package ends at the first '-' in
+ * /data/app (the hash after it is base64url and may contain one). */
+static inline bool
+u_android_package_from_path(const char *path, char *pkg, size_t size)
+{
+   const char *p = NULL;
+   char end = '/';
+
+   if (!path)
+      return false;
+   if (!strncmp(path, "/data/app/", 10)) {
+      p = path + 10;
+      if (p[0] == '~' && p[1] == '~') {
+         p = strchr(p, '/');
+         if (!p)
+            return false;
+         p++;
+      }
+      end = '-';
+   } else if (!strncmp(path, "/data/data/", 11)) {
+      p = path + 11;
+   } else if (!strncmp(path, "/data/user/", 11) ||
+              !strncmp(path, "/data/user_de/", 14)) {
+      p = path + (path[10] == '/' ? 11 : 14);
+      if (*p < '0' || *p > '9')
+         return false;
+      while (*p >= '0' && *p <= '9')
+         p++;
+      if (*p != '/')
+         return false;
+      p++;
+   } else {
+      return false;
+   }
+
+   size_t len = 0;
+   while (p[len] && p[len] != '/' && p[len] != end)
+      len++;
+   /* /data/app/<pkg>-<x>: the '-' is required. */
+   if (end == '-' && p[len] != '-')
+      return false;
+   if (len >= size || !u_android_is_package(p, len))
+      return false;
+   memcpy(pkg, p, len);
+   pkg[len] = 0;
+   return true;
+}
+
+#if defined(__ANDROID__) || defined(U_ANDROID_APP_DIR_TEST)
+
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#ifndef U_ANDROID_APP_DIR_ROOT
+#define U_ANDROID_APP_DIR_ROOT ""
+#endif
+
+static inline ssize_t
+u_android_read_file(const char *file, char *buf, size_t size)
+{
+   int fd = open(file, O_RDONLY | O_CLOEXEC);
+
+   if (fd < 0)
+      return -1;
+   const ssize_t n = read(fd, buf, size - 1);
+   close(fd);
+   buf[n > 0 ? n : 0] = 0;
+   return n;
+}
+
+/* Writable cache directory of the package, or false. */
+static inline bool
+u_android_package_cache_dir(const char *pkg, unsigned uid, char *buf,
+                            size_t size)
+{
+   snprintf(buf, size, U_ANDROID_APP_DIR_ROOT "/data/user/%u/%s/cache",
+            uid / 100000, pkg);
+   if (access(buf, W_OK) == 0)
+      return true;
+   snprintf(buf, size, U_ANDROID_APP_DIR_ROOT "/data/data/%s/cache", pkg);
+   return access(buf, W_OK) == 0;
+}
+
+/* The app's writable cache directory, in buf, or NULL. */
+static inline const char *
+u_android_app_cache_dir(char *buf, size_t size)
+{
+   char name[512], pkg[256], file[64];
+   const unsigned uid = (unsigned)getuid();
+
+   /* 1, 3: our own cmdline (a package or an execve()d helper's path). */
+   if (u_android_read_file("/proc/self/cmdline", name, sizeof(name)) > 0) {
+      if (u_android_package_from_procname(name, pkg, sizeof(pkg)) &&
+          u_android_package_cache_dir(pkg, uid, buf, size))
+         return buf;
+      if (u_android_package_from_path(name, pkg, sizeof(pkg)) &&
+          u_android_package_cache_dir(pkg, uid, buf, size))
+         return buf;
+   }
+
+   /* 2: the parent, for a helper forked by the app process. */
+   snprintf(file, sizeof(file), "/proc/%d/cmdline", (int)getppid());
+   if (u_android_read_file(file, name, sizeof(name)) > 0 &&
+       u_android_package_from_procname(name, pkg, sizeof(pkg)) &&
+       u_android_package_cache_dir(pkg, uid, buf, size))
+      return buf;
+
+   /* 4: directories that the app handed down. */
+   const char *dirs[] = { getenv("TMPDIR"), NULL, getenv("HOME") };
+   if (getcwd(name, sizeof(name)))
+      dirs[1] = name;
+   for (unsigned i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+      if (u_android_package_from_path(dirs[i], pkg, sizeof(pkg)) &&
+          u_android_package_cache_dir(pkg, uid, buf, size))
+         return buf;
+   }
+   return NULL;
+}
+
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
-- 
2.55.0

