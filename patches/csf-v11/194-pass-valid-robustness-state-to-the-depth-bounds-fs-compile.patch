From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Fri, 16 Oct 2026 19:00:00 +0530
Subject: [PATCH] panvk: pass a valid robustness state to the depth-bounds FS
 compile biblioklept

panvk_create_depth_bounds_fs() compiled the internal depth-bounds
fragment shader with a zeroed vk_pipeline_robustness_state. Zero is
VK_PIPELINE_ROBUSTNESS_*_DEVICE_DEFAULT_EXT, which
panvk_buffer_ubo_addr_format() and panvk_buffer_ssbo_addr_format()
treat as invalid: they hit UNREACHABLE("Invalid robust buffer access
behavior") in debug builds, and are undefined behaviour in release
builds that happens to work.

Use the same all-DISABLED state as panvk_create_shader(), through a
helper declared in panvk_vX_clip_vp.h and defined at the end of
panvk_vX_shader.c, so the shader.c edit replaces one line with one line
and the jm-v9 hunks applied after it keep their line numbers.

Build-only; not device-tested.

Generated-by: LLM
---
 src/panfrost/vulkan/panvk_vX_clip_vp.h |  4 ++++
 src/panfrost/vulkan/panvk_vX_shader.c  | 17 ++++++++++++++++-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/vulkan/panvk_vX_clip_vp.h b/src/panfrost/vulkan/panvk_vX_clip_vp.h
index 9a350b1..0e9babe 100644
--- a/src/panfrost/vulkan/panvk_vX_clip_vp.h
+++ b/src/panfrost/vulkan/panvk_vX_clip_vp.h
@@ -63,4 +63,8 @@ static nir_shader *
 panvk_fixup_gs_passthrough(const struct panvk_gpu_prerast_gs_info *gs,
                            const nir_shader *gs_nir, nir_shader *pt);
 
+struct vk_pipeline_robustness_state;
+UNUSED static struct vk_pipeline_robustness_state
+panvk_internal_robustness(void);
+
 #endif /* PANVK_VX_CLIP_VP_H */
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index d9a23ef..74a6531 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -4814,7 +4814,7 @@ panvk_per_arch(create_depth_bounds_fs)(struct panvk_device *dev)
       "panvk-depth-bounds-fs");
    b.shader->info.internal = true;
 
-   const struct vk_pipeline_robustness_state rs = {0};
+   const struct vk_pipeline_robustness_state rs = panvk_internal_robustness();
    struct vk_shader_compile_info info = {
       .stage = MESA_SHADER_FRAGMENT,
       .nir = b.shader,
@@ -5271,3 +5271,18 @@ panvk_fixup_gs_passthrough(UNUSED const struct panvk_gpu_prerast_gs_info *gs,
    return pt;
 }
 #endif
+
+/* Robustness for internal shaders that have no buffer, image or vertex input
+ * access. A zeroed state is DEVICE_DEFAULT, which the address format
+ * helpers reject.
+ */
+UNUSED static struct vk_pipeline_robustness_state
+panvk_internal_robustness(void)
+{
+   return (struct vk_pipeline_robustness_state){
+      .images = VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_DISABLED_EXT,
+      .storage_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED_EXT,
+      .uniform_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED_EXT,
+      .vertex_inputs = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED_EXT,
+   };
+}
