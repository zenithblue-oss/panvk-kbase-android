From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Wed, 21 Oct 2026 06:22:00 +0000
Subject: [PATCH] wsi/x11: create the surface when the window is already gone

vkCreateXlibSurfaceKHR and vkCreateXcbSurfaceKHR looked up the window
visual (query_tree + get_window_attributes) and returned
VK_ERROR_OUT_OF_HOST_MEMORY when it could not be found. That happens
whenever the X window has been destroyed or is going away (app exit,
backgrounding in the launcher's X server), not on allocation failure.
DXVK's presenter, after VK_ERROR_OUT_OF_DATE_KHR and SURFACE_LOST from
the capability query, re-creates the surface and got OOHM, logged as
"Failed to create Vulkan surface: VK_ERROR_OUT_OF_HOST_MEMORY"
(PanPlay, 11 sessions on v9-v13, Just Cause 2 twice on G68).

Surface creation has no SURFACE_LOST code, so create the surface
anyway, as opaque (has_alpha = false), and let its queries report
VK_ERROR_SURFACE_LOST_KHR: x11_surface_get_capabilities already does
when xcb_get_geometry fails. The visual is only used for the composite
alpha caps. OOHM remains for a real allocation failure (and for the
libxcb dlopen failure, as before). Also free the xcb error of a failed
get_geometry in the capability query (leaked once per query).
---
 src/vulkan/wsi/wsi_common_x11.c | 22 +++++++++++++++-------
 1 file changed, 15 insertions(+), 7 deletions(-)

diff --git a/src/vulkan/wsi/wsi_common_x11.c b/src/vulkan/wsi/wsi_common_x11.c
index eb1801f..25d2619 100644
--- a/src/vulkan/wsi/wsi_common_x11.c
+++ b/src/vulkan/wsi/wsi_common_x11.c
@@ -793,8 +793,10 @@ x11_surface_get_capabilities(VkIcdSurfaceBase *icd_surface,
    geom_cookie = xcb_get_geometry(conn, window);
 
    geom = xcb_get_geometry_reply(conn, geom_cookie, &err);
-   if (!geom)
+   if (!geom) {
+      free(err);
       return VK_ERROR_SURFACE_LOST_KHR;
+   }
    {
       VkExtent2D extent = { geom->width, geom->height };
       caps->surfaceCapabilities.currentExtent = extent;
@@ -1173,8 +1175,11 @@ wsi_CreateXcbSurfaceKHR(VkInstance _instance,
    unsigned visual_depth;
    xcb_visualtype_t *visual =
       get_visualtype_for_window(pCreateInfo->connection, pCreateInfo->window, &visual_depth, NULL);
-   if (!visual)
-      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   /* No visual means the window is already gone (destroyed or never
+    * mapped by the X server): that is not an allocation failure, and
+    * vkCreate*SurfaceKHR has no SURFACE_LOST code. Create the surface
+    * anyway, opaque; its queries and swapchain creation then report
+    * VK_ERROR_SURFACE_LOST_KHR, which apps handle (DXVK retries). */
 
    surface = vk_alloc2(&instance->alloc, pAllocator, sizeof(struct wsi_x11_vk_surface), 8,
                        VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
@@ -1185,7 +1190,7 @@ wsi_CreateXcbSurfaceKHR(VkInstance _instance,
    surface->xcb.connection = pCreateInfo->connection;
    surface->xcb.window = pCreateInfo->window;
 
-   surface->has_alpha = visual_has_alpha(visual, visual_depth);
+   surface->has_alpha = visual && visual_has_alpha(visual, visual_depth);
 
    *pSurface = VkIcdSurfaceBase_to_handle(&surface->xcb.base);
    return VK_SUCCESS;
@@ -1208,8 +1213,11 @@ wsi_CreateXlibSurfaceKHR(VkInstance _instance,
    unsigned visual_depth;
    xcb_visualtype_t *visual =
       get_visualtype_for_window(XGetXCBConnection(pCreateInfo->dpy), pCreateInfo->window, &visual_depth, NULL);
-   if (!visual)
-      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   /* No visual means the window is already gone (destroyed or never
+    * mapped by the X server): that is not an allocation failure, and
+    * vkCreate*SurfaceKHR has no SURFACE_LOST code. Create the surface
+    * anyway, opaque; its queries and swapchain creation then report
+    * VK_ERROR_SURFACE_LOST_KHR, which apps handle (DXVK retries). */
 
    surface = vk_alloc2(&instance->alloc, pAllocator, sizeof(struct wsi_x11_vk_surface), 8,
                        VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
@@ -1220,7 +1228,7 @@ wsi_CreateXlibSurfaceKHR(VkInstance _instance,
    surface->xlib.dpy = pCreateInfo->dpy;
    surface->xlib.window = pCreateInfo->window;
 
-   surface->has_alpha = visual_has_alpha(visual, visual_depth);
+   surface->has_alpha = visual && visual_has_alpha(visual, visual_depth);
 
    *pSurface = VkIcdSurfaceBase_to_handle(&surface->xlib.base);
    return VK_SUCCESS;
-- 
