+      panvk_priv_bo_flush(bo, 0, PANVK_BC_EAC_TABLE_B);
+      dev->bc.eac_lut[kind] = bo;
+   }
+   if (bo)
+      addr = bo->addr.dev;
+   simple_mtx_unlock(&bc_dev_lock);
+   return addr;
