--- /dev/null
+++ b/src/panfrost/vulkan/bc/panvk_bc_eac_lut.h
@@ -0,0 +1,160 @@
+/*
+ * Copyright 2026 PanVK-kbase contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * BC4 endpoint pair -> EAC block header table of the fast BC3-alpha / BC4 /
+ * BC5 transcode (csf-v11/206). The idea (one table entry per BC4 endpoint
+ * pair, then a per-entry remap to the nearest EAC level) is adapted from
+ * GunaCharanTeja/panvk-kbase-android csf-v11/213 and 219 (MIT).
+ *
+ * A BC4 block's palette is a function of its two endpoint bytes only, so
+ * the EAC (base, multiplier, table) that fits the palette best, and the
+ * EAC index of every palette entry, are too. panvk_bc_eac_lut_hdr[kind]
+ * (panvk_bc_eac_lut_data.h, generated by panvk_bc_eac_lutgen.c) holds the
+ * first two bytes of the EAC block per (e0 | e1 << 8); the driver expands
+ * it once per kind into the table the shader reads (panvk_bc_eac_expand()):
+ * two words per key, the EAC header and the 24-bit map palette entry k ->
+ * EAC index at bits 3k. The shader then needs one load per block and a
+ * remap of the 16 BC indices.
+ *
+ * kind 0: ETC2 alpha (BC3), 1: R11 (BC4/BC5 UNORM), 2: signed R11 (SNORM).
+ * The palette arithmetic is bc_decode_rgtc() of panvk_bc_etc2.comp.
+ */
+#ifndef PANVK_BC_EAC_LUT_H
+#define PANVK_BC_EAC_LUT_H
+
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#define PANVK_BC_EAC_KINDS 3
+#define PANVK_BC_EAC_KEYS 65536
+/* Size of one expanded kind table. */
+#define PANVK_BC_EAC_TABLE_B (PANVK_BC_EAC_KEYS * 8u)
+
+static const int panvk_bc_eac_mod[16][8] = {
+   {-3, -6, -9, -15, 2, 5, 8, 14},  {-3, -7, -10, -13, 2, 6, 9, 12},
+   {-2, -5, -8, -13, 1, 4, 7, 12},  {-2, -4, -6, -13, 1, 3, 5, 12},
+   {-3, -6, -8, -12, 2, 5, 7, 11},  {-3, -7, -9, -11, 2, 6, 8, 10},
+   {-4, -7, -8, -11, 3, 6, 7, 10},  {-3, -5, -8, -11, 2, 4, 7, 10},
+   {-2, -6, -8, -10, 1, 5, 7, 9},   {-2, -5, -8, -10, 1, 4, 7, 9},
+   {-2, -4, -8, -10, 1, 3, 7, 9},   {-2, -5, -7, -10, 1, 4, 6, 9},
+   {-3, -4, -7, -10, 2, 3, 6, 9},   {-1, -2, -3, -10, 0, 1, 2, 9},
+   {-4, -6, -8, -9, 3, 5, 7, 8},    {-3, -5, -7, -9, 2, 4, 6, 8},
+};
+
+static inline int
+panvk_bc_eac_rnd(float x)
+{
+   return (int)floorf(x + 0.5f);
+}
+
+static inline int
+panvk_bc_eac_out(float res, int kind)
+{
+   int v;
+   if (kind == 0) {
+      v = panvk_bc_eac_rnd(res * 255.0f);
+      return v < 0 ? 0 : v > 255 ? 255 : v;
+   }
+   if (kind == 1) {
+      v = panvk_bc_eac_rnd(res * 2047.0f);
+      return v < 0 ? 0 : v > 2047 ? 2047 : v;
+   }
+   v = panvk_bc_eac_rnd(res * 1023.0f);
+   return v < -1023 ? -1023 : v > 1023 ? 1023 : v;
+}
+
+/* Palette of the BC4 endpoint pair key in the EAC domain of kind. */
+static inline void
+panvk_bc_eac_palette(unsigned key, int kind, int pv[8])
+{
+   const unsigned a0 = key & 0xffu, a1 = key >> 8;
+   float ep0, ep1;
+
+   if (kind == 2) {
+      ep0 = fmaxf((float)(int8_t)a0 / 127.0f, -1.0f);
+      ep1 = fmaxf((float)(int8_t)a1 / 127.0f, -1.0f);
+   } else {
+      ep0 = (float)a0 / 255.0f;
+      ep1 = (float)a1 / 255.0f;
+   }
+   pv[0] = panvk_bc_eac_out(ep0, kind);
+   pv[1] = panvk_bc_eac_out(ep1, kind);
+   if (ep0 > ep1) {
+      for (int i = 1; i <= 6; i++)
+         pv[1 + i] = panvk_bc_eac_out(
+            ep0 + (ep1 - ep0) * ((1.0f / 7.0f) * (float)i), kind);
+   } else {
+      for (int i = 1; i <= 4; i++)
+         pv[1 + i] = panvk_bc_eac_out(
+            ep0 + (ep1 - ep0) * ((1.0f / 5.0f) * (float)i), kind);
+      pv[6] = panvk_bc_eac_out(kind == 2 ? -1.0f : 0.0f, kind);
+      pv[7] = panvk_bc_eac_out(1.0f, kind);
+   }
+}
+
+/* The 8 EAC levels of a header (base byte | (mult << 4 | table) << 8). */
+static inline void
+panvk_bc_eac_levels(unsigned hdr, int kind, int lv[8])
+{
+   const int t = (hdr >> 8) & 15, m = (hdr >> 12) & 15;
+   const int base = kind == 2 ? (int)(int8_t)(hdr & 0xffu) : (int)(hdr & 0xffu);
+
+   for (int j = 0; j < 8; j++) {
+      const int mod = panvk_bc_eac_mod[t][j];
+      int v;
+      if (kind == 0) {
+         v = base + mod * m;
+         lv[j] = v < 0 ? 0 : v > 255 ? 255 : v;
+      } else {
+         v = base * 8 + (kind == 1 ? 4 : 0) + (m == 0 ? mod : mod * m * 8);
+         lv[j] = kind == 1 ? (v < 0 ? 0 : v > 2047 ? 2047 : v)
+                           : (v < -1023 ? -1023 : v > 1023 ? 1023 : v);
+      }
+   }
+}
+
+/* Palette entry k -> nearest EAC index, 3 bits each (first on ties). */
+static inline uint32_t
+panvk_bc_eac_map(const int pv[8], const int lv[8])
+{
+   uint32_t map = 0;
+   for (int k = 0; k < 8; k++) {
+      int best = 0, e = abs(lv[0] - pv[k]);
+      for (int j = 1; j < 8; j++) {
+         const int d = abs(lv[j] - pv[k]);
+         if (d < e) {
+            e = d;
+            best = j;
+         }
+      }
+      map |= (uint32_t)best << (3 * k);
+   }
+   return map;
+}
+
+/* The data is compiled once, in panvk_image.c (panvk_bc_eac_expand_table()),
+ * and in the host tests; the per-arch files define PANVK_BC_EAC_NO_DATA. */
+#if !defined(PANVK_BC_EAC_LUTGEN) && !defined(PANVK_BC_EAC_NO_DATA)
+#include "panvk_bc_eac_lut_data.h"
+
+/* Expand the header table of kind into out[2 * 65536]: header, map. */
+static inline void
+panvk_bc_eac_expand(int kind, uint32_t *out)
+{
+   const uint32_t *hdr = panvk_bc_eac_lut_hdr[kind];
+
+   for (unsigned key = 0; key < PANVK_BC_EAC_KEYS; key++) {
+      const unsigned h = (hdr[key >> 1] >> (16 * (key & 1))) & 0xffffu;
+      int pv[8], lv[8];
+
+      panvk_bc_eac_palette(key, kind, pv);
+      panvk_bc_eac_levels(h, kind, lv);
+      out[2 * key] = h;
+      out[2 * key + 1] = panvk_bc_eac_map(pv, lv);
+   }
+}
+#endif
+
+#endif
