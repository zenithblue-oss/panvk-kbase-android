 src/panfrost/libpan/fan_chunks.cl           | 43 +++++++++++++++++++++
 src/panfrost/libpan/meson.build             |  1 +
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 19 +++++++++
 3 files changed, 63 insertions(+)
 create mode 100644 src/panfrost/libpan/fan_chunks.cl

diff --git a/src/panfrost/libpan/fan_chunks.cl b/src/panfrost/libpan/fan_chunks.cl
new file mode 100644
index 0000000..cb6a714
--- /dev/null
+++ b/src/panfrost/libpan/fan_chunks.cl
@@ -0,0 +1,43 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "compiler/libcl/libcl.h"
+#include "compiler/libcl/libcl_vk.h"
+#include "compiler/shader_enums.h"
+#include "genxml/gen_macros.h"
+
+#if PAN_ARCH >= 10
+
+/* An indirect fan lowered in one pass (not chunked): clamps its counts to
+ * what the arena holds, so the triangles past it are dropped instead of
+ * drawn from stale records and indices. The words are the lowered VS
+ * params (vertex count, instance count, vertices per instance), its
+ * dispatch grid and the generated draw.
+ */
+KERNEL(1)
+panlib_fan_clamp_draw(global uint32_t *vertex_count,
+                      global uint32_t *instance_count,
+                      global uint32_t *verts_per_instance,
+                      global uint32_t *dispatch, global uint32_t *gen_draw,
+                      uint32_t cap)
+{
+   uint32_t n = *vertex_count, k = *instance_count;
+
+   if ((uint64_t)n * k <= cap)
+      return;
+
+   n = min(n, cap);
+   k = min(k, cap / n);
+
+   *vertex_count = n;
+   *instance_count = k;
+   *verts_per_instance = n;
+   dispatch[0] = n;
+   dispatch[1] = k;
+   gen_draw[0] = n;
+   gen_draw[1] = k;
+}
+
+#endif
diff --git a/src/panfrost/libpan/meson.build b/src/panfrost/libpan/meson.build
index f035f4a..e266a47 100644
--- a/src/panfrost/libpan/meson.build
+++ b/src/panfrost/libpan/meson.build
@@ -6,6 +6,7 @@ libpan_shader_files = files(
   'libpan_copy.cl',
   'query_pool.cl',
   'draw_helper.cl',
+  'fan_chunks.cl',
   'indirect_dispatch.cl',
 )
 
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index f4c1b7e..1b63788 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -4304,6 +4304,25 @@ gpu_prerast_vs(struct panvk_cmd_buffer *cmdbuf,
       cs_flush_stores(compute);
    }
 
+   /* An indirect fan lowered in one pass draws what fits the arena. The
+    * rest has no records or generated indices: drop it.
+    */
+   if (source->indirect.buffer_dev_addr && !chunk_addr &&
+       source->prim == MESA_PRIM_TRIANGLE_FAN) {
+      struct panvk_precomp_ctx ctx = panvk_per_arch(precomp_cs)(cmdbuf);
+
+      panlib_fan_clamp_draw(
+         &ctx, panlib_1d(1), PANLIB_BARRIER_NONE,
+         params + offsetof(struct panvk_gpu_prerast_params, vertex_count),
+         params + offsetof(struct panvk_gpu_prerast_params, instance_count),
+         params + offsetof(struct panvk_gpu_prerast_params,
+                           vertex.verts_per_instance),
+         dispatch_params, generated_draw,
+         panvk_gpu_prerast_record_capacity(
+            shader->gpu_prerast.io.record_stride));
+      cs_wait_slots(compute, dev->csf.sb.all_iters_mask);
+   }
+
    struct panvk_dispatch_info dispatch = {
       .direct.wg_count = {vertex_count, instance_count, 1},
       .barrier = barrier,
