From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Fri, 16 Oct 2026 12:00:00 +0530
Subject: [PATCH] kbase: retry dma-buf MEM_IMPORT with the MTK SLC layout
 biblioklept

Mali-G1-Ultra (v14, MT6993, CSF uAPI 1.38) returns ENOTTY for
KBASE_IOCTL_MEM_IMPORT, so vkCreateSwapchainKHR fails with
VK_ERROR_INVALID_EXTERNAL_HANDLE and 32-bit DXVK games cannot start.

The ioctl number is unchanged. MediaTek's kbase (a16w, mt6993.fragment:
CONFIG_MALI_MTK_SLC_DYNAMIC_POLICY_V2=y) adds PBHA hint fields to
union kbase_ioctl_mem_import (in: vkAllocateMemoryCallID, numOfPlanes,
in_pbha_8bit; out: out_pbha_8bit), making it 40 bytes instead of 24.
_IOWR encodes the size, so the Arm 24-byte request matches no case and
the kernel returns ENOTTY. The same config grows MEM_ALLOC_EX to 72
bytes, which is the root cause of the ALLOC_EX ENOTTY (csf-v11/110).

On ENOTTY, retry with the 40-byte layout and zeroed extras
(vkAllocateMemoryCallID == 0 is the kernel's "no PBHA hint" path), then
latch the layout for the process. Arm kernels are unchanged: the first
ioctl succeeds and is logged once as "mem_import via MEM_IMPORT".

Build-only; no v14 device was available.
---
 src/panfrost/lib/kmod/kbase_kmod.c | 59 +++++++++++++++++++++++++++++-
 1 file changed, 58 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index fc46dcce332..35038beb645 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -2042,7 +2042,64 @@ kbase_kmod_import_dmabuf(struct pan_kmod_dev *dev,
       },
    };
 
-   if (ioctl(dev->fd, KBASE_IOCTL_MEM_IMPORT, &req)) {
+   /* MediaTek kbase built with CONFIG_MALI_MTK_SLC_DYNAMIC_POLICY_V2 (MT6993
+    * Mali-G1-Ultra, CSF uAPI 1.38) appends PBHA hint fields to both halves of
+    * union kbase_ioctl_mem_import, so it is 40 bytes there and the Arm
+    * 24-byte _IOWR encoding is unknown to the kernel (ENOTTY).  Retry with
+    * the 40-byte layout; zeroed extras select the "no PBHA hint" path.
+    * Latched per process: 0 unknown, 1 Arm layout, 2 MTK layout. */
+   static uint32_t import_layout;
+   int ret = -1;
+
+   if (p_atomic_read(&import_layout) != 2) {
+      ret = ioctl(dev->fd, KBASE_IOCTL_MEM_IMPORT, &req);
+      if (!ret && p_atomic_cmpxchg(&import_layout, 0, 1) == 0)
+         mesa_logi("kbase: mem_import via MEM_IMPORT (24 bytes)");
+   }
+
+   if (ret && (p_atomic_read(&import_layout) == 2 || errno == ENOTTY)) {
+      union {
+         struct {
+            uint64_t flags;
+            uint64_t phandle;
+            uint32_t type;
+            uint32_t padding;
+            uint32_t vk_allocate_memory_call_id;
+            uint8_t num_planes;
+            uint8_t pbha_8bit;
+            uint8_t alignment[6];
+         } in;
+         struct {
+            uint64_t flags;
+            uint64_t gpu_va;
+            uint64_t va_pages;
+            uint8_t pbha_8bit;
+            uint8_t alignment[7];
+         } out;
+      } mreq = {
+         .in = {
+            .flags = req.in.flags,
+            .phandle = req.in.phandle,
+            .type = req.in.type,
+         },
+      };
+      static_assert(sizeof(mreq) == 40, "MTK SLC mem_import layout");
+
+      if (p_atomic_read(&import_layout) != 2)
+         mesa_logw("kbase: KBASE_IOCTL_MEM_IMPORT failed: %s; trying the "
+                   "MTK SLC layout", strerror(errno));
+      ret = ioctl(dev->fd, _IOWR(KBASE_IOCTL_TYPE, 22, __typeof__(mreq)),
+                  &mreq);
+      if (!ret) {
+         req.out.flags = mreq.out.flags;
+         req.out.gpu_va = mreq.out.gpu_va;
+         req.out.va_pages = mreq.out.va_pages;
+         if (p_atomic_cmpxchg(&import_layout, 0, 2) == 0)
+            mesa_logi("kbase: mem_import via MTK SLC layout (40 bytes)");
+      }
+   }
+
+   if (ret) {
       mesa_loge("kbase: KBASE_IOCTL_MEM_IMPORT failed: %s", strerror(errno));
       goto err_close_dmabuf;
    }
