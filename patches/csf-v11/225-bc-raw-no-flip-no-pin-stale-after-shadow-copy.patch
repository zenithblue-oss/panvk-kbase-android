From 29fd44839bc062e92b390ac1929dadebf51b7641 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Sat, 24 Oct 2026 00:29:19 +0000
Subject: [PATCH 225/229] panvk: BC raw stores: no device-wide flip, no
 pinning, stale raw blocks after a shadow-only copy

Rationale (fo4-memory-analysis sections 2.1, 4): Fallout 4 on the G615
shows a black head on an NPC after minutes of play under memory pressure,
and the BC raw stores can grow up to the whole BC texture size.

1. Black head: a BC -> BC copy from a lazy image (csf-v11 207) copies only
   the ETC2/EAC shadow, so a destination with raw blocks (a raw store or
   the in-image raw plane) keeps zero blocks that no longer match its
   shadow. A second copy from that image (DXVK relocating a texture twice
   under budget pressure) then copied and decoded those zero blocks: black
   ETC2, and EAC normals of (-1, -1) that light to black. The destination
   is now marked bc_raw_stale: raw reads of it take the lazy path (shadow
   copy when the shadows match, else skipped and counted) until a raw
   write covers the whole image. PANVK_BC_RAW_STALE=0 = old.
2. The first skipped lazy read switched every BC image created later to
   raw stores (bc_raw.needed) without making that read exact. Now the read
   is skipped and counted (PANVK_DEBUG=mem lazy_skips, logged 4 times and
   then at powers of two), and no image changes mode. PANVK_BC_RAW_FLIP=1
   = old.
3. A raw store read back from the spill file twice was pinned resident for
   good; DXVK touches streamed textures in several command lists, so most
   stores of a long session ended up pinned. PANVK_BC_RAW_PIN=<n> pins
   after n read-backs; default 0 = never (2 = old).

PANVK_BC_RAW=store still keeps raw blocks for every readable image (exact
readback). Arch: v10+ (the BC lowmem paths); the new checks in shared meta
code are false on v6/v7/v9, where bc_raw_lazy and bc_raw_stale stay unset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_image.c       | 20 ++++++-
 src/panfrost/vulkan/panvk_image.h       |  6 ++
 src/panfrost/vulkan/panvk_vX_cmd_meta.c | 74 ++++++++++++++++++++++---
 3 files changed, 90 insertions(+), 10 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_image.c b/src/panfrost/vulkan/panvk_image.c
index efa3faa6..7bf98c5c 100644
--- a/src/panfrost/vulkan/panvk_image.c
+++ b/src/panfrost/vulkan/panvk_image.c
@@ -959,6 +959,7 @@ panvk_image_init(struct panvk_image *image,
    image->bc_no_raw = false;
    image->bc_raw_store = false;
    image->bc_raw_lazy = false;
+   image->bc_raw_stale = false;
    if (image->bc_gfx && panvk_bc_lowmem_enabled(phys_dev) &&
        panvk_bc_lowmem_allowed(image, pCreateInfo)) {
       const VkFormat lm_format = panvk_bc_lowmem_format(image->vk.format);
@@ -2110,6 +2111,23 @@ out:
    simple_mtx_unlock(&bc_raw_lock);
 }
 
+/* csf-v11 225: a store read back from the spill file this many times stays
+ * resident for good. DXVK touches streamed textures (uploads per mip,
+ * relocation copies) in several command lists, so the old limit of 2
+ * pinned most raw stores of a long session in memory.
+ * PANVK_BC_RAW_PIN=<n> (default 0 = never pin; 2 = old). */
+static uint32_t
+bc_raw_pin_after(void)
+{
+   static int64_t v = -1;
+
+   if (p_atomic_read(&v) < 0) {
+      int64_t n = debug_get_num_option("PANVK_BC_RAW_PIN", 0);
+      p_atomic_set(&v, n <= 0 ? (int64_t)UINT32_MAX : MIN2(n, UINT32_MAX));
+   }
+   return (uint32_t)p_atomic_read(&v);
+}
+
 /* Called with bc_raw_lock held. full: the caller overwrites every block,
  * so the old contents are neither read back nor zeroed. */
 static VkResult
@@ -2139,7 +2157,7 @@ bc_raw_materialize(struct panvk_bc_raw *raw, bool full)
                    strerror(errno));
       } else {
          p_atomic_inc(&panvk_mem_stats.bc_remats);
-         if (++raw->remat >= 2) {
+         if (++raw->remat >= bc_raw_pin_after()) {
             raw->pinned = true;
             p_atomic_inc(&panvk_mem_stats.bc_pins);
          }
diff --git a/src/panfrost/vulkan/panvk_image.h b/src/panfrost/vulkan/panvk_image.h
index 0432d7aa..00114e43 100644
--- a/src/panfrost/vulkan/panvk_image.h
+++ b/src/panfrost/vulkan/panvk_image.h
@@ -97,6 +97,12 @@ struct panvk_image {
     * (copy to memory, to a non-BC or differently shadowed image) is
     * skipped, logged, and switches the device to raw stores. */
    bool bc_raw_lazy;
+   /* csf-v11 225: a shadow-only BC -> BC copy (bc_copy_image_shadow) wrote
+    * the shadow of this image but not its raw blocks, which still hold
+    * zeros or older data. Raw reads treat it like bc_raw_lazy (shadow copy
+    * or skip) instead of decoding those blocks, until a raw write covers
+    * the whole image again. */
+   bool bc_raw_stale;
 };
 
 VK_DEFINE_NONDISP_HANDLE_CASTS(panvk_image, vk.base, VkImage,
diff --git a/src/panfrost/vulkan/panvk_vX_cmd_meta.c b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
index c88e1ea6..a11537d1 100644
--- a/src/panfrost/vulkan/panvk_vX_cmd_meta.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
@@ -1568,6 +1568,8 @@ panvk_per_arch(device_bc_finish)(struct panvk_device *dev)
    vk_meta_device_finish(&dev->vk, &dev->meta);
 }
 
+static void bc_raw_written(struct panvk_image *img, bool full);
+
 /* csf-v11/201: make the raw blocks of a raw-store image resident for this
  * command buffer before any raw access. full: the access overwrites every
  * block (no read-back of a spilled store). False if that failed (the
@@ -1794,6 +1796,7 @@ panvk_per_arch(CmdCopyMemoryToImageKHR)(
       bool keep_raw = false;
       if (!bc_img->bc_no_raw &&
           bc_raw_use(cmdbuf, bc_img, true, bc_blocks_full(bc_img, blocks))) {
+         bc_raw_written(bc_img, bc_blocks_full(bc_img, blocks));
          if (fuse)
             keep_raw = true;
          else
@@ -1928,11 +1931,46 @@ copy_memory_to_image_raw(
 static void
 bc_raw_lazy_hit(struct panvk_device *dev, const char *what)
 {
-   p_atomic_inc(&panvk_mem_stats.bc_lazy_skips);
-   if (!p_atomic_xchg(&dev->bc_raw.needed, 1))
-      mesa_logw("panvk: %s of a BC image without raw blocks skipped; BC "
-                "images created from now on keep them (PANVK_BC_RAW=store "
-                "keeps them from the start)", what);
+   /* csf-v11 225: PANVK_BC_RAW_FLIP=1 (old): the first such read switches
+    * every BC image created later to raw stores. Default 0: the reads are
+    * skipped and counted (PANVK_DEBUG=mem), and no image changes mode; the
+    * flip cost up to the whole BC texture size in raw stores and did not
+    * make the skipped read exact. */
+   static int flip = -1;
+   if (p_atomic_read(&flip) < 0)
+      p_atomic_set(&flip, debug_get_bool_option("PANVK_BC_RAW_FLIP", false));
+
+   const uint64_t n = p_atomic_inc_return(&panvk_mem_stats.bc_lazy_skips);
+   if (p_atomic_read(&flip)) {
+      if (!p_atomic_xchg(&dev->bc_raw.needed, 1))
+         mesa_logw("panvk: %s of a BC image without raw blocks skipped; BC "
+                   "images created from now on keep them (PANVK_BC_RAW=store "
+                   "keeps them from the start)", what);
+   } else if (n <= 4 || util_is_power_of_two_nonzero64(n)) {
+      mesa_logw("panvk: %s of a BC image without raw blocks skipped (%" PRIu64
+                " so far; PANVK_BC_RAW=store keeps raw blocks)", what, n);
+   }
+}
+
+/* csf-v11 225: raw blocks that do not match the shadow (bc_raw_stale). */
+static bool
+bc_raw_unreadable(const struct panvk_image *img)
+{
+   if (img->bc_raw_lazy)
+      return true;
+   if (p_atomic_read(&img->bc_raw_stale)) {
+      p_atomic_inc(&panvk_mem_stats.bc_stale_reads);
+      return true;
+   }
+   return false;
+}
+
+/* csf-v11 225: a raw write of every block makes the raw blocks valid. */
+static void
+bc_raw_written(struct panvk_image *img, bool full)
+{
+   if (full && p_atomic_read(&img->bc_raw_stale))
+      p_atomic_set(&img->bc_raw_stale, false);
 }
 
 VKAPI_ATTR void VKAPI_CALL
@@ -1947,8 +1985,9 @@ panvk_per_arch(CmdCopyImageToMemoryKHR)(
       panvk_meta_copy_get_image_properties(img, false, false);
    struct panvk_cmd_meta_compute_save_ctx save = {0};
 
-   /* csf-v11/207: no raw blocks to read (PANVK_BC_RAW=lazy). */
-   if (img->bc_raw_lazy) {
+   /* csf-v11/207: no raw blocks to read (PANVK_BC_RAW=lazy), or (225)
+    * raw blocks that a shadow-only copy left stale. */
+   if (bc_raw_unreadable(img)) {
       bc_raw_lazy_hit(dev, "copy to memory");
       return;
    }
@@ -2314,6 +2353,20 @@ bc_copy_image_shadow(struct panvk_cmd_buffer *cmdbuf,
       return;
    }
 
+   /* csf-v11 225: the destination's raw blocks (raw store or in-image raw
+    * plane) are not written, so they no longer match its shadow. A later
+    * raw read of them (a second DXVK relocation of the texture) decoded
+    * zero blocks into the next copy: black ETC2, NaN-lit EAC normals.
+    * PANVK_BC_RAW_STALE=0: old (raw blocks trusted). */
+   static int stale_on = -1;
+   if (p_atomic_read(&stale_on) < 0)
+      p_atomic_set(&stale_on, debug_get_bool_option("PANVK_BC_RAW_STALE", true));
+   if (!dst_img->bc_no_raw && p_atomic_read(&stale_on) &&
+       !p_atomic_read(&dst_img->bc_raw_stale)) {
+      p_atomic_set(&dst_img->bc_raw_stale, true);
+      p_atomic_inc(&panvk_mem_stats.bc_stale_marks);
+   }
+
    /* The source shadow was written by a transcode or copy dispatch. */
    bc_decode_barrier(cmd, VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
                      VK_ACCESS_2_SHADER_STORAGE_READ_BIT);
@@ -2391,8 +2444,9 @@ cmd_copy_image(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(panvk_image, bc_dst, pCopyImageInfo->dstImage);
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
 
-   /* csf-v11/207: a source without raw blocks (PANVK_BC_RAW=lazy). */
-   if (bc_src->bc_raw_lazy) {
+   /* csf-v11/207: a source without raw blocks (PANVK_BC_RAW=lazy), or
+    * (225) with stale ones. */
+   if (bc_raw_unreadable(bc_src)) {
       if (bc_copy_shadow_ok(bc_src, bc_dst)) {
          bc_copy_image_shadow(cmdbuf, pCopyImageInfo);
       } else {
@@ -2416,6 +2470,8 @@ cmd_copy_image(VkCommandBuffer commandBuffer,
        (!bc_dst->bc_no_raw &&
         !bc_raw_use(cmdbuf, bc_dst, true, bc_blocks_full(bc_dst, blocks))))
       return;
+   if (!bc_dst->bc_no_raw)
+      bc_raw_written(bc_dst, bc_blocks_full(bc_dst, blocks));
 
    if (bc_dst->bc_emul && bc_dst->bc_no_raw) {
       bc_copy_image_no_raw(cmdbuf, pCopyImageInfo);
-- 
2.55.0

