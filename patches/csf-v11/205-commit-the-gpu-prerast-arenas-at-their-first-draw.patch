From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 22 Oct 2026 06:03:01 +0000
Subject: [PATCH] panvk/csf: commit the gpu_prerast arenas at their first draw

csf-v11/100 commits the 64 MiB gpu_prerast arena and the 96 MiB
tessellation arena when the VkDevice is created, because GPU-fault
growth on MediaTek kbase loses the first gpu_prerast draw's output.
Every VkDevice that enables GS, XFB, tessellation, non-solid fill,
viewport index or vertex stores (every DXVK device, and PanProbe) paid
160 MiB of committed, CPU-cleared memory, whether it drew through
gpu_prerast or not (perf review #11).

Create each arena at the first draw that records a pass into it,
under a device lock, still fully committed and cleared before any GPU
access (the record precedes the submit), so the fault growth problem
does not come back. Barriers keep keying on whether the device enabled
the features, not on whether an arena exists yet. A failed late
allocation sets VK_ERROR_OUT_OF_DEVICE_MEMORY on the command buffer.

PANVK_GPU_PRERAST_ARENA=eager restores the creation-time commit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c |  3 +-
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c   | 21 ++++-
 src/panfrost/vulkan/panvk_device.h            | 14 +++
 src/panfrost/vulkan/panvk_vX_device.c         | 94 ++++++++++++++-----
 4 files changed, 101 insertions(+), 31 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index 9ed3f6f..7ec296c 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -512,8 +512,7 @@ collect_cs_deps(struct panvk_cmd_buffer *cmdbuf, const VkDependencyInfo *info,
    uint32_t wait_masks[PANVK_SUBQUEUE_COUNT] = {0};
    add_execution_dependency(
       wait_masks, src.stages, dst.stages,
-      panvk_priv_mem_check_alloc(dev->gpu_prerast_arena) ||
-         panvk_priv_mem_check_alloc(dev->gpu_prerast_tess_arena));
+      dev->gpu_prerast_wanted || dev->gpu_prerast_tess_wanted);
 
    if (cmdbuf->state.gfx.render.tiler || inherits_render_ctx(cmdbuf)) {
       if (info->dependencyFlags & VK_DEPENDENCY_BY_REGION_BIT) {
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index 1e32e82..f3aad27 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -4378,7 +4378,12 @@ gpu_prerast_draw(struct panvk_cmd_buffer *cmdbuf,
       return true;
    }
 
-   uint64_t arena = panvk_priv_mem_dev_addr(dev->gpu_prerast_arena);
+   uint64_t arena = panvk_priv_mem_dev_addr(
+      panvk_per_arch(device_gpu_prerast_arena)(dev, false));
+   if (!arena) {
+      vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return true;
+   }
    uint64_t records = arena + PANVK_GPU_PRERAST_RECORD_OFFSET;
    uint64_t indices = arena + PANVK_GPU_PRERAST_INDEX_OFFSET;
    const struct panvk_shader *gs = cmdbuf->state.gfx.gs.shader;
@@ -4913,7 +4918,8 @@ gpu_prerast_tess(struct panvk_cmd_buffer *cmdbuf,
 
    if (!tcs || !tes || !tcs->gpu_prerast.tess.compiled ||
        !vs->gpu_prerast.lowered_vs_compiled ||
-       !panvk_priv_mem_check_alloc(dev->gpu_prerast_tess_arena)) {
+       !panvk_priv_mem_check_alloc(
+          panvk_per_arch(device_gpu_prerast_arena)(dev, true))) {
       gpu_prerast_unhandled("tessellation shaders missing");
       return;
    }
@@ -4986,7 +4992,8 @@ gpu_prerast_tess(struct panvk_cmd_buffer *cmdbuf,
                       panvk_gpu_prerast_gs_cap_slots(&gs->gpu_prerast.gs) /
                          MAX2(gs->gpu_prerast.gs.invocations, 1));
       range = verts / vpp * vpp;
-      if (!range || !panvk_priv_mem_check_alloc(dev->gpu_prerast_arena)) {
+      if (!range || !panvk_priv_mem_check_alloc(
+                       panvk_per_arch(device_gpu_prerast_arena)(dev, false))) {
          gpu_prerast_unhandled("tessellation output range");
          return;
       }
@@ -5527,7 +5534,13 @@ gpu_prerast_chunk_loop(struct panvk_cmd_buffer *cmdbuf,
    const bool indirect = draw->indirect.buffer_dev_addr != 0;
    const bool indexed = draw->index.index_size != 0;
    const bool fan = draw->prim == MESA_PRIM_TRIANGLE_FAN;
-   const uint64_t arena = panvk_priv_mem_dev_addr(dev->gpu_prerast_arena);
+   const uint64_t arena = panvk_priv_mem_dev_addr(
+      panvk_per_arch(device_gpu_prerast_arena)(dev, false));
+
+   if (!arena) {
+      vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return;
+   }
 
    struct pan_ptr cd =
       panvk_cmd_alloc_dev_mem(cmdbuf, desc, sizeof(struct panlib_chunk_draw), 16);
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index 30527f5..5bde9dd 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -135,8 +135,16 @@ struct panvk_device {
    } utrace;
 
    struct panvk_device_draw_context* draw_ctx;
+   /* Allocated (and fully committed) at the first gpu_prerast /
+    * tessellation draw recorded on the device, under gpu_prerast_lock,
+    * unless PANVK_GPU_PRERAST_ARENA=eager (csf-v11/205). Read them through
+    * panvk_per_arch(device_gpu_prerast_arena)(). gpu_prerast_wanted /
+    * gpu_prerast_tess_wanted say whether the device may use them. */
    struct panvk_priv_mem gpu_prerast_arena;
    struct panvk_priv_mem gpu_prerast_tess_arena;
+   bool gpu_prerast_wanted;
+   bool gpu_prerast_tess_wanted;
+   simple_mtx_t gpu_prerast_lock;
    /* struct panvk_gpu_prerast_syncs */
    struct panvk_priv_bo *gpu_prerast_syncs;
 
@@ -326,6 +334,12 @@ void panvk_per_arch(destroy_device)(struct panvk_device *device,
  * vk_meta device (it replaces panvk_meta_cleanup() in destroy_device). */
 void panvk_per_arch(device_bc_finish)(struct panvk_device *dev);
 
+/* The gpu_prerast arena (tess = false) or the tessellation arena,
+ * allocated on first use on v10+ (csf-v11/205). Returns a zero
+ * panvk_priv_mem if the device does not use it or the allocation failed. */
+struct panvk_priv_mem
+panvk_per_arch(device_gpu_prerast_arena)(struct panvk_device *dev, bool tess);
+
 static inline VkResult
 panvk_common_check_status(struct panvk_device *dev)
 {
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index 1e3521b..51e669c 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -43,6 +43,8 @@
 
 #include "kmod/pan_kmod.h"
 #include "util/os_file.h"
+#include "util/log.h"
+#include "util/os_misc.h"
 #include "util/u_printf.h"
 #include "pan_props.h"
 #include "pan_samples.h"
@@ -135,8 +137,24 @@ panvk_device_cleanup_tls(struct panvk_device *dev)
  * GPU-fault growth loses the first gpu_prerast draw's output: PanProbe
  * gs_viewport_depth case A drew nothing on every run; without alloc-on-fault,
  * 6/6 runs pass.
- * ponytail: commits 160 MiB per VkDevice enabling GS/tess/XFB features;
- * upgrade path = KBASE_IOCTL_MEM_COMMIT on first gpu_prerast use. */
+ *
+ * csf-v11/205: "creation" is no longer the VkDevice's, which committed and
+ * CPU-cleared 64 + 96 MiB in every VkDevice that enables GS, XFB,
+ * tessellation, non-solid fill, viewport index or vertex stores (every
+ * DXVK device), used or not. On CSF (v10+) each arena is created at the
+ * first draw that records a gpu_prerast or tessellation pass, still fully
+ * committed before any GPU access (the record happens before the submit),
+ * so the fault growth problem above does not come back. The v9 JM
+ * gpu_prerast paths read the arenas directly and keep the creation-time
+ * commit. PANVK_GPU_PRERAST_ARENA=eager restores it on CSF too. */
+static bool
+gpu_prerast_arena_eager(void)
+{
+   const char *v = os_get_option("PANVK_GPU_PRERAST_ARENA");
+
+   return PAN_ARCH < 10 || (v && !strcmp(v, "eager"));
+}
+
 static struct panvk_priv_mem
 alloc_gpu_prerast_arena(struct panvk_device *dev, uint64_t size)
 {
@@ -148,7 +166,36 @@ alloc_gpu_prerast_arena(struct panvk_device *dev, uint64_t size)
                             &bo) != VK_SUCCESS)
       return (struct panvk_priv_mem){0};
 
-   return (struct panvk_priv_mem){.bo = (uintptr_t)bo};
+   struct panvk_priv_mem mem = {.bo = (uintptr_t)bo};
+   panvk_priv_mem_write(mem, 0, struct panvk_gpu_prerast_arena, arena) {
+      memset(arena, 0, sizeof(*arena));
+   }
+   return mem;
+}
+
+struct panvk_priv_mem
+panvk_per_arch(device_gpu_prerast_arena)(struct panvk_device *dev, bool tess)
+{
+   struct panvk_priv_mem *mem =
+      tess ? &dev->gpu_prerast_tess_arena : &dev->gpu_prerast_arena;
+
+   if (!(tess ? dev->gpu_prerast_tess_wanted : dev->gpu_prerast_wanted))
+      return (struct panvk_priv_mem){0};
+
+   simple_mtx_lock(&dev->gpu_prerast_lock);
+   if (!panvk_priv_mem_check_alloc(*mem)) {
+      *mem = alloc_gpu_prerast_arena(
+         dev, tess ? PANVK_GPU_PRERAST_TESS_ARENA_SIZE
+                   : PANVK_GPU_PRERAST_ARENA_SIZE);
+      if (panvk_priv_mem_check_alloc(*mem))
+         mesa_logi("panvk: gpu_prerast %s arena committed (%llu MiB)",
+                   tess ? "tessellation" : "draw",
+                   (unsigned long long)((tess ? PANVK_GPU_PRERAST_TESS_ARENA_SIZE
+                                              : PANVK_GPU_PRERAST_ARENA_SIZE) >> 20));
+   }
+   struct panvk_priv_mem ret = *mem;
+   simple_mtx_unlock(&dev->gpu_prerast_lock);
+   return ret;
 }
 #endif
 
@@ -622,32 +669,26 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
        device->vk.enabled_features.geometryShader ||
        device->vk.enabled_features.transformFeedback ||
        device->vk.enabled_features.shaderOutputViewportIndex ||
-       device->vk.enabled_features.vertexPipelineStoresAndAtomics) {
-      device->gpu_prerast_arena =
-         alloc_gpu_prerast_arena(device, PANVK_GPU_PRERAST_ARENA_SIZE);
-      if (!panvk_priv_mem_check_alloc(device->gpu_prerast_arena)) {
+       device->vk.enabled_features.vertexPipelineStoresAndAtomics)
+      device->gpu_prerast_wanted = true;
+   device->gpu_prerast_tess_wanted =
+      device->vk.enabled_features.tessellationShader;
+   simple_mtx_init(&device->gpu_prerast_lock, mtx_plain);
+
+   /* v9, or PANVK_GPU_PRERAST_ARENA=eager: commit both arenas here, as
+    * before csf-v11/205 (64 + 96 MiB per VkDevice with the features). */
+   if (gpu_prerast_arena_eager()) {
+      if ((device->gpu_prerast_wanted &&
+           !panvk_priv_mem_check_alloc(
+              panvk_per_arch(device_gpu_prerast_arena)(device, false))) ||
+          (device->gpu_prerast_tess_wanted &&
+           !panvk_priv_mem_check_alloc(
+              panvk_per_arch(device_gpu_prerast_arena)(device, true)))) {
          result = panvk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
          goto err_free_priv_bos;
       }
-      panvk_priv_mem_write(device->gpu_prerast_arena, 0,
-                           struct panvk_gpu_prerast_arena, arena) {
-         memset(arena, 0, sizeof(*arena));
-      }
    }
-   if (device->vk.enabled_features.tessellationShader) {
-      device->gpu_prerast_tess_arena =
-         alloc_gpu_prerast_arena(device, PANVK_GPU_PRERAST_TESS_ARENA_SIZE);
-      if (!panvk_priv_mem_check_alloc(device->gpu_prerast_tess_arena)) {
-         result = panvk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
-         goto err_free_priv_bos;
-      }
-      panvk_priv_mem_write(device->gpu_prerast_tess_arena, 0,
-                           struct panvk_gpu_prerast_arena, arena) {
-         memset(arena, 0, sizeof(*arena));
-      }
-   }
-   if (panvk_priv_mem_check_alloc(device->gpu_prerast_arena) ||
-       panvk_priv_mem_check_alloc(device->gpu_prerast_tess_arena)) {
+   if (device->gpu_prerast_wanted || device->gpu_prerast_tess_wanted) {
       result = panvk_priv_bo_create(
          device, sizeof(struct panvk_gpu_prerast_syncs),
          device->kmod.dev->props.supported_bo_flags &
@@ -867,6 +908,9 @@ panvk_per_arch(destroy_device)(struct panvk_device *device,
     panvk_priv_bo_unref(device->gpu_prerast_syncs);
     panvk_pool_free_mem(&device->gpu_prerast_tess_arena);
     panvk_pool_free_mem(&device->gpu_prerast_arena);
+#if PAN_ARCH >= 10
+    simple_mtx_destroy(&device->gpu_prerast_lock);
+#endif
     panvk_device_cleanup_mempools(device);
    vk_free(&device->vk.alloc, device->dump_region_size);
    pan_kmod_vm_destroy(device->kmod.vm);
-- 
2.55.0

