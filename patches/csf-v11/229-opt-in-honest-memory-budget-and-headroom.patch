From d358184bbedc0ef44bc08dc7dbc5a96c35eb4a11 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Sat, 24 Oct 2026 00:32:00 +0000
Subject: [PATCH 229/229] panvk: opt-in honest memory budget and budget
 headroom knobs

Rationale: VK_EXT_memory_budget reports heapUsage = VkDeviceMemory only and
heapBudget = min(heap, usage + 0.9 x MemAvailable). With MemAvailable near
0 (Fallout 4 on the G615) the budget equals DXVK's own allocation (95-103 %
on the HUD), and none of the driver's private memory is visible
(fo4-memory-analysis section 1, fix 9).

How DXVK reacts to heapUsage versus its own allocation count is not
verified, so both changes are opt-in for an A/B run:
- PANVK_MEM_BUDGET=honest: heapUsage also counts the private BOs of csf-v11
  223 (not the kbase tiler heap chunks, which user space cannot see), and
  the budget is computed from that usage.
- PANVK_MEM_BUDGET_HEADROOM_MB=<n>: the budget is at least usage + n MiB
  (capped at the heap size).

Default: unchanged. Arch: all (the knobs only).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_physical_device.c | 32 +++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 5f72f2e2..b044ce54 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -1731,6 +1731,38 @@ panvk_GetPhysicalDeviceMemoryProperties2(
             panvk_available_system_memory(physical_device), 0.9f, heap_size,
             used);
 
+         /* csf-v11 229, opt-in (default: the two lines above).
+          * PANVK_MEM_BUDGET=honest: heapUsage also counts the driver's
+          * private BOs (tiler heap chunks are not visible), and the budget
+          * is computed from that usage. PANVK_MEM_BUDGET_HEADROOM_MB=<n>:
+          * the budget is at least usage + n MiB (capped at the heap), so it
+          * never reads 100 % just because MemAvailable is near 0. */
+         static int honest = -1;
+         static int64_t headroom_mb = -1;
+         if (p_atomic_read(&honest) < 0) {
+            const char *m = os_get_option("PANVK_MEM_BUDGET");
+            p_atomic_set(&headroom_mb,
+                         MAX2(debug_get_num_option(
+                                 "PANVK_MEM_BUDGET_HEADROOM_MB", 0), 0));
+            p_atomic_set(&honest, m && !strcmp(m, "honest"));
+         }
+         if (p_atomic_read(&honest)) {
+            uint64_t priv = 0;
+            for (unsigned k = 0; k < PANVK_MEM_KIND_COUNT; k++)
+               priv += p_atomic_read_relaxed(&panvk_mem_stats.bytes[k]);
+            p->heapUsage[0] = used + priv;
+            p->heapBudget[0] = vk_physical_device_heap_budget(
+               panvk_available_system_memory(physical_device), 0.9f,
+               heap_size, used + priv);
+         }
+         if (p_atomic_read(&headroom_mb) > 0) {
+            const uint64_t floor =
+               MIN2(heap_size, p->heapUsage[0] +
+                                  (uint64_t)p_atomic_read(&headroom_mb) *
+                                     1024 * 1024);
+            p->heapBudget[0] = MAX2(p->heapBudget[0], floor);
+         }
+
          /* From the Vulkan 1.3.278 spec:
           *
           *    "The heapBudget and heapUsage values must be zero for array
-- 
