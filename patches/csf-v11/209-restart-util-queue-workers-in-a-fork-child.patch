From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Thu, 22 Oct 2026 07:23:51 +0000
Subject: [PATCH] util/u_queue: restart the workers in a fork() child

A fork() child has only the forking thread. The queue workers stay in
the parent, so a job added in the child never runs and
util_queue_finish()/util_queue_destroy() in the child wait forever.

PanProbe vkd3d_heap creates the VkInstance in the parent (panvk creates
the disk cache and its disk$ worker at physical device init) and forks
one child per case. Once csf-v11/204 made the disk cache work on
Android, each child's pipeline compile queued a cache write, and its
vkDestroyInstance -> disk_cache_destroy -> util_queue_finish blocked
until the 12 s case watchdog fired (all 4 cases; passes with
MESA_SHADER_CACHE_DISABLE=true).

Register pthread_atfork handlers next to the atexit handler:
- prepare holds exit_mutex and every queue lock across fork();
- child drops the parent's queued jobs (their fences are signalled, the
  jobs stay the parent's), sets num_threads = 0, re-inits the condition
  variables without cnd_destroy (they may count the parent's waiters)
  and marks the queue respawn_after_fork;
- the child's first util_queue_add_job starts a new worker.
So the child's cache writes land and its destroy returns.

Also complete CPU detection before any worker exists (global_init) and
in the prepare handler. The first worker calls util_get_cpu_caps() ->
call_once(_util_cpu_detect_once) at nice 19 / SCHED_BATCH, reading sysfs
for every CPU. vkd3d_heap forks its first case a few ms after
vkCreateInstance, inside that window, and bionic's pthread_once (unlike
glibc's, which restarts an in-progress once in a fork child) leaves the
child's once flag "in progress" forever: the child's respawned disk$
worker blocks in util_get_cpu_caps and disk_cache_destroy waits on it.
On G615 that failed only the first case (ssbo_heap, 12 s watchdog) with
the cache really on; texel/image/mutable, forked later, passed.

Host repro: tools/u-queue-fork-test (HANG before, PASS after, and the
child's entries are readable from the parent; fork_cost: no extra
threads, only queues that get a job start one). glibc cannot show the
pthread_once part.
---
 src/util/u_queue.c | 120 +++++++++++++++++++++++++++++++++++++++++++++
 src/util/u_queue.h |   3 ++
 2 files changed, 123 insertions(+)

diff --git a/src/util/u_queue.c b/src/util/u_queue.c
index 6c135210..3031506e 100644
--- a/src/util/u_queue.c
+++ b/src/util/u_queue.c
@@ -35,6 +35,12 @@
 #include "util/timespec.h"
 #include "u_process.h"
 
+#include "util/detect_os.h"
+
+#if DETECT_OS_POSIX
+#include <pthread.h>
+#endif
+
 #if defined(__linux__)
 #include <sys/time.h>
 #include <sys/resource.h>
@@ -48,6 +54,8 @@
 static void
 util_queue_kill_threads(struct util_queue *queue, unsigned keep_num_threads,
                         bool locked);
+static bool
+util_queue_create_thread(struct util_queue *queue, unsigned index);
 
 /****************************************************************************
  * Wait for all queues to assert idle when exit() is called.
@@ -76,11 +84,119 @@ atexit_handler(void)
    mtx_unlock(&exit_mutex);
 }
 
+#if DETECT_OS_POSIX
+/****************************************************************************
+ * fork() support
+ *
+ * A fork() child has only the thread that called fork(). The queue workers
+ * stay in the parent, so without this a job added in the child is never run
+ * and util_queue_finish()/util_queue_destroy() in the child wait forever on
+ * workers that do not exist there. That is what hung PanProbe's vkd3d_heap:
+ * it creates the VkInstance (and with it the disk cache and its "disk$"
+ * worker) in the parent, then forks one child per case; the child's pipeline
+ * compile queues a cache write and its vkDestroyInstance blocks in
+ * disk_cache_destroy() -> util_queue_finish().
+ *
+ * prepare: hold exit_mutex and every queue lock across fork(), so the child
+ *          gets consistent queue state and unlocked mutexes.
+ * child:   forget the parent's workers and jobs (num_threads = 0, the
+ *          inherited jobs belong to the parent and are not run twice; their
+ *          fences are signalled so nobody in the child waits on them). The
+ *          condition variables are re-initialised without cnd_destroy(), as
+ *          they may still count the parent's waiters. The first
+ *          util_queue_add_job() in the child starts a new worker.
+ */
+static void
+atfork_prepare(void)
+{
+   struct util_queue *iter;
+
+   /* Wait out a CPU detection that another thread may still be running, so
+    * the child never inherits its once flag in the "in progress" state (see
+    * global_init). After the first call this is one atomic load. */
+   util_get_cpu_caps();
+
+   mtx_lock(&exit_mutex);
+   LIST_FOR_EACH_ENTRY(iter, &queue_list, head)
+      mtx_lock(&iter->lock);
+}
+
+static void
+atfork_parent(void)
+{
+   struct util_queue *iter;
+
+   LIST_FOR_EACH_ENTRY(iter, &queue_list, head)
+      mtx_unlock(&iter->lock);
+   mtx_unlock(&exit_mutex);
+}
+
+static void
+atfork_child(void)
+{
+   struct util_queue *iter;
+
+   LIST_FOR_EACH_ENTRY(iter, &queue_list, head) {
+      if (iter->jobs) {
+         /* num_queued, not write_idx: a full ring has read == write. */
+         for (int n = 0; n < iter->num_queued; n++) {
+            unsigned i = (iter->read_idx + n) % iter->max_jobs;
+            if (iter->jobs[i].job && iter->jobs[i].fence)
+               util_queue_fence_signal(iter->jobs[i].fence);
+            memset(&iter->jobs[i], 0, sizeof(iter->jobs[i]));
+         }
+      }
+      iter->read_idx = iter->write_idx = 0;
+      iter->num_queued = 0;
+      iter->total_jobs_size = 0;
+
+      /* A queue whose threads were already killed (atexit) stays dead. */
+      iter->respawn_after_fork = iter->num_threads > 0 ||
+                                 iter->respawn_after_fork;
+      iter->num_threads = 0;
+      iter->create_threads_on_demand = true;
+
+      cnd_init(&iter->has_queued_cond);
+      cnd_init(&iter->has_space_cond);
+      mtx_unlock(&iter->lock);
+   }
+   mtx_unlock(&exit_mutex);
+}
+
+/* Called with queue->lock held, in a fork() child, before the first job. */
+static bool
+util_queue_respawn_after_fork_locked(struct util_queue *queue)
+{
+   queue->respawn_after_fork = false;
+   memset(queue->threads, 0, queue->max_threads * sizeof(*queue->threads));
+
+   /* The new worker blocks on queue->lock until the caller drops it, and
+    * then sees thread_index < num_threads. */
+   queue->num_threads = 1;
+   if (!util_queue_create_thread(queue, 0)) {
+      queue->num_threads = 0;
+      return false;
+   }
+   return true;
+}
+#endif
+
 static void
 global_init(void)
 {
    mtx_init(&exit_mutex, mtx_plain);
    atexit(atexit_handler);
+#if DETECT_OS_POSIX
+   /* Run CPU detection here, before any queue worker exists. Otherwise the
+    * first worker (util_queue_thread_func -> util_get_cpu_caps) runs it at
+    * nice 19 / SCHED_BATCH, reading sysfs for every CPU, and a fork() in
+    * that window gives a child whose once flag is stuck "in progress":
+    * bionic's pthread_once (unlike glibc's) does not reset it in a fork
+    * child, so the child's respawned worker blocks forever and its
+    * disk_cache_destroy -> util_queue_finish never returns. */
+   util_get_cpu_caps();
+   pthread_atfork(atfork_prepare, atfork_parent, atfork_child);
+#endif
 }
 
 static void
@@ -555,6 +671,10 @@ util_queue_add_job_locked(struct util_queue *queue,
 
    if (!locked)
       mtx_lock(&queue->lock);
+#if DETECT_OS_POSIX
+   if (queue->num_threads == 0 && queue->respawn_after_fork)
+      util_queue_respawn_after_fork_locked(queue);
+#endif
    if (queue->num_threads == 0) {
       if (!locked)
          mtx_unlock(&queue->lock);
diff --git a/src/util/u_queue.h b/src/util/u_queue.h
index 7cbb89cd..f38e7730 100644
--- a/src/util/u_queue.h
+++ b/src/util/u_queue.h
@@ -232,6 +232,9 @@ struct util_queue {
    int num_queued;
    unsigned max_threads;
    unsigned num_threads; /* decreasing this number will terminate threads */
+   /* Set in a fork() child: the workers stayed in the parent, so the child
+    * starts its own worker at its first util_queue_add_job. */
+   bool respawn_after_fork;
    int max_jobs;
    int write_idx, read_idx; /* ring buffer pointers */
    size_t total_jobs_size;  /* memory use of all jobs in the queue */
-- 
2.55.0
