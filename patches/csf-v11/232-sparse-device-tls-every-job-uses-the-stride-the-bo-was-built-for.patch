From 62c9906beef19d417e505fce2707e7aa27904db7 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay.byte02@gmail.com>
Date: Sun, 25 Oct 2026 17:21:46 +0000
Subject: [PATCH 232/232] panvk/csf: sparse device TLS: every job uses the
 stride the BO was built for

Rationale: RC5-universal-113 failed PanProbe gs_tess_primitive_id on
FTL panther (v10) and shiba (v11): the three 600-patch GPU chunk cases
had ~300 bad patch IDs with counts that differ between submits of the
same command buffer, and no fault. 230's sparse BO has one alias slot of
THREAD_TLS_ALLOC x (BO per-thread size) per core ID, absent-core slots
alias slab 0. The hardware places core c's stacks at c x THREAD_TLS_ALLOC
x (stack size in the job's TSD). Two TSDs carried a smaller stack size:

- per-job TSDs (dispatch, precomp, gpu_prerast VS/GS/TCS compute jobs)
  are packed with their own shader's stack size and only copy the TLS
  pointer from the command buffer's descriptor at run time;
- the command buffer's descriptor carries the command buffer's maximum,
  but the device BO it points to can be bigger (an earlier one).

With a smaller stride, present cores land in absent-core slots (all
slab 0) or in another core's slab, so threads on different cores share
stacks. The chunk path mixes the 4096 B/thread gpu_prerast kernels with
smaller-stack jobs in one command buffer; the 24-prim cases do not. In
the failing process only one 4096 B BO was created and no shrink ran,
so 230's shrink and 231 are not involved. 112's full BO only used a
prefix for a smaller stride, which is why this never showed before.

With PANVK_TLS_SPARSE (default 1): the descriptor written at
EndCommandBuffer uses the sparse BO's per-thread size when larger, and
the per-job TSD copy (now one helper, panvk_per_arch(cmd_copy_tls_to_tsd))
also copies word 0 (TLS Size, the only field there). A larger stack
size than a shader needs is always valid; the BO is sized for it.

Knobs: PANVK_TLS_SPARSE=0 = 112 layout and the 112 TSD copy.
PANVK_TLS_SHRINK_MS unchanged. Arch: v10+ (CSF only); v6/v7/v9 code is
unchanged. Validation: FTL shiba (v11) and panther (v10) PanProbe 39/39
with tess_perf hashes equal to 112 (RC5-universal-114).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/csf/panvk_cmd_buffer.h    |  5 +++
 src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c | 45 +++++++++++++++++--
 .../vulkan/csf/panvk_vX_cmd_dispatch.c        |  6 +--
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c   |  6 +--
 .../vulkan/csf/panvk_vX_cmd_precomp.c         |  6 +--
 5 files changed, 50 insertions(+), 18 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
index fe562fee..9d8110e6 100644
--- a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
@@ -1133,6 +1133,11 @@ cs_emit_layer_fragment_state(struct cs_builder *b, struct cs_index fbd_ptr)
 }
 #endif /* PAN_ARCH >= 14 */
 
+/* csf-v11 232: copy the command buffer's TLS pointer (and, with
+ * PANVK_TLS_SPARSE, its stack size) into a per-job TSD on the GPU. */
+void panvk_per_arch(cmd_copy_tls_to_tsd)(struct panvk_cmd_buffer *cmdbuf,
+                                         struct cs_builder *b, uint64_t tsd);
+
 void panvk_per_arch(collect_crc_invalidation_deps)(const VkDependencyInfo *info,
                                                    struct panvk_cs_deps *deps,
                                                    uint64_t *crc_addrs);
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index 53cf5d90..9bb47dc7 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -296,7 +296,8 @@ dev_tls_create(struct panvk_device *dev, const struct dev_tls_layout *l)
 }
 
 static uint64_t
-get_device_tls(struct panvk_cmd_buffer *cmdbuf, const struct dev_tls_layout *l)
+get_device_tls(struct panvk_cmd_buffer *cmdbuf, const struct dev_tls_layout *l,
+               unsigned *sparse_thread_size)
 {
    struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
    const bool free_old = dev_tls_free_old();
@@ -348,6 +349,10 @@ get_device_tls(struct panvk_cmd_buffer *cmdbuf, const struct dev_tls_layout *l)
 
    if (cur) {
       addr = cur->addr.dev;
+      /* csf-v11 232: the stride the alias slots of a sparse BO assume. */
+      if (cur->alias_size)
+         *sparse_thread_size =
+            cur->alias_size / ((uint64_t)l->threads * MAX2(l->range, 1));
       if (free_old) {
          bool held = false;
          util_dynarray_foreach(&cmdbuf->dev_tls_refs, struct panvk_priv_bo *,
@@ -373,6 +378,7 @@ emit_tls(struct panvk_cmd_buffer *cmdbuf)
    struct panvk_physical_device *phys_dev =
       to_panvk_physical_device(dev->vk.physical);
    unsigned core_id_range = pan_query_core_id_range(&phys_dev->kmod.dev->props);
+   unsigned sparse_thread_size = 0;
 
    if (cmdbuf->state.tls.info.tls.size) {
       unsigned thread_tls_alloc =
@@ -388,16 +394,49 @@ emit_tls(struct panvk_cmd_buffer *cmdbuf)
          .threads = thread_tls_alloc,
       };
 
-      cmdbuf->state.tls.info.tls.ptr = get_device_tls(cmdbuf, &layout);
+      cmdbuf->state.tls.info.tls.ptr =
+         get_device_tls(cmdbuf, &layout, &sparse_thread_size);
    }
 
    assert(!cmdbuf->state.tls.info.wls.size);
 
    if (cmdbuf->state.tls.desc.cpu) {
-      GENX(pan_emit_tls)(&cmdbuf->state.tls.info, cmdbuf->state.tls.desc.cpu);
+      /* csf-v11 232: a sparse BO's alias slots are THREAD_TLS_ALLOC x its own
+       * per-thread size apart, and the hardware places core c's stacks at
+       * c x THREAD_TLS_ALLOC x (stack size in the TSD). A smaller stack size
+       * in the TSD puts present cores in the slots of absent ones, which all
+       * alias slab 0, so their threads share stacks (113: gs_tess_primitive_id
+       * chunk cases on v10/v11). Program the BO's per-thread size. */
+      struct pan_tls_info info = cmdbuf->state.tls.info;
+      if (sparse_thread_size > info.tls.size)
+         info.tls.size = sparse_thread_size;
+      GENX(pan_emit_tls)(&info, cmdbuf->state.tls.desc.cpu);
    }
 }
 
+/* csf-v11 232: per-job TSDs (dispatch, precomp, the gpu_prerast and
+ * tessellation compute jobs) were written with their own shader's stack size
+ * and only took the TLS pointer from the command buffer's descriptor, which
+ * is filled at EndCommandBuffer. With PANVK_TLS_SPARSE the stack size (word
+ * 0, nothing else lives there) is copied too, so every job uses the stride
+ * the sparse BO was built for. PANVK_TLS_SPARSE=0 = the 112 copy. */
+void
+panvk_per_arch(cmd_copy_tls_to_tsd)(struct panvk_cmd_buffer *cmdbuf,
+                                    struct cs_builder *b, uint64_t tsd)
+{
+   const bool stride = dev_tls_sparse();
+
+   cs_move64_to(b, cs_scratch_reg64(b, 0), cmdbuf->state.tls.desc.gpu);
+   cs_load64_to(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
+   if (stride)
+      cs_load32_to(b, cs_scratch_reg32(b, 4), cs_scratch_reg64(b, 0), 0);
+   cs_move64_to(b, cs_scratch_reg64(b, 0), tsd);
+   cs_store64(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
+   if (stride)
+      cs_store32(b, cs_scratch_reg32(b, 4), cs_scratch_reg64(b, 0), 0);
+   cs_flush_stores(b);
+}
+
 /**
  * Write all sync point updates to seqno registers and reset the relative sync
  * points to 0.
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
index 3586e17b..978f4213 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
@@ -412,11 +412,7 @@ cmd_dispatch(struct panvk_cmd_buffer *cmdbuf, struct panvk_dispatch_info *info)
 
    /* Copy the global TLS pointer to the per-job TSD. */
    if (cs->info.tls_size) {
-      cs_move64_to(b, cs_scratch_reg64(b, 0), cmdbuf->state.tls.desc.gpu);
-      cs_load64_to(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
-      cs_move64_to(b, cs_scratch_reg64(b, 0), tsd);
-      cs_store64(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
-      cs_flush_stores(b);
+      panvk_per_arch(cmd_copy_tls_to_tsd)(cmdbuf, b, tsd);
    }
 
    panvk_per_arch(cmd_dispatch_shader)(cmdbuf, cs, cs_desc_state,
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index 00c5c5f3..078158f6 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -3751,11 +3751,7 @@ gpu_prerast_launch_cs_desc(struct panvk_cmd_buffer *cmdbuf,
    if (cs->info.tls_size) {
       struct cs_builder *b =
          panvk_get_cs_builder(cmdbuf, PANVK_SUBQUEUE_COMPUTE);
-      cs_move64_to(b, cs_scratch_reg64(b, 0), cmdbuf->state.tls.desc.gpu);
-      cs_load64_to(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
-      cs_move64_to(b, cs_scratch_reg64(b, 0), tsd);
-      cs_store64(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
-      cs_flush_stores(b);
+      panvk_per_arch(cmd_copy_tls_to_tsd)(cmdbuf, b, tsd);
    }
 
    compute_state_set_dirty(cmdbuf, CS);
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_precomp.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_precomp.c
index a3be5176..cae3a7b0 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_precomp.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_precomp.c
@@ -66,11 +66,7 @@ panvk_per_arch(dispatch_precomp)(struct panvk_precomp_ctx *ctx,
 
    /* Copy the global TLS pointer to the per-job TSD. */
    if (shader->info.tls_size) {
-      cs_move64_to(b, cs_scratch_reg64(b, 0), cmdbuf->state.tls.desc.gpu);
-      cs_load64_to(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
-      cs_move64_to(b, cs_scratch_reg64(b, 0), tsd);
-      cs_store64(b, cs_scratch_reg64(b, 2), cs_scratch_reg64(b, 0), 8);
-      cs_flush_stores(b);
+      panvk_per_arch(cmd_copy_tls_to_tsd)(cmdbuf, b, tsd);
    }
 
    cs_update_compute_ctx(b) {
