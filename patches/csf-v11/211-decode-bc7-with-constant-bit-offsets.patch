+	 #pragma once
+static const uint32_t panvk_bc_bc7_fs_fast_spv[] = {
+	0x07230203,0x00010300,0x0008000b,0x00000791,0x00000000,0x00020011,0x00000001,0x00020011,
+	0x00000002,0x00020011,0x000014e3,0x0009000a,0x5f565053,0x5f52484b,0x73796870,0x6c616369,
