#version 460
#extension GL_NV_compute_shader_derivatives : require
layout(derivative_group_quads) in;
layout(local_size_x = 2, local_size_y = 2) in;
layout(set = 0, binding = 0, std430) buffer Output { float value[]; } output_data;
void main() {
   float x = float(gl_LocalInvocationIndex);
   output_data.value[gl_LocalInvocationIndex] = dFdx(x) + dFdy(x);
}
