diff --git a/src/cpu.cpp b/src/cpu.cpp
index f46faba..b893b20 100644
--- a/src/cpu.cpp
+++ b/src/cpu.cpp
@@ -35,6 +35,38 @@
 #endif
 
 #include "file_utils.h"
+#ifdef __ANDROID__
+#include <time.h>
+#include <unistd.h>
+// PanPlay: Android apps cannot read /proc/stat. CPU load = this (game) process's CPU time, all threads,
+// over wall time x cores, from /proc/self/stat. Per-core load has no source and stays off.
+static bool android_self_stat = false;
+static bool android_self_cpu(CPUData& total) {
+    static double last_wall = 0;
+    static unsigned long long last_ticks = 0;
+    FILE* f = fopen("/proc/self/stat", "r");
+    if (!f) return false;
+    char buf[1024];
+    size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    buf[n] = 0;
+    const char* p = strrchr(buf, ')');
+    unsigned long long ut = 0, st = 0;
+    if (!p || sscanf(p + 2, "%*c %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %llu %llu", &ut, &st) != 2)
+        return false;
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    double wall = ts.tv_sec + ts.tv_nsec / 1e9;
+    unsigned long long ticks = ut + st;
+    if (last_wall > 0 && wall > last_wall) {
+        double pct = (ticks - last_ticks) / (double)sysconf(_SC_CLK_TCK) / ((wall - last_wall) * sysconf(_SC_NPROCESSORS_CONF)) * 100.0;
+        total.percent = std::min(std::max((float)pct, 0.0f), 100.0f);
+    }
+    last_wall = wall;
+    last_ticks = ticks;
+    return true;
+}
+#endif
 
