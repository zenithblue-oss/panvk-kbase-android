{
  "#": "2026-10-27 a31 (v7 JM) diagnostic run (115b): D3D11 cube first-frame JM atom TERMINATED (event 0x4) and the D3D9 placed map failure. Release 115 vs diag2 driver (115 + failed-atom job chain dump, ION heap list with MTK ion_mm_heap fallback for placed maps, dma-buf alloc fallback) vs the 114 driver, and the 114 values of the JM knobs. Deep-merged over assets\/gameloop.json.",
  "version": 1,
  "#warmupSec": "after the first frame; the measured window is [warmupSec, warmupSec + measureSec] seconds after it",
  "warmupSec": 5,
  "measureSec": 10,
  "#tailSec": "self-timed tests (secsEnv) run warmupSec + measureSec + tailSec seconds, then exit on their own",
  "tailSec": 3,
  "#startTimeoutSec": "a pass with no first frame after this many seconds is stopped and marked failed",
  "startTimeoutSec": 150,
  "gapSec": 3,
  "#fpsLogMs": "PANVK_FPS_LOG_MS (driver fps line interval, csf-v11 233)",
  "fpsLogMs": 1000,
  "#screenshotAtSec": "PNG of the display (game + DXVK HUD) this many seconds after the first frame; -1 = none",
  "screenshotAtSec": 6,
  "#driver": "bundled = the driver this APK carries (default), selected = the launcher's choice, or a driver id",
  "driver": "bundled",
  "#env": "every pass (DXVK_HUD stays full: ContainerManager owns it)",
  "env": {},
  "#envSets": "one per pass. A\/B (scenario 4): 'old' = every default-on 115 perf knob (staging-115 pa, pb, pc NOTES.md) at its 114 value, 'default' = driver defaults. Opt-in knobs (PANVK_KBASE_COHERENT_POOLS, PANVK_KBASE_EVICTABLE, PANVK_KBASE_HEAP_SLOTS) stay unset in both. PANVK_ZS_PRELOAD_ALWAYS is not in 'old': 114 already used INTERSECT on v11 (csf-v11 061); on a v9\/v10 device add PANVK_ZS_PRELOAD_ALWAYS=1 for a full 114 set.",
  "envSets": {
    "default": {
      "note": "driver defaults",
      "env": {}
    },
    "old": {
      "note": "115 perf knobs at their 114 values (pa 8, pb 8, pc 5)",
      "env": {
        "PANVK_CSF_FS_IDLE_CLEAN": "0",
        "PANVK_DB_ALT": "0",
        "PANVK_CSF_INDIRECT_REEMIT": "0",
        "PANVK_CSF_DESC_DIRTY": "0",
        "PANVK_VB_DIRTY_CMP": "0",
        "PANVK_PRERAST_FAST_SKIP": "0",
        "PANVK_KBASE_STRICT_DEVICE_CLOCK": "0",
        "PANVK_DESC_POOL_HINT": "0",
        "PANVK_KBASE_HEAP_EAGER_TERM": "0",
        "PANVK_TESS_VS_REGION_MB": "32",
        "PANVK_KBASE_ZERO_ALL": "1",
        "PANVK_CS_FLUSH_USED": "0",
        "PANVK_JM_CMD_POOL_AUTOTRIM": "0",
        "PANVK_MEM_BUDGET_PRESSURE": "0",
        "PANVK_CS_CHUNK_KB": "64",
        "PANVK_CMD_SLAB_CACHE": "0",
        "PANVK_WSI_SW_CACHED": "0",
        "PANVK_WSI_SW_DEFER_REPLY": "0",
        "PANVK_ANDROID_PRESENT_FENCE": "0",
        "PANVK_ANDROID_PRESENT_THREAD": "0",
        "PANVK_PRELOAD_BARRIER_TRACK": "0"
      }
    },
    "rel": {
      "note": "build 115 release driver (bundled), defaults",
      "env": {}
    },
    "dg2": {
      "note": "diag2 driver, defaults",
      "driver": "dg2",
      "env": {}
    },
    "r114": {
      "note": "build 114 driver (114 + fps log)",
      "driver": "r114",
      "env": {}
    },
    "dg2-old": {
      "note": "diag2 driver, the 27 default-on 115 changes at their 114 values (PanProbe 114-knobs)",
      "driver": "dg2",
      "env": {
        "PANVK_CSF_FS_IDLE_CLEAN": "0",
        "PANVK_DB_ALT": "0",
        "PANVK_CSF_INDIRECT_REEMIT": "0",
        "PANVK_CSF_DESC_DIRTY": "0",
        "PANVK_VB_DIRTY_CMP": "0",
        "PANVK_PRERAST_FAST_SKIP": "0",
        "PANVK_KBASE_STRICT_DEVICE_CLOCK": "0",
        "PANVK_DESC_POOL_HINT": "0",
        "PANVK_KBASE_HEAP_EAGER_TERM": "0",
        "PANVK_TESS_VS_REGION_MB": "32",
        "PANVK_KBASE_ZERO_ALL": "1",
        "PANVK_CS_FLUSH_USED": "0",
        "PANVK_JM_CMD_POOL_AUTOTRIM": "0",
        "PANVK_MEM_BUDGET_PRESSURE": "0",
        "PANVK_CS_CHUNK_KB": "64",
        "PANVK_CMD_SLAB_CACHE": "0",
        "PANVK_WSI_SW_CACHED": "0",
        "PANVK_WSI_SW_DEFER_REPLY": "0",
        "PANVK_ANDROID_PRESENT_FENCE": "0",
        "PANVK_ANDROID_PRESENT_THREAD": "0",
        "PANVK_PRELOAD_BARRIER_TRACK": "0",
        "PANVK_V7_FS_COPY_ONCE": "0",
        "PANVK_JM_RESET_FLUSH": "batch",
        "PANVK_V7_TESS_BATCH_DRAWS": "0",
        "PANVK_V9_PRERAST_ARENA_LAZY": "0",
        "PANVK_KBASE_JM_WARMUP": "1",
        "PANVK_KBASE_UNCACHED_HEAP": "0"
      }
    },
    "dg2-warm": {
      "note": "diag2 driver, PANVK_KBASE_JM_WARMUP=1 (114)",
      "driver": "dg2",
      "env": {
        "PANVK_KBASE_JM_WARMUP": "1"
      }
    },
    "dg2-zero": {
      "note": "diag2 driver, PANVK_KBASE_ZERO_ALL=1 (114)",
      "driver": "dg2",
      "env": {
        "PANVK_KBASE_ZERO_ALL": "1"
      }
    }
  },
  "#tasks": "shortcut = PanPlay shortcut id (built-in cubes: builtin-<api>-<arch>). Add a task here and name it in a scenario.",
  "tasks": {
    "d3d11": {
      "title": "D3D11 cube (ARM64EC)",
      "shortcut": "builtin-d3d11-arm64ec",
      "secsEnv": "DXCUBE_SECS",
      "firstFramePattern": "^CUBE: \\S+ Present frame=",
      "okPattern": "^CUBE: PASS",
      "failPattern": "^CUBE: FAIL"
    },
    "d3d9": {
      "title": "D3D9 cube (i686, WoW64)",
      "shortcut": "builtin-d3d9-i686",
      "secsEnv": "DXCUBE_SECS",
      "firstFramePattern": "^CUBE: \\S+ Present frame=",
      "okPattern": "^CUBE: PASS",
      "failPattern": "^CUBE: FAIL"
    },
    "#d3d12": "D3D12 through vkd3d-proton (VKD3D component) and DXVK dxgi: no DXVK HUD or DXVK stats, so fps is the driver fps log (csf-v11 233); the test's own average is in its PASS line (test.fps). Sources: tests\/dx12.",
    "d3d12": {
      "title": "D3D12 Multithreading, SquidRoom (ARM64EC)",
      "shortcut": "builtin-d3d12-arm64ec",
      "env": {
        "VKD3D_DEBUG": "warn",
        "VKD3D_SHADER_DEBUG": "warn"
      },
      "secsEnv": "DX12TEST_SECS",
      "firstFramePattern": "^DX12: Present frame=",
      "okPattern": "^DX12: PASS",
      "failPattern": "^DX12: FAIL"
    },
    "d3d12gears": {
      "title": "D3D12 gears, vkd3d-proton demo (ARM64EC)",
      "shortcut": "builtin-d3d12gears-arm64ec",
      "env": {
        "VKD3D_DEBUG": "warn",
        "VKD3D_SHADER_DEBUG": "warn"
      },
      "secsEnv": "DX12TEST_SECS",
      "firstFramePattern": "^DX12: Present frame=",
      "okPattern": "^DX12: PASS",
      "failPattern": "^DX12: FAIL"
    },
    "d3d12x64": {
      "title": "D3D12 Multithreading, SquidRoom (x86_64, FEX)",
      "shortcut": "builtin-d3d12-x86_64",
      "env": {
        "VKD3D_DEBUG": "warn",
        "VKD3D_SHADER_DEBUG": "warn"
      },
      "secsEnv": "DX12TEST_SECS",
      "firstFramePattern": "^DX12: Present frame=",
      "okPattern": "^DX12: PASS",
      "failPattern": "^DX12: FAIL"
    }
  },
  "#scenarios": "Firebase --scenario-numbers. Numbers 1..N without gaps (the build sets com.google.test.loops = N). Passes: each task in order, one per env set in order.",
  "scenarios": {
    "1": {
      "name": "a31-diag11",
      "tasks": [
        "d3d11"
      ],
      "envSets": [
        "rel",
        "dg2",
        "r114",
        "dg2-old",
        "dg2-warm",
        "dg2-zero"
      ]
    },
    "2": {
      "name": "a31-diag9g",
      "tasks": [
        "d3d9",
        "d3d12gears"
      ],
      "envSets": [
        "dg2",
        "r114"
      ]
    },
    "3": {
      "name": "both",
      "tasks": [
        "d3d11",
        "d3d9"
      ]
    },
    "4": {
      "name": "ab",
      "tasks": [
        "d3d11",
        "d3d9"
      ],
      "envSets": [
        "old",
        "default"
      ]
    },
    "5": {
      "name": "d3d12",
      "tasks": [
        "d3d12"
      ]
    },
    "6": {
      "name": "d3d12gears",
      "tasks": [
        "d3d12gears"
      ]
    }
  },
  "mapsSnapshotSec": 1,
  "installDrivers": {
    "dg2": "panvk-diag2.so",
    "r114": "panvk-114.so"
  }
}