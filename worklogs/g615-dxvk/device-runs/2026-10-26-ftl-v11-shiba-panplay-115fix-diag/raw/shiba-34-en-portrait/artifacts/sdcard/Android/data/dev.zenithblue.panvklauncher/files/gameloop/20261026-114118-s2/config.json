{
  "#": "2026-10-26 shiba diagnostic run (panplay-115fix-diag): cube fps cap, D3D9 HUD text, D3D12 vkCreateSwapchainKHR fault. Deep-merged over assets\/gameloop.json.",
  "version": 1,
  "#warmupSec": "after the first frame; the measured window is [warmupSec, warmupSec + measureSec] seconds after it",
  "warmupSec": 8,
  "measureSec": 20,
  "#tailSec": "self-timed tests (secsEnv) run warmupSec + measureSec + tailSec seconds, then exit on their own",
  "tailSec": 4,
  "#startTimeoutSec": "a pass with no first frame after this many seconds is stopped and marked failed",
  "startTimeoutSec": 120,
  "gapSec": 3,
  "#fpsLogMs": "PANVK_FPS_LOG_MS (driver fps line interval, csf-v11 233)",
  "fpsLogMs": 1000,
  "#screenshotAtSec": "PNG of the display (game + DXVK HUD) this many seconds after the first frame; -1 = none",
  "screenshotAtSec": 22,
  "#driver": "bundled = the driver this APK carries (default), selected = the launcher's choice, or a driver id",
  "driver": "bundled",
  "#env": "every pass (DXVK_HUD stays full: ContainerManager owns it)",
  "env": {},
  "#envSets": "one per pass. A\/B (scenario 4): 'old' = every default-on 115 perf knob (staging-115 pa, pb, pc NOTES.md) at its 114 value, 'default' = driver defaults. Opt-in knobs (PANVK_KBASE_COHERENT_POOLS, PANVK_KBASE_EVICTABLE, PANVK_KBASE_HEAP_SLOTS) stay unset in both. PANVK_ZS_PRELOAD_ALWAYS is not in 'old': 114 already used INTERSECT on v11 (csf-v11 061); on a v9\/v10 device add PANVK_ZS_PRELOAD_ALWAYS=1 for a full 114 set.",
  "envSets": {
    "default": {
      "note": "driver defaults",
      "env": {}
    },
    "old": {
      "note": "115 perf knobs at their 114 values (pa 8, pb 8, pc 5)",
      "env": {
        "PANVK_CSF_FS_IDLE_CLEAN": "0",
        "PANVK_DB_ALT": "0",
        "PANVK_CSF_INDIRECT_REEMIT": "0",
        "PANVK_CSF_DESC_DIRTY": "0",
        "PANVK_VB_DIRTY_CMP": "0",
        "PANVK_PRERAST_FAST_SKIP": "0",
        "PANVK_KBASE_STRICT_DEVICE_CLOCK": "0",
        "PANVK_DESC_POOL_HINT": "0",
        "PANVK_KBASE_HEAP_EAGER_TERM": "0",
        "PANVK_TESS_VS_REGION_MB": "32",
        "PANVK_KBASE_ZERO_ALL": "1",
        "PANVK_CS_FLUSH_USED": "0",
        "PANVK_JM_CMD_POOL_AUTOTRIM": "0",
        "PANVK_MEM_BUDGET_PRESSURE": "0",
        "PANVK_CS_CHUNK_KB": "64",
        "PANVK_CMD_SLAB_CACHE": "0",
        "PANVK_WSI_SW_CACHED": "0",
        "PANVK_WSI_SW_DEFER_REPLY": "0",
        "PANVK_ANDROID_PRESENT_FENCE": "0",
        "PANVK_ANDROID_PRESENT_THREAD": "0",
        "PANVK_PRELOAD_BARRIER_TRACK": "0"
      }
    },
    "c-old-t": {
      "note": "cube: old 10 ms GetTickCount pump, all timing on",
      "env": {
        "DXCUBE_PUMP": "old",
        "PANPLAY_XTIMING": "1",
        "MESA_VK_X11_SW_TIMING": "1",
        "PANVK_KBASE_WAIT_STATS": "1"
      }
    },
    "c-drain-t": {
      "note": "cube: drain-only pump, all timing on",
      "env": {
        "DXCUBE_PUMP": "drain",
        "PANPLAY_XTIMING": "1",
        "MESA_VK_X11_SW_TIMING": "1",
        "PANVK_KBASE_WAIT_STATS": "1"
      }
    },
    "c-drain-swold-t": {
      "note": "cube: drain pump, P-C sw knobs at 114, timing on",
      "env": {
        "DXCUBE_PUMP": "drain",
        "PANVK_WSI_SW_CACHED": "0",
        "PANVK_WSI_SW_DEFER_REPLY": "0",
        "PANPLAY_XTIMING": "1",
        "MESA_VK_X11_SW_TIMING": "1",
        "PANVK_KBASE_WAIT_STATS": "1"
      }
    },
    "c-drain": {
      "note": "cube: drain pump, no timing",
      "env": {
        "DXCUBE_PUMP": "drain"
      }
    },
    "nc-uncached": {
      "note": "d3d9: HOST_COHERENT dma-heap BOs from system-uncached (new knob)",
      "env": {
        "DXCUBE_PUMP": "drain",
        "PANVK_KBASE_UNCACHED_HEAP": "1"
      }
    },
    "nc-heapenv": {
      "note": "d3d9: all dma-heap BOs from system-uncached (existing PANVK_KBASE_DMA_HEAP)",
      "env": {
        "DXCUBE_PUMP": "drain",
        "PANVK_KBASE_DMA_HEAP": "\/dev\/dma_heap\/system-uncached"
      }
    },
    "nc-clean": {
      "note": "d3d9: clean CPU-mapped imports before each submit (PANVK_KBASE_IMPORT_SYNC=1 on CSF)",
      "env": {
        "DXCUBE_PUMP": "drain",
        "PANVK_KBASE_IMPORT_SYNC": "1"
      }
    },
    "drv114": {
      "note": "RC5-universal-114-fps driver (114 + fps log)",
      "driver": "r114",
      "env": {
        "DXCUBE_PUMP": "drain"
      }
    },
    "vulkan9": {
      "note": "d3d9: WINEDEBUG=+vulkan, 12 s",
      "env": {
        "DXCUBE_PUMP": "drain",
        "WINEDEBUG": "fixme-all,+vulkan",
        "DXCUBE_SECS": "12"
      }
    },
    "g-seh": {
      "note": "D3D12: +seh,+loaddll, swapchain create log",
      "env": {
        "WINEDEBUG": "fixme-all,+seh,+loaddll",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-sehvk": {
      "note": "D3D12: +seh,+vulkan",
      "env": {
        "WINEDEBUG": "fixme-all,+seh,+vulkan",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-nomaint1": {
      "note": "D3D12: no swapchain_maintenance1",
      "env": {
        "VKD3D_DISABLE_EXTENSIONS": "VK_KHR_swapchain_maintenance1,VK_EXT_swapchain_maintenance1",
        "WINEDEBUG": "fixme-all,+seh",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-nowait": {
      "note": "D3D12: no present wait\/id",
      "env": {
        "VKD3D_DISABLE_EXTENSIONS": "VK_KHR_present_wait,VK_KHR_present_id,VK_KHR_present_wait2,VK_KHR_present_id2",
        "WINEDEBUG": "fixme-all,+seh",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-immediate": {
      "note": "D3D12: VKD3D_SWAPCHAIN_PRESENT_MODE=IMMEDIATE (no present-modes pNext)",
      "env": {
        "VKD3D_SWAPCHAIN_PRESENT_MODE": "IMMEDIATE",
        "WINEDEBUG": "fixme-all,+seh",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-swold": {
      "note": "D3D12: P-C sw knobs at 114",
      "env": {
        "PANVK_WSI_SW_CACHED": "0",
        "PANVK_WSI_SW_DEFER_REPLY": "0",
        "WINEDEBUG": "fixme-all,+seh",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-noshm": {
      "note": "D3D12: sw present by PutImage, no MIT-SHM",
      "env": {
        "MESA_VK_WSI_DEBUG": "noshm",
        "WINEDEBUG": "fixme-all,+seh",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-old": {
      "note": "D3D12: the 21 knobs at 114 (old)",
      "env": {
        "PANVK_CSF_FS_IDLE_CLEAN": "0",
        "PANVK_DB_ALT": "0",
        "PANVK_CSF_INDIRECT_REEMIT": "0",
        "PANVK_CSF_DESC_DIRTY": "0",
        "PANVK_VB_DIRTY_CMP": "0",
        "PANVK_PRERAST_FAST_SKIP": "0",
        "PANVK_KBASE_STRICT_DEVICE_CLOCK": "0",
        "PANVK_DESC_POOL_HINT": "0",
        "PANVK_KBASE_HEAP_EAGER_TERM": "0",
        "PANVK_TESS_VS_REGION_MB": "32",
        "PANVK_KBASE_ZERO_ALL": "1",
        "PANVK_CS_FLUSH_USED": "0",
        "PANVK_JM_CMD_POOL_AUTOTRIM": "0",
        "PANVK_MEM_BUDGET_PRESSURE": "0",
        "PANVK_CS_CHUNK_KB": "64",
        "PANVK_CMD_SLAB_CACHE": "0",
        "PANVK_WSI_SW_CACHED": "0",
        "PANVK_WSI_SW_DEFER_REPLY": "0",
        "PANVK_ANDROID_PRESENT_FENCE": "0",
        "PANVK_ANDROID_PRESENT_THREAD": "0",
        "PANVK_PRELOAD_BARRIER_TRACK": "0",
        "WINEDEBUG": "fixme-all,+seh",
        "MESA_VK_WSI_CREATE_LOG": "1"
      }
    },
    "g-114": {
      "note": "D3D12: RC5-universal-114-fps driver",
      "driver": "r114",
      "env": {
        "WINEDEBUG": "fixme-all,+seh"
      }
    }
  },
  "#tasks": "shortcut = PanPlay shortcut id (built-in cubes: builtin-<api>-<arch>). Add a task here and name it in a scenario.",
  "tasks": {
    "d3d11": {
      "title": "D3D11 cube (ARM64EC)",
      "shortcut": "builtin-d3d11-arm64ec",
      "secsEnv": "DXCUBE_SECS",
      "firstFramePattern": "^CUBE: \\S+ Present frame=",
      "okPattern": "^CUBE: PASS",
      "failPattern": "^CUBE: FAIL"
    },
    "d3d9": {
      "title": "D3D9 cube (i686, WoW64)",
      "shortcut": "builtin-d3d9-i686",
      "secsEnv": "DXCUBE_SECS",
      "firstFramePattern": "^CUBE: \\S+ Present frame=",
      "okPattern": "^CUBE: PASS",
      "failPattern": "^CUBE: FAIL"
    },
    "#d3d12": "D3D12 through vkd3d-proton (VKD3D component) and DXVK dxgi: no DXVK HUD or DXVK stats, so fps is the driver fps log (csf-v11 233); the test's own average is in its PASS line (test.fps). Sources: tests\/dx12.",
    "d3d12": {
      "title": "D3D12 Multithreading, SquidRoom (ARM64EC)",
      "shortcut": "builtin-d3d12-arm64ec",
      "env": {
        "VKD3D_DEBUG": "warn",
        "VKD3D_SHADER_DEBUG": "warn"
      },
      "secsEnv": "DX12TEST_SECS",
      "firstFramePattern": "^DX12: Present frame=",
      "okPattern": "^DX12: PASS",
      "failPattern": "^DX12: FAIL"
    },
    "d3d12gears": {
      "title": "D3D12 gears, vkd3d-proton demo (ARM64EC)",
      "shortcut": "builtin-d3d12gears-arm64ec",
      "env": {
        "VKD3D_DEBUG": "warn",
        "VKD3D_SHADER_DEBUG": "warn"
      },
      "secsEnv": "DX12TEST_SECS",
      "firstFramePattern": "^DX12: Present frame=",
      "okPattern": "^DX12: PASS",
      "failPattern": "^DX12: FAIL"
    },
    "d3d12x64": {
      "title": "D3D12 Multithreading, SquidRoom (x86_64, FEX)",
      "shortcut": "builtin-d3d12-x86_64",
      "env": {
        "VKD3D_DEBUG": "warn",
        "VKD3D_SHADER_DEBUG": "warn"
      },
      "secsEnv": "DX12TEST_SECS",
      "firstFramePattern": "^DX12: Present frame=",
      "okPattern": "^DX12: PASS",
      "failPattern": "^DX12: FAIL"
    }
  },
  "#scenarios": "Firebase --scenario-numbers. Numbers 1..N without gaps (the build sets com.google.test.loops = N). Passes: each task in order, one per env set in order.",
  "scenarios": {
    "1": {
      "name": "cube11-diag",
      "tasks": [
        "d3d11"
      ],
      "envSets": [
        "c-old-t",
        "c-drain-t",
        "c-drain-swold-t",
        "c-drain"
      ]
    },
    "2": {
      "name": "cube9-diag",
      "tasks": [
        "d3d9"
      ],
      "envSets": [
        "c-old-t",
        "c-drain-t",
        "nc-uncached",
        "nc-heapenv",
        "nc-clean",
        "drv114",
        "vulkan9"
      ]
    },
    "3": {
      "name": "gears-diag",
      "tasks": [
        "d3d12gears"
      ],
      "envSets": [
        "g-seh",
        "g-sehvk",
        "g-nomaint1",
        "g-nowait",
        "g-immediate",
        "g-swold",
        "g-noshm",
        "g-old",
        "g-114"
      ]
    },
    "4": {
      "name": "squid-diag",
      "tasks": [
        "d3d12"
      ],
      "envSets": [
        "g-seh",
        "g-immediate"
      ]
    },
    "5": {
      "name": "d3d12",
      "tasks": [
        "d3d12"
      ]
    },
    "6": {
      "name": "d3d12gears",
      "tasks": [
        "d3d12gears"
      ]
    }
  },
  "mapsSnapshotSec": 1,
  "installDrivers": {
    "r114": "drivers\/rc5u-114fps.so"
  }
}